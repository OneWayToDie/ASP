@inherits LayoutComponentBase
@inject Services.LocalizationService L
@implements IDisposable

<div id="app">
    <header class="site-header">
        <NavMenu />
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-brand">
                <span class="footer-logo">MCOC AW Manager</span>
                <p class="footer-tagline">@L.FooterTagline</p>
            </div>
            <div class="footer-links">
                <a href="contacts">@L.FooterContacts</a>
                <a href="https://github.com" target="_blank">GitHub</a>
            </div>
            <div class="footer-copy">
                @L.FooterCopyright
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">X</a>
</div>

@code {
    protected override void OnInitialized()
    {
        L.OnLanguageChanged += OnLangChanged;
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.OnLanguageChanged -= OnLangChanged;
}
