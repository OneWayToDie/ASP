@page "/faq"
@inject Services.LocalizationService L
@implements IDisposable

<PageTitle>@L.NavFaq - MCOC AW Manager</PageTitle>

<section class="section">
    <h1 class="section-title">@L.FaqTitle</h1>
    <p class="section-subtitle">@L.FaqSubtitle</p>

    <div class="faq-container">
        @foreach (var item in faqItems)
        {
            <div class="faq-item @(item.IsOpen ? "open" : "")">
                <button class="faq-question" @onclick="() => ToggleFaq(item)">
                    @item.Question
                </button>
                <div class="faq-answer">
                    @item.Answer
                </div>
            </div>
        }
    </div>
</section>

<style>
    .faq-container {
        max-width: 750px;
        margin: 0 auto;
    }
</style>

@code {
    private List<FaqItem> faqItems = new()
    {
        new FaqItem
        {
            Question = "Что нужно для запуска программы?",
            Answer = "MCOC AW Manager работает на Windows 10/11 (64-bit). Понадобится стабильное интернет-подключение для синхронизации данных с облаком. Программа не требует установки .NET Runtime — он уже включён в дистрибутив."
        },
        new FaqItem
        {
            Question = "Как создать альянс?",
            Answer = "Зарегистрируйтесь в приложении, затем нажмите \"Создать альянс\". Укажите название и тег (2-5 символов). После создания вы автоматически становитесь Лидером и можете приглашать участников через систему заявок. Между созданием альянсов действует 24-часовой кулдаун."
        },
        new FaqItem
        {
            Question = "Как работает расстановка чемпионов?",
            Answer = "Программа анализирует теги каждого чемпиона и сверяет их с бустами узлов военной карты. Чем больше совпадений — тем выше оценка. Можно использовать авто-расстановку (жадный алгоритм) или расставлять вручную. Для карты допускаются только 7-звёздные чемпионы максимальной редкости."
        },
        new FaqItem
        {
            Question = "Безопасны ли мои данные?",
            Answer = "Все данные хранятся в зашифрованном облачном хранилище (Supabase/PostgreSQL). Пароли хешируются с помощью BCrypt. Каждый альянс изолирован — вы видите только своих участников. Приложение не передаёт никакой личной информации третьим лицам."
        },
        new FaqItem
        {
            Question = "Какие данные хранятся в облаке?",
            Answer = "В облаке хранятся: профили игроков, структура альянсов, сообщения чата, расстановка на военной карте, статистика битв, энциклопедия чемпионов и настройки приложения. Локально сохраняются только персональные настройки интерфейса (тема, звуки)."
        },
        new FaqItem
        {
            Question = "Как обновляется программа?",
            Answer = "При запуске программа автоматически проверяет наличие обновлений. При необходимости вы будете перенаправлены на страницу загрузки. Энциклопедия чемпионов обновляется автоматически при входе Модератора или Создателя."
        },
        new FaqItem
        {
            Question = "Можно ли использовать на нескольких устройствах?",
            Answer = "Да! Все данные хранятся в облаке, поэтому вы можете войти в аккаунт с любого устройства с Windows. Сессия сохраняется 30 дней. Реалтайм-синхронизация обеспечивает актуальность данных на всех устройствах."
        },
        new FaqItem
        {
            Question = "Как связаться с автором?",
            Answer = "Перейдите на страницу \"Контакты\" в меню. Вы найдёте ссылку на Telegram и email для связи. Автор отвечает в течение 24 часов и готов помочь с любыми вопросами по использованию программы."
        }
    };

    private void ToggleFaq(FaqItem item)
    {
        item.IsOpen = !item.IsOpen;
    }

    private class FaqItem
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public bool IsOpen { get; set; }
    }

    protected override void OnInitialized()
    {
        L.OnLanguageChanged += OnLangChanged;
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.OnLanguageChanged -= OnLangChanged;
}
