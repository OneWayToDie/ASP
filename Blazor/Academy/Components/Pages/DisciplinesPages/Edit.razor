@page "/disciplines/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit</h1>
    <h2>Disciplines</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="UpdateEntity" FormName="edit">
                <input type="hidden" name="post" value="1" />

                <div class="mb-3">
                    <label for="disciplinename" class="form-label">DisciplineName:</label>
                    <input type="text" name="DisciplineNameIn" value="@Entity.DisciplineName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="numberoflessons" class="form-label">NumberOfLessons:</label>
                    <input type="number" name="NumberOfLessonsIn" value="@Entity.NumberOfLessons" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code {
[SupplyParameterFromQuery]
    private int id { get; set; }

    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? DisciplineNameIn { get; set; }

    [SupplyParameterFromForm]
    public string? NumberOfLessonsIn { get; set; }

    private Disciplines? Entity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Entity = await context.Disciplines.FirstOrDefaultAsync(m => m.DisciplineId == id);

        if (Entity is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        if (post == "1")
        {
if (DisciplineNameIn != null) Entity.DisciplineName = DisciplineNameIn;
        if (byte.TryParse(NumberOfLessonsIn, out var vNumberOfLessons)) Entity.NumberOfLessons = vNumberOfLessons;
        }
    }

    private async Task UpdateEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Entity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EntityExists())
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/disciplines");
    }

    private bool EntityExists()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Disciplines.Any(m => m.DisciplineId == id);
    }
}