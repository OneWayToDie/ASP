@page "/disciplines/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Disciplines</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="disciplineid" class="form-label">DisciplineId:</label>
                    <input type="number" name="DisciplineIdIn" value="@Entity.DisciplineId" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="disciplinename" class="form-label">DisciplineName:</label>
                    <input type="text" name="DisciplineNameIn" value="@Entity.DisciplineName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="numberoflessons" class="form-label">NumberOfLessons:</label>
                    <input type="number" name="NumberOfLessonsIn" value="@Entity.NumberOfLessons" class="form-control" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? DisciplineIdIn { get; set; }

    [SupplyParameterFromForm]
    public string? DisciplineNameIn { get; set; }

    [SupplyParameterFromForm]
    public string? NumberOfLessonsIn { get; set; }

    private Disciplines Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (short.TryParse(DisciplineIdIn, out var vDisciplineId)) Entity.DisciplineId = vDisciplineId;
        if (DisciplineNameIn != null) Entity.DisciplineName = DisciplineNameIn;
        if (byte.TryParse(NumberOfLessonsIn, out var vNumberOfLessons)) Entity.NumberOfLessons = vNumberOfLessons;
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Disciplines.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");
    }
}