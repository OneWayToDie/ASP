@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Groups</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="groupid" class="form-label">GroupId:</label>
                    <input type="number" name="GroupIdIn" value="@Entity.GroupId" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="groupname" class="form-label">GroupName:</label>
                    <input type="text" name="GroupNameIn" value="@Entity.GroupName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="direction" class="form-label">Direction:</label>
                    <input type="number" name="DirectionIn" value="@Entity.Direction" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="weekdays" class="form-label">Weekdays:</label>
                    <input type="number" name="WeekdaysIn" value="@Entity.Weekdays" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="starttime" class="form-label">StartTime:</label>
                    <input type="time" name="StartTimeIn" value="@Entity.StartTime?.ToString("HH:mm")" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">StartDate:</label>
                    <input type="date" name="StartDateIn" value="@Entity.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? GroupIdIn { get; set; }

    [SupplyParameterFromForm]
    public string? GroupNameIn { get; set; }

    [SupplyParameterFromForm]
    public string? DirectionIn { get; set; }

    [SupplyParameterFromForm]
    public string? WeekdaysIn { get; set; }

    [SupplyParameterFromForm]
    public string? StartTimeIn { get; set; }

    [SupplyParameterFromForm]
    public string? StartDateIn { get; set; }

    private Groups Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (int.TryParse(GroupIdIn, out var vGroupId)) Entity.GroupId = vGroupId;
        if (GroupNameIn != null) Entity.GroupName = GroupNameIn;
        if (byte.TryParse(DirectionIn, out var vDirection)) Entity.Direction = vDirection;
        if (byte.TryParse(WeekdaysIn, out var vWeekdays)) Entity.Weekdays = vWeekdays;
        if (TimeOnly.TryParse(StartTimeIn, out var vStartTime)) Entity.StartTime = vStartTime;
        if (DateOnly.TryParse(StartDateIn, out var vStartDate)) Entity.StartDate = vStartDate;
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Groups.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}