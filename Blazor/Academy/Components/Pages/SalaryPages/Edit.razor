@page "/salary/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit</h1>
    <h2>Salary</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="UpdateEntity" FormName="edit">
                <input type="hidden" name="post" value="1" />

                <div class="mb-3">
                    <label for="teacher" class="form-label">Teacher:</label>
                    <input type="number" name="TeacherIn" value="@Entity.Teacher" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="accrued" class="form-label">Accrued:</label>
                    <input type="number" name="AccruedIn" value="@Entity.Accrued.ToString(CultureInfo.InvariantCulture)" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <label for="received" class="form-label">Received:</label>
                    <input type="checkbox" name="ReceivedIn" value="true" checked="@(Entity.Received ? "checked" : null)" class="form-check-input" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/salary">Back to List</a>
</div>

@code {
[SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? TeacherIn { get; set; }

    [SupplyParameterFromForm]
    public string? AccruedIn { get; set; }

    [SupplyParameterFromForm]
    public string? ReceivedIn { get; set; }

    private Salary? Entity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Entity = await context.Salary.FirstOrDefaultAsync(m => m.PaymentId == id);

        if (Entity is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        if (post == "1")
        {
if (short.TryParse(TeacherIn, out var vTeacher)) Entity.Teacher = vTeacher;
        if (decimal.TryParse(AccruedIn, NumberStyles.Number, CultureInfo.InvariantCulture, out var vAccrued)) Entity.Accrued = vAccrued;
        Entity.Received = (ReceivedIn == "true");
        }
    }

    private async Task UpdateEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Entity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EntityExists())
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/salary");
    }

    private bool EntityExists()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Salary.Any(m => m.PaymentId == id);
    }
}