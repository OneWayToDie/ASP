@page "/salary/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Salary</h2>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
<dl class="row">
            <dt class="col-sm-2">PaymentId</dt>
            <dd class="col-sm-10">@item.PaymentId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Teacher</dt>
            <dd class="col-sm-10">@item.Teacher</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Accrued</dt>
            <dd class="col-sm-10">@item.Accrued</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Received</dt>
            <dd class="col-sm-10">@item.Received</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteEntity" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button> |
            <a href="/salary">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Salary? item;

[SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Salary.FirstOrDefaultAsync(m => m.PaymentId == id);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Salary.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/salary");
    }
}