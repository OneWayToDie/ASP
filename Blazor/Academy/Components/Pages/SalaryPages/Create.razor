@page "/salary/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Salary</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="paymentid" class="form-label">PaymentId:</label>
                    <input type="number" name="PaymentIdIn" value="@Entity.PaymentId" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="teacher" class="form-label">Teacher:</label>
                    <input type="number" name="TeacherIn" value="@Entity.Teacher" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="accrued" class="form-label">Accrued:</label>
                    <input type="number" name="AccruedIn" value="@Entity.Accrued.ToString(CultureInfo.InvariantCulture)" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <label for="received" class="form-label">Received:</label>
                    <input type="checkbox" name="ReceivedIn" value="true" checked="@(Entity.Received ? "checked" : null)" class="form-check-input" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/salary">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? PaymentIdIn { get; set; }

    [SupplyParameterFromForm]
    public string? TeacherIn { get; set; }

    [SupplyParameterFromForm]
    public string? AccruedIn { get; set; }

    [SupplyParameterFromForm]
    public string? ReceivedIn { get; set; }

    private Salary Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (long.TryParse(PaymentIdIn, out var vPaymentId)) Entity.PaymentId = vPaymentId;
        if (short.TryParse(TeacherIn, out var vTeacher)) Entity.Teacher = vTeacher;
        if (decimal.TryParse(AccruedIn, NumberStyles.Number, CultureInfo.InvariantCulture, out var vAccrued)) Entity.Accrued = vAccrued;
        Entity.Received = (ReceivedIn == "true");
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Salary.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/salary");
    }
}