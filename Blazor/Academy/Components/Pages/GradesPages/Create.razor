@page "/grades/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Grades</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="student" class="form-label">Student:</label>
                    <input type="number" name="StudentIn" value="@Entity.Student" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="lesson" class="form-label">Lesson:</label>
                    <input type="number" name="LessonIn" value="@Entity.Lesson" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="grade1" class="form-label">Grade1:</label>
                    <input type="number" name="Grade1In" value="@Entity.Grade1" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="grade2" class="form-label">Grade2:</label>
                    <input type="number" name="Grade2In" value="@Entity.Grade2" class="form-control" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/grades">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? StudentIn { get; set; }

    [SupplyParameterFromForm]
    public string? LessonIn { get; set; }

    [SupplyParameterFromForm]
    public string? Grade1In { get; set; }

    [SupplyParameterFromForm]
    public string? Grade2In { get; set; }

    private Grades Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (int.TryParse(StudentIn, out var vStudent)) Entity.Student = vStudent;
        if (long.TryParse(LessonIn, out var vLesson)) Entity.Lesson = vLesson;
        if (byte.TryParse(Grade1In, out var vGrade1)) Entity.Grade1 = vGrade1;
        if (byte.TryParse(Grade2In, out var vGrade2)) Entity.Grade2 = vGrade2;
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Grades.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/grades");
    }
}