@page "/grades/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit</h1>
    <h2>Grades</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="UpdateEntity" FormName="edit">
                <input type="hidden" name="post" value="1" />

                <div class="mb-3">
                    <label for="grade1" class="form-label">Grade1:</label>
                    <input type="number" name="Grade1In" value="@Entity.Grade1" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="grade2" class="form-label">Grade2:</label>
                    <input type="number" name="Grade2In" value="@Entity.Grade2" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/grades">Back to List</a>
</div>

@code {
[SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? Grade1In { get; set; }

    [SupplyParameterFromForm]
    public string? Grade2In { get; set; }

    private Grades? Entity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Entity = await context.Grades.FirstOrDefaultAsync(m => m.Student == student && m.Lesson == lesson);

        if (Entity is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        if (post == "1")
        {
if (byte.TryParse(Grade1In, out var vGrade1)) Entity.Grade1 = vGrade1;
        if (byte.TryParse(Grade2In, out var vGrade2)) Entity.Grade2 = vGrade2;
        }
    }

    private async Task UpdateEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Entity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EntityExists())
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/grades");
    }

    private bool EntityExists()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Grades.Any(m => m.Student == student && m.Lesson == lesson);
    }
}