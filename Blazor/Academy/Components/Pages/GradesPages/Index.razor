@page "/grades"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Grades</PageTitle>

<h1>Grades</h1>

<p>
    <a href="/grades/create">Create New</a>
</p>

<div class="controls">

    <div>
        <label for="items-per-page">Items per page:</label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </select>
    </div>
</div>

<div>
    <QuickGrid Class="table" Items="context.Grades" Pagination="pagination">
<PropertyColumn Property="m => m.Student" Sortable="true" />
        <PropertyColumn Property="m => m.Lesson" Sortable="true" />
        <PropertyColumn Property="m => m.Grade1" Sortable="true" />
        <PropertyColumn Property="m => m.Grade2" Sortable="true" />
        <TemplateColumn Context="m">
            <a href="@($"grades/details?student={m.Student}&lesson={m.Lesson}")">Details</a> |
            <a href="@($"grades/edit?student={m.Student}&lesson={m.Lesson}")">Edit</a> |
            <a href="@($"grades/delete?student={m.Student}&lesson={m.Lesson}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code {
    private AcademyContext context = default!;


    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}