@page "/directions/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Directions</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="directionid" class="form-label">DirectionId:</label>
                    <input type="number" name="DirectionIdIn" value="@Entity.DirectionId" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="directionname" class="form-label">DirectionName:</label>
                    <input type="text" name="DirectionNameIn" value="@Entity.DirectionName" class="form-control" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/directions">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? DirectionIdIn { get; set; }

    [SupplyParameterFromForm]
    public string? DirectionNameIn { get; set; }

    private Directions Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (byte.TryParse(DirectionIdIn, out var vDirectionId)) Entity.DirectionId = vDirectionId;
        if (DirectionNameIn != null) Entity.DirectionName = DirectionNameIn;
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Directions.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/directions");
    }
}