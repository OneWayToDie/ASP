@page "/directions"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Directions</PageTitle>

<h1>Directions</h1>

<p>
    <a href="/directions/create">Create New</a>
</p>

<div class="controls">
        <form action="/directions">
            <input type="search" name="directionname" />
            <input type="submit" value="Search" class="btn btn-primary"/>
        </form>
    <div>
        <label for="items-per-page">Items per page:</label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </select>
    </div>
</div>

<div>
    <QuickGrid Class="table" Items="FilteredItems" Pagination="pagination">
<PropertyColumn Property="m => m.DirectionId" Sortable="true" />
        <PropertyColumn Property="m => m.DirectionName" Sortable="true" />
        <TemplateColumn Context="m">
            <a href="@($"directions/details?id={m.DirectionId}")">Details</a> |
            <a href="@($"directions/edit?id={m.DirectionId}")">Edit</a> |
            <a href="@($"directions/delete?id={m.DirectionId}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code {
    private AcademyContext context = default!;

    [SupplyParameterFromQuery]
    string? directionname { get; set; }

    IQueryable<Directions> FilteredItems =>
        context.Directions.Where(m => (m.DirectionName ?? string.Empty).Contains(directionname ?? string.Empty));
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}