@page "/schedule/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Schedule</h2>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
<dl class="row">
            <dt class="col-sm-2">LessonId</dt>
            <dd class="col-sm-10">@item.LessonId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Group</dt>
            <dd class="col-sm-10">@item.Group</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Discipline</dt>
            <dd class="col-sm-10">@item.Discipline</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Teacher</dt>
            <dd class="col-sm-10">@item.Teacher</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@item.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Time</dt>
            <dd class="col-sm-10">@item.Time</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Spent</dt>
            <dd class="col-sm-10">@item.Spent</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteEntity" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button> |
            <a href="/schedule">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Schedule? item;

[SupplyParameterFromQuery]
    private long id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Schedule.FirstOrDefaultAsync(m => m.LessonId == id);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Schedule.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/schedule");
    }
}