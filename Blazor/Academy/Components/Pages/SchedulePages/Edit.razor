@page "/schedule/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit</h1>
    <h2>Schedule</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="UpdateEntity" FormName="edit">
                <input type="hidden" name="post" value="1" />

                <div class="mb-3">
                    <label for="group" class="form-label">Group:</label>
                    <input type="number" name="GroupIn" value="@Entity.Group" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="discipline" class="form-label">Discipline:</label>
                    <input type="number" name="DisciplineIn" value="@Entity.Discipline" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="teacher" class="form-label">Teacher:</label>
                    <input type="number" name="TeacherIn" value="@Entity.Teacher" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date:</label>
                    <input type="date" name="DateIn" value="@Entity.Date?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="time" class="form-label">Time:</label>
                    <input type="time" name="TimeIn" value="@Entity.Time?.ToString("HH:mm")" class="form-control" />
                </div>
                <div class="form-check mb-3">
                    <label for="spent" class="form-label">Spent:</label>
                    <input type="checkbox" name="SpentIn" value="true" checked="@(Entity.Spent ? "checked" : null)" class="form-check-input" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/schedule">Back to List</a>
</div>

@code {
[SupplyParameterFromQuery]
    private long id { get; set; }

    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? GroupIn { get; set; }

    [SupplyParameterFromForm]
    public string? DisciplineIn { get; set; }

    [SupplyParameterFromForm]
    public string? TeacherIn { get; set; }

    [SupplyParameterFromForm]
    public string? DateIn { get; set; }

    [SupplyParameterFromForm]
    public string? TimeIn { get; set; }

    [SupplyParameterFromForm]
    public string? SpentIn { get; set; }

    private Schedule? Entity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Entity = await context.Schedule.FirstOrDefaultAsync(m => m.LessonId == id);

        if (Entity is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        if (post == "1")
        {
if (int.TryParse(GroupIn, out var vGroup)) Entity.Group = vGroup;
        if (short.TryParse(DisciplineIn, out var vDiscipline)) Entity.Discipline = vDiscipline;
        if (short.TryParse(TeacherIn, out var vTeacher)) Entity.Teacher = vTeacher;
        if (DateOnly.TryParse(DateIn, out var vDate)) Entity.Date = vDate;
        if (TimeOnly.TryParse(TimeIn, out var vTime)) Entity.Time = vTime;
        Entity.Spent = (SpentIn == "true");
        }
    }

    private async Task UpdateEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Entity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EntityExists())
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/schedule");
    }

    private bool EntityExists()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Schedule.Any(m => m.LessonId == id);
    }
}