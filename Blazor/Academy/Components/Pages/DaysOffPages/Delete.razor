@page "/daysoff/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Days OFF</h2>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
<dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@item.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Holiday</dt>
            <dd class="col-sm-10">@item.Holiday</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteEntity" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button> |
            <a href="/daysoff">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DaysOff? item;

[SupplyParameterFromQuery]
    private DateOnly date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.DaysOff.FirstOrDefaultAsync(m => m.Date == date);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.DaysOff.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/daysoff");
    }
}