@page "/exams/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Exams</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddEntity" FormName="create">
            <input type="hidden" name="post" value="1" />
                <div class="mb-3">
                    <label for="student" class="form-label">Student:</label>
                    <input type="number" name="StudentIn" value="@Entity.Student" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="discipline" class="form-label">Discipline:</label>
                    <input type="number" name="DisciplineIn" value="@Entity.Discipline" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date:</label>
                    <input type="date" name="DateIn" value="@Entity.Date?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="mb-3">
                    <label for="grade" class="form-label">Grade:</label>
                    <input type="number" name="GradeIn" value="@Entity.Grade" class="form-control" />
                </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/exams">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? StudentIn { get; set; }

    [SupplyParameterFromForm]
    public string? DisciplineIn { get; set; }

    [SupplyParameterFromForm]
    public string? DateIn { get; set; }

    [SupplyParameterFromForm]
    public string? GradeIn { get; set; }

    private Exams Entity { get; set; } = new();

    protected override void OnInitialized()
    {
        if (post == "1")
        {
if (int.TryParse(StudentIn, out var vStudent)) Entity.Student = vStudent;
        if (short.TryParse(DisciplineIn, out var vDiscipline)) Entity.Discipline = vDiscipline;
        if (DateOnly.TryParse(DateIn, out var vDate)) Entity.Date = vDate;
        if (byte.TryParse(GradeIn, out var vGrade)) Entity.Grade = vGrade;
        }
    }

    private async Task AddEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Exams.Add(Entity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/exams");
    }
}