@page "/exams/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
<dt class="col-sm-2">Student</dt>
                    <dd class="col-sm-10">@item.Student</dd>
                    <dt class="col-sm-2">Discipline</dt>
                    <dd class="col-sm-10">@item.Discipline</dd>
                    <dt class="col-sm-2">Date</dt>
                    <dd class="col-sm-10">@item.Date</dd>
                    <dt class="col-sm-2">Grade</dt>
                    <dd class="col-sm-10">@item.Grade</dd>
        </dl>
        <div>
            <a href="@($"exams/edit?student={item.Student}&discipline={item.Discipline}")">Edit</a> |
            <a href="@($"exams/delete?student={item.Student}&discipline={item.Discipline}")">Delete</a> |
            <a href="@($"/exams")">Back to List</a>
        </div>
    }
</div>

@code {
    private Exams? item;

[SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Exams.FirstOrDefaultAsync(m => m.Student == student && m.Discipline == discipline);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}