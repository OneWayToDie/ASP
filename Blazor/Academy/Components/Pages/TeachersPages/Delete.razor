@page "/teachers/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Teachers</h2>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
<dl class="row">
            <dt class="col-sm-2">TeacherId</dt>
            <dd class="col-sm-10">@item.TeacherId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">LastName</dt>
            <dd class="col-sm-10">@item.LastName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FirstName</dt>
            <dd class="col-sm-10">@item.FirstName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MiddleName</dt>
            <dd class="col-sm-10">@item.MiddleName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">BirthDate</dt>
            <dd class="col-sm-10">@item.BirthDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@item.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Phone</dt>
            <dd class="col-sm-10">@item.Phone</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">WorkSince</dt>
            <dd class="col-sm-10">@item.WorkSince</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Rate</dt>
            <dd class="col-sm-10">@item.Rate</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteEntity" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button> |
            <a href="/teachers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Teachers? item;

[SupplyParameterFromQuery]
    private int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Teachers.FirstOrDefaultAsync(m => m.TeacherId == id);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Teachers.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/teachers");
    }
}