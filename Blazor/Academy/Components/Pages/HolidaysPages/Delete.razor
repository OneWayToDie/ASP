@page "/holidays/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Holidays</h2>
    <hr />
    @if (item is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
<dl class="row">
            <dt class="col-sm-2">HolidayId</dt>
            <dd class="col-sm-10">@item.HolidayId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">HolidayName</dt>
            <dd class="col-sm-10">@item.HolidayName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@item.Duration</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Month</dt>
            <dd class="col-sm-10">@item.Month</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Day</dt>
            <dd class="col-sm-10">@item.Day</dd>
        </dl>
        <EditForm method="post" Model="item" OnValidSubmit="DeleteEntity" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(item is null)">Delete</button> |
            <a href="/holidays">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Holidays? item;

[SupplyParameterFromQuery]
    private int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        item = await context.Holidays.FirstOrDefaultAsync(m => m.HolidayId == id);

        if (item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Holidays.Remove(item!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/holidays");
    }
}