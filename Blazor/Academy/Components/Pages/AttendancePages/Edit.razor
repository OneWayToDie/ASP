@page "/attendance/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Data.Models
@using System.Globalization
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit</h1>
    <h2>Attendance</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="UpdateEntity" FormName="edit">
                <input type="hidden" name="post" value="1" />

                <div class="form-check mb-3">
                    <label for="present" class="form-label">Present:</label>
                    <input type="checkbox" name="PresentIn" value="true" checked="@(Entity.Present ? "checked" : null)" class="form-check-input" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/attendance">Back to List</a>
</div>

@code {
[SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    [SupplyParameterFromForm]
    public string? post { get; set; }

[SupplyParameterFromForm]
    public string? PresentIn { get; set; }

    private Attendance? Entity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Entity = await context.Attendance.FirstOrDefaultAsync(m => m.Student == student && m.Lesson == lesson);

        if (Entity is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        if (post == "1")
        {
Entity.Present = (PresentIn == "true");
        }
    }

    private async Task UpdateEntity()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Entity!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EntityExists())
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/attendance");
    }

    private bool EntityExists()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Attendance.Any(m => m.Student == student && m.Lesson == lesson);
    }
}