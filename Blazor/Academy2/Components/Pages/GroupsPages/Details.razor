@page "/groupss/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Data
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Groups</h2>
    <hr />
    @if (groups is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">GroupName</dt>
            <dd class="col-sm-10">@groups.GroupName</dd>
            <dt class="col-sm-2">Direction</dt>
            <dd class="col-sm-10">@groups.Direction</dd>
            <dt class="col-sm-2">Weekdays</dt>
            <dd class="col-sm-10">@groups.Weekdays</dd>
            <dt class="col-sm-2">StartTime</dt>
            <dd class="col-sm-10">@groups.StartTime</dd>
            <dt class="col-sm-2">StartDate</dt>
            <dd class="col-sm-10">@groups.StartDate</dd>
            <dt class="col-sm-2">DirectionNavigation</dt>
            <dd class="col-sm-10">@groups.DirectionNavigation</dd>
            <dt class="col-sm-2">Schedule</dt>
            <dd class="col-sm-10">@groups.Schedule</dd>
            <dt class="col-sm-2">Students</dt>
            <dd class="col-sm-10">@groups.Students</dd>
        </dl>
        <div>
            <a href="@($"/groupss/edit?groupid={groups.GroupId}")">Edit</a> |
            <a href="@($"/groupss")">Back to List</a>
        </div>
    }
</div>

@code {
    private Groups? groups;

    [SupplyParameterFromQuery]
    private int GroupId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        groups = await context.Groups.FirstOrDefaultAsync(m => m.GroupId == GroupId);

        if (groups is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
