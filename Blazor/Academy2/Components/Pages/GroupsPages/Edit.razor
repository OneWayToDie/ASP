@page "/groupss/edit"
@using Microsoft.EntityFrameworkCore
@using Academy2.Data
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Groups</h2>
<hr />
@if (Groups is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Groups" OnValidSubmit="UpdateGroups" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Groups.GroupId" value="@Groups.GroupId" />
                <div class="mb-3">
                    <label for="groupname" class="form-label">GroupName:</label>
                    <InputText id="groupname" @bind-Value="Groups.GroupName" class="form-control" />
                    <ValidationMessage For="() => Groups.GroupName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="starttime" class="form-label">StartTime:</label>
                    <InputDate id="starttime" @bind-Value="Groups.StartTime" class="form-control" />
                    <ValidationMessage For="() => Groups.StartTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">StartDate:</label>
                    <InputDate id="startdate" @bind-Value="Groups.StartDate" class="form-control" />
                    <ValidationMessage For="() => Groups.StartDate" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/groupss">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int GroupId { get; set; }

    [SupplyParameterFromForm]
    private Groups? Groups { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Groups ??= await context.Groups.FirstOrDefaultAsync(m => m.GroupId == GroupId);

        if (Groups is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGroups()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Groups!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!GroupsExists(Groups!.GroupId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/groupss");
    }

    private bool GroupsExists(int groupid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Groups.Any(e => e.GroupId == groupid);
    }
}
