@page "/holidayss"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="holidayss/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Holidays">
    <PropertyColumn Property="holidays => holidays.HolidayName" />
    <PropertyColumn Property="holidays => holidays.Duration" />
    <PropertyColumn Property="holidays => holidays.Month" />
    <PropertyColumn Property="holidays => holidays.Day" />
    @* <PropertyColumn Property="holidays => holidays.DaysOff" /> *@

    <TemplateColumn Context="holidays">
        <a href="@($"holidayss/edit?holidayid={holidays.HolidayId}")">Edit</a> |
        <a href="@($"holidayss/details?holidayid={holidays.HolidayId}")">Details</a> |
        <a href="@($"holidayss/delete?holidayid={holidays.HolidayId}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
