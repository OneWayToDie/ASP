@page "/holidayss/delete"
@using Microsoft.EntityFrameworkCore
@using Academy2.Data
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Holidays</h2>
    <hr />
    @if (holidays is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">HolidayName</dt>
            <dd class="col-sm-10">@holidays.HolidayName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@holidays.Duration</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Month</dt>
            <dd class="col-sm-10">@holidays.Month</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Day</dt>
            <dd class="col-sm-10">@holidays.Day</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DaysOff</dt>
            <dd class="col-sm-10">@holidays.DaysOff</dd>
        </dl>
        <EditForm method="post" Model="holidays" OnValidSubmit="DeleteHolidays" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(holidays is null)">Delete</button> |
            <a href="/holidayss">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Holidays? holidays;

    [SupplyParameterFromQuery]
    private byte HolidayId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        holidays = await context.Holidays.FirstOrDefaultAsync(m => m.HolidayId == HolidayId);

        if (holidays is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteHolidays()
    {
        using var context = DbFactory.CreateDbContext();
        context.Holidays.Remove(holidays!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/holidayss");
    }
}
