@page "/player"
@inject TODOList.Services.MusicService Music
@inject IJSRuntime JS

<PageTitle>NIGHTFALL — Плеер</PageTitle>

<div class="fade-in">
    <h1 class="page-title">Плеер</h1>

    <div style="margin-bottom:1rem;">
        <GenrePicker Selected="@currentGenre" ShowCount="true" Variant="@Music.GenrePickerVariant" OnSelect="SelectGenre" />
    </div>

    <div class="player-stage @(isVinyl ? "player-stage-vinyl" : "")">
        @if (isVinyl)
        {
            <div class="player-vinyl">
                <div class="player-ring-wrap">
                    <canvas id="player-ring-canvas" @ref="_ringCanvasRef" class="player-ring-canvas"></canvas>
                    <div class="player-disc @(Music.IsPlaying ? "spinning" : "")">
                        <div class="player-disc-grooves"></div>
                        <div class="player-disc-img"></div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="player-canvas-wrap">
                <canvas id="player-canvas" @ref="_canvasRef" class="player-canvas"></canvas>
            </div>
        }

        @if (Music.Current != null)
        {
            <div>
                <div class="player-current-title">@Music.Current.Title</div>
                <div class="player-current-artist">@Music.Current.Artist</div>
            </div>
        }

        <div class="flex" style="justify-content:center; gap:0.5rem;">
            <button class="btn-theme" @onclick="Prev"><i class="bi bi-skip-start-fill"></i></button>
            <button class="btn-theme btn-primary" @onclick="TogglePlay">
                @if (Music.IsPlaying)
                {
                    <i class="bi bi-pause-fill"></i>
                }
                else
                {
                    <i class="bi bi-play-fill"></i>
                }
            </button>
            <button class="btn-theme" @onclick="Next"><i class="bi bi-skip-end-fill"></i></button>
        </div>

        <div class="player-volume">
            <i class="bi @(volumeIcon)" @onclick="ToggleMute" title="@(Music.Volume <= 0 ? "Включить звук" : "Выключить звук")"></i>
            <input @ref="_volSlider" type="range" min="0" max="100" @oninput="OnVolumeChange" />
            <span class="mono player-vol-val">@volumePercent%</span>
        </div>

        <div class="player-sync">
            <input type="checkbox" checked="@Music.SyncWithTimer" @onchange="ToggleSync" />
            <span>Музыка по фазам таймера (FOCUS / BREAK)</span>
        </div>
    </div>

    <div class="player-tracklist" style="margin-top:2rem;">
        <div class="pt-toolbar">
            <div class="pt-modes">
                <button class="btn-theme @(!_artistsMode ? "btn-primary" : "")" @onclick="() => SetMode(false)">Треки</button>
                <button class="btn-theme @(_artistsMode ? "btn-primary" : "")" @onclick="() => SetMode(true)">Исполнители</button>
            </div>
            <span class="mono muted pt-total">@allTracks.Count треков</span>
        </div>

        @if (_artistsMode && _selectedArtist == null)
        {
            <div class="pt-artistgrid">
                @if (artistGroups.Count == 0)
                {
                    <span class="muted">Исполнители появятся после докачки жанра.</span>
                }
                @foreach (var group in artistGroups)
                {
                    <button class="pt-artistfold" @onclick="() => SelectArtist(group.Name)">
                        <span class="pt-artistname">@group.Name</span>
                        <span class="pt-artistcount">@group.Count</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="pt-pager">
                @if (maxPage > 1)
                {
                    <button class="btn-theme" @onclick="PrevPage" disabled="@(_page <= 0)"><i class="bi bi-chevron-left"></i></button>
                    <span class="mono muted">стр. @(_page + 1) / @maxPage</span>
                    <button class="btn-theme" @onclick="NextPage" disabled="@(_page >= maxPage - 1)"><i class="bi bi-chevron-right"></i></button>
                }
                @if (_artistsMode && _selectedArtist != null)
                {
                    <button class="btn-theme pt-back" @onclick="BackToArtists"><i class="bi bi-arrow-left"></i> Все исполнители</button>
                }
            </div>

            @foreach (var track in pagedTracks)
            {
                var t = track;
                var isCurrent = Music.Current?.Id == track.Id;
                <div class="pt-row @(isCurrent ? "current" : "")" @onclick="() => PlayTrack(t)">
                    <span class="pt-index">@((_page * PageSize + pagedTracks.IndexOf(track) + 1).ToString("00"))</span>
                    <span class="pt-title">@track.Title</span>
                    <span class="pt-artist">· @track.Artist</span>
                    <span class="pt-actions" style="margin-left:auto; display:flex; gap:0.3rem;">
                        @if (isCurrent && Music.IsPlaying)
                        {
                            <span class="mp-eq playing"><span></span><span></span><span></span></span>
                        }
                    </span>
                </div>
            }
        }
    </div>
</div>

<style>
    .pt-toolbar { display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem; flex-wrap:wrap; }
    .pt-modes { display:inline-flex; gap:0.4rem; }
    .pt-total { margin-left:auto; font-size:0.85rem; }
    .pt-pager { display:flex; align-items:center; gap:0.6rem; margin-bottom:0.6rem; }
    .pt-pager .btn-theme:disabled { opacity:0.35; cursor:default; }
    .pt-back { font-size:0.85rem; }
    .pt-artistgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:0.5rem; }
    .pt-artistfold {
        display:flex; align-items:center; justify-content:space-between; gap:0.5rem;
        background: rgba(20,20,20,0.65); border:1px solid var(--border); border-radius:0.6rem;
        padding:0.55rem 0.85rem; cursor:pointer; text-align:left;
        transition: transform .12s ease, border-color .12s ease;
    }
    .pt-artistfold:hover { border-color: var(--accent); transform: translateY(-1px); }
    .pt-artistname { font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .pt-artistcount { font-size:0.8rem; color:var(--text-dim); background:rgba(255,255,255,0.06); padding:0.1rem 0.5rem; border-radius:999px; }
</style>

@code {
    private ElementReference _canvasRef;
    private ElementReference _ringCanvasRef;

    private bool isVinyl => Music.PlayerTheme == "vinyl";
    private string? currentGenre;
    private bool _artistsMode;
    private string? _selectedArtist;
    private int _page;

    private const int PageSize = 100;

    private List<TODOList.Models.Track> allTracks => Music.GetTracks(currentGenre).ToList();

    private List<TODOList.Models.Track> artistTracks =>
        _selectedArtist == null
            ? allTracks
            : allTracks.Where(t => NormalizeArtist(t.Artist) == _selectedArtist).ToList();

    private List<TODOList.Models.Track> pagedTracks => artistTracks.Skip(_page * PageSize).Take(PageSize).ToList();

    private int maxPage => Math.Max(1, (int)Math.Ceiling(artistTracks.Count / (double)PageSize));

    private List<(string Name, int Count)> artistGroups =>
        allTracks
            .GroupBy(t => NormalizeArtist(t.Artist))
            .Select(g => (Name: g.Key, Count: g.Count()))
            .OrderByDescending(g => g.Count)
            .ThenBy(g => g.Name)
            .ToList();

    private static string NormalizeArtist(string? artist)
    {
        var a = (artist ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(a) ? "Unknown" : a;
    }

    private void SetMode(bool artists)
    {
        _artistsMode = artists;
        _selectedArtist = null;
        _page = 0;
    }

    private void SelectArtist(string artist)
    {
        _selectedArtist = artist;
        _page = 0;
    }

    private void BackToArtists()
    {
        _selectedArtist = null;
        _page = 0;
    }

    private void PrevPage() { if (_page > 0) _page--; }

    private void NextPage() { if (_page < maxPage - 1) _page++; }
    private int volumePercent => (int)Math.Round(Music.Volume * 100);
    private string volumeIcon => Music.Volume <= 0 ? "bi-volume-mute" : Music.Volume < 0.5 ? "bi-volume-down" : "bi-volume-up";
    private double _savedVolume = 1.0;
    private bool _volReady;
    private ElementReference _volSlider;
    private bool _interactive;

    private async Task OnVolumeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct))
        {
            Music.Volume = pct / 100.0;
            try
            {
                await JS.InvokeVoidAsync("nightfallAudio.applyVolume", _volSlider, pct / 100.0);
            }
            catch { }
        }
    }

    private async Task ToggleMute()
    {
        if (Music.Volume > 0)
        {
            _savedVolume = Music.Volume;
            Music.Volume = 0;
        }
        else
        {
            Music.Volume = _savedVolume;
        }
        try
        {
            await JS.InvokeVoidAsync("nightfallAudio.applyVolume", _volSlider, Music.Volume);
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        Music.OnChange += HandleChange;
        currentGenre = Music.CurrentGenre ?? Music.Genres.FirstOrDefault();
        await LoadGenreTracksAsync();
    }

    private async Task LoadGenreTracksAsync()
    {
        try
        {
            await Music.EnsureGenreTracksAsync(currentGenre);
            if (Music.Current == null && currentGenre != null)
            {
                var first = Music.GetTracks(currentGenre).FirstOrDefault();
                if (first != null) Music.SetCurrent(first);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void HandleChange()
    {
        try
        {
            InvokeAsync(async () =>
            {
                if (_volReady && _interactive)
                {
                    try { await JS.InvokeVoidAsync("nightfallAudio.applyVolume", _volSlider, Music.Volume); } catch { }
                }
                StateHasChanged();
            });
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(400);
                if (isVinyl)
                {
                    await JS.InvokeVoidAsync("nightfallVisualizer.attachRing", _ringCanvasRef, "#ffffff");
                }
                else
                {
                    await JS.InvokeVoidAsync("nightfallVisualizer.attach", _canvasRef, 64, "#ffffff");
                }
                var saved = await JS.InvokeAsync<double>("nightfallAudio.getVolume");
                Music.Volume = saved;
                _volReady = true;
                if (!string.IsNullOrEmpty(_volSlider.Id))
                {
                    await JS.InvokeVoidAsync("nightfallAudio.applyVolume", _volSlider, saved);
                }
            }
            catch (Exception ex)
            {
                try { Console.Error.WriteLine("visualizer.attach failed: " + ex); } catch { }
            }
            finally
            {
                _interactive = true;
            }
        }
    }

    private void SelectGenre(string? genre)
    {
        if (currentGenre == genre) return;
        currentGenre = genre;
        _page = 0;
        _selectedArtist = null;
        if (!string.IsNullOrEmpty(genre))
        {
            try
            {
                if (_interactive)
                {
                    var urls = Music.GetBackgrounds(genre).ToArray();
                    _ = JS.InvokeVoidAsync("nightfallTheme.setSlides", genre, urls)
                        .AsTask().ContinueWith(t =>
                        {
                            try { _ = t.Exception; } catch { }
                            try { InvokeAsync(StateHasChanged); } catch { }
                        });
                }
            }
            catch { }
            _ = Music.EnsureGenreTracksAsync(genre).ContinueWith(_ =>
            {
                try { InvokeAsync(StateHasChanged); } catch { }
            });
        }
    }

    private async Task TogglePlay()
    {
        try
        {
            if (Music.Current == null) return;
            if (Music.IsPlaying)
            {
                await JS.InvokeVoidAsync("nightfallAudio.pause");
                Music.SetPlaying(false);
                await JS.InvokeVoidAsync("nightfallTheme.pause");
            }
            else
            {
                await PlayCurrent();
            }
        }
        catch (Exception ex)
        {
            try { Console.Error.WriteLine("Player.TogglePlay: " + ex); } catch { }
        }
    }

    private async Task PlayTrack(TODOList.Models.Track track)
    {
        try
        {
            Music.SetCurrent(track);
            await PlayCurrent();
        }
        catch (Exception ex)
        {
            try { Console.Error.WriteLine("Player.PlayTrack: " + ex); } catch { }
        }
    }

    private async Task PlayCurrent()
    {
        try
        {
            if (Music.Current == null) return;
            await JS.InvokeVoidAsync("nightfallAudio.playTrack", $"/{Music.Current.FileName}");
            Music.SetPlaying(true);
            await JS.InvokeVoidAsync("nightfallTheme.play");
        }
        catch (Exception ex)
        {
            try { Console.Error.WriteLine("Player.PlayCurrent: " + ex); } catch { }
        }
    }

    private async Task Next() { try { Music.PlayNext(); await PlayCurrent(); } catch (Exception ex) { try { Console.Error.WriteLine("Player.Next: " + ex); } catch { } } }
    private async Task Prev() { try { Music.PlayPrevious(); await PlayCurrent(); } catch (Exception ex) { try { Console.Error.WriteLine("Player.Prev: " + ex); } catch { } } }

    private void ToggleSync()
    {
        Music.SyncWithTimer = !Music.SyncWithTimer;
    }

    public void Dispose()
    {
        Music.OnChange -= HandleChange;
    }
}