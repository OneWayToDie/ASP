@inherits LayoutComponentBase
@implements IDisposable
@inject TODOList.Services.DataService Data
@inject TODOList.Services.NotificationService Notify
@inject IJSRuntime JS

<div class="app-shell">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="app-main">
        <article class="app-content">
            @Body
        </article>
    </main>
</div>

<NotificationsToast />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _disposed;
    private bool _loaded;

    protected override void OnInitialized()
    {
        Data.OnReminderDue += OnReminderDue;
        Data.OnChange += HandleChange;
        Data.OnPersist += OnPersistNeeded;
    }

    private void HandleChange()
    {
        if (_disposed) return;
        try { InvokeAsync(StateHasChanged); }
        catch { }
    }

    private void OnPersistNeeded()
    {
        if (_disposed) return;
        try
        {
            InvokeAsync(async () =>
            {
                if (_disposed) return;
                try
                {
                    await JS.InvokeVoidAsync("nightfallPersist.save", "state", Data.SerializeState());
                }
                catch { }
            });
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;
            try
            {
                var json = await JS.InvokeAsync<string>("nightfallPersist.load", "state", null);
                if (!string.IsNullOrEmpty(json) && json != "null")
                {
                    Data.RestoreState(json);
                }
            }
            catch { }
        }
    }

    private void OnReminderDue(TODOList.Models.Reminder reminder)
    {
        if (_disposed) return;
        try
        {
            InvokeAsync(async () =>
            {
                if (_disposed) return;
                try
                {
                    Notify.Push(reminder.Title, reminder.Message ?? string.Empty);
                }
                catch { }
                try
                {
                    await JS.InvokeVoidAsync("nightfallPlayBeep");
                }
                catch { }
                try
                {
                    await JS.InvokeVoidAsync("nightfallNotify.show", reminder.Title, reminder.Message ?? string.Empty);
                }
                catch { }
            });
        }
        catch { }
    }

    public void Dispose()
    {
        _disposed = true;
        Data.OnReminderDue -= OnReminderDue;
        Data.OnChange -= HandleChange;
        Data.OnPersist -= OnPersistNeeded;
    }
}
