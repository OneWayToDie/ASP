@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="app-title">Учёт успеваемости</span>
            <AuthorizeView>
                <Authorized>
                    <span class="auth-user" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                    <a class="btn btn-outline-secondary btn-sm" href="logout">Выйти</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary btn-sm" href="login">Войти</a>
                </NotAuthorized>
            </AuthorizeView>
            <ThemeToggle />
            <GlobalSearch />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
