@inherits LayoutComponentBase
@using AcademyAgain.Components.Students

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="app-title">Учёт успеваемости</span>
            <GlobalSearch />
            <div class="top-row-spacer"></div>
            <ThemeToggle />
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-secondary btn-sm" href="logout">Выйти</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary btn-sm" href="login">Войти</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<SupportWidget />
<FeedbackModal @rendermode="InteractiveServer" />
