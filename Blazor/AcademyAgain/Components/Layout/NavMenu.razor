<AuthorizeView>
    <Authorized>
        <div class="sidebar-user">
            <span class="sidebar-user-name" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
            <span class="sidebar-user-role">
                <span class="badge @RoleCss(context.User.FindFirst(ClaimTypes.Role)?.Value)">@RoleText(context.User.FindFirst(ClaimTypes.Role)?.Value)</span>
            </span>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool IsAuthenticated;
    private bool IsExternalUser;
    private bool IsCandidate;
    private bool IsTeaching;
    private bool IsStudent;
    private bool IsTeacher;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        IsAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        IsExternalUser = authState.User.IsInRole("candidate") || authState.User.IsInRole("teacher_candidate");
        IsCandidate = authState.User.IsInRole("candidate");
        IsTeaching = authState.User.IsInRole("admin") || authState.User.IsInRole("moderator") || authState.User.IsInRole("teacher");
        IsStudent = authState.User.IsInRole("student");
        IsTeacher = authState.User.IsInRole("teacher");
    }

    private static string RoleText(string? role) => role switch
    {
        "admin" => "Админ",
        "moderator" => "Модератор",
        "teacher" => "Преподаватель",
        "student" => "Студент",
        "candidate" => "Абитуриент",
        "teacher_candidate" => "Соискатель",
        "support" => "Поддержка",
        _ => role ?? string.Empty
    };

    private static string RoleCss(string? role) => role switch
    {
        "admin" => "text-bg-danger",
        "moderator" => "text-bg-info",
        "teacher" => "text-bg-primary",
        "student" => "text-bg-success",
        "candidate" => "text-bg-warning",
        "teacher_candidate" => "text-bg-secondary",
        "support" => "text-bg-info",
        _ => "text-bg-secondary"
    };
}