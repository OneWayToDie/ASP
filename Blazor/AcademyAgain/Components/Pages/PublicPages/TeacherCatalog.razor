@page "/teachers/catalog"
@attribute [AllowAnonymous]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory

<PageTitle>Преподаватели академии</PageTitle>

<div class="page-header">
    <h2>Преподаватели академии</h2>
    <p class="text-secondary mb-0">Выберите преподавателя, посмотрите его предметы и оставьте заявку на обучение.</p>
</div>

@if (Teachers.Count == 0)
{
    <div class="section-empty">Преподаватели пока не добавлены.</div>
}
else
{
    <div class="portfolio-grid">
        @foreach (var t in Teachers)
        {
            <a class="catalog-card" href="/teachers/card/@t.Id">
                <div class="catalog-avatar">
                    @if (Photo.DataSrc(t.Photo) is string photoSrc)
                    {
                        <img src="@photoSrc" alt="@t.FullName" />
                    }
                    else
                    {
                        <span class="catalog-initials">@t.Initials</span>
                    }
                </div>

                <h3>@t.FullName</h3>

                <div class="catalog-rating" title="Рейтинг 5.0 — отзывов пока нет">
                    <span class="catalog-stars" aria-hidden="true">★★★★★</span>
                    <span class="catalog-rating-value">5.0</span>
                    <span class="catalog-rating-empty">нет отзывов</span>
                </div>

                @if (t.Subjects.Count > 0)
                {
                    <div class="catalog-subjects">
                        @foreach (var subject in t.Subjects.Take(4))
                        {
                            <span class="catalog-chip">@subject</span>
                        }
                        @if (t.SubjectCount > 4)
                        {
                            <span class="catalog-chip catalog-chip-more">+@(t.SubjectCount - 4)</span>
                        }
                    </div>
                }

                <div class="catalog-meta">
                    @if (t.WorkSince is DateTime since)
                    {
                        <span>Стаж с @since.ToString("yyyy")</span>
                    }
                    @if (t.Directions.Count > 0)
                    {
                        <span>@string.Join(", ", t.Directions.Take(2))@(t.Directions.Count > 2 ? " и др." : "")</span>
                    }
                </div>

                <span class="catalog-open">Подробнее →</span>
            </a>
        }
    </div>
}

@code {
    private sealed class TeacherCard
    {
        public int Id;
        public string FullName = string.Empty;
        public string Initials = "?";
        public byte[]? Photo;
        public DateTime? WorkSince;
        public List<string> Subjects = new();
        public int SubjectCount;
        public List<string> Directions = new();
    }

    private List<TeacherCard> Teachers = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();

        var teachers = await context.Teachers.AsNoTracking()
            .OrderBy(t => t.last_name).ThenBy(t => t.first_name)
            .ToListAsync();
        if (teachers.Count == 0)
        {
            return;
        }

        var teacherIds = teachers.Select(t => t.teacher_id).ToList();
        var disciplines = await context.Disciplines.AsNoTracking().ToDictionaryAsync(d => d.discipline_id);
        var directions = await context.Directions.AsNoTracking().ToDictionaryAsync(d => d.direction_id);

        var relations = await context.TeachersDisciplinesRelation.AsNoTracking()
            .Where(r => teacherIds.Contains(r.teacher))
            .ToListAsync();
        var disciplineDirections = await context.DisciplinesDirectionsRelation.AsNoTracking().ToListAsync();

        foreach (var teacher in teachers)
        {
            var disciplineIds = relations
                .Where(r => r.teacher == teacher.teacher_id)
                .Select(r => r.discipline)
                .Distinct()
                .ToList();

            var subjects = disciplineIds
                .Where(disciplines.ContainsKey)
                .Select(id => disciplines[id].discipline_name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!.Trim())
                .Distinct()
                .ToList();

            var dirs = disciplineDirections
                .Where(x => disciplineIds.Contains(x.discipline))
                .Select(x => x.direction)
                .Distinct()
                .Where(directions.ContainsKey)
                .Select(id => directions[id].direction_name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n!.Trim())
                .Distinct()
                .ToList();

            var fullName = ComposeName(teacher.last_name, teacher.first_name, teacher.middle_name);

            Teachers.Add(new TeacherCard
            {
                Id = teacher.teacher_id,
                FullName = fullName,
                Initials = MakeInitials(fullName),
                Photo = teacher.photo,
                WorkSince = teacher.work_since,
                Subjects = subjects,
                SubjectCount = subjects.Count,
                Directions = dirs
            });
        }
    }

    private static string ComposeName(string? last, string? first, string? middle)
        => string.Join(" ", new[] { last, first, middle }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string MakeInitials(string name)
    {
        var parts = name.Split(new[] { ' ', '-', '.' }, StringSplitOptions.RemoveEmptyEntries).Take(2).ToList();
        return parts.Count == 0 ? "?" : string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
    }
}
