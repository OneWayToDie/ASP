@page "/teachers/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Преподаватель: @(teacher?.last_name) @(teacher?.first_name)</PageTitle>

<h1>Преподаватель: @(teacher?.last_name) @(teacher?.first_name)</h1>

<hr />
@if (teacher is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3">
            @if (photoSrc is not null)
            {
                <img class="photo-large" src="@photoSrc" alt="@(teacher.last_name) @(teacher.first_name)" />
            }
            else
            {
                <div class="photo-empty-large">фото нет</div>
            }
        </div>
        <div class="col-md-9">
            <dl class="row">
                <dt class="col-sm-3">Фамилия</dt>
                <dd class="col-sm-9">@teacher.last_name</dd>
                <dt class="col-sm-3">Имя</dt>
                <dd class="col-sm-9">@teacher.first_name</dd>
                <dt class="col-sm-3">Отчество</dt>
                <dd class="col-sm-9">@teacher.middle_name</dd>
                <dt class="col-sm-3">Дата рождения</dt>
                <dd class="col-sm-9">@teacher.birth_date</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@teacher.email</dd>
                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">@teacher.phone</dd>
                <dt class="col-sm-3">Работает с</dt>
                <dd class="col-sm-9">@teacher.work_since</dd>
                <dt class="col-sm-3">Ставка</dt>
                <dd class="col-sm-9">@teacher.rate</dd>
            </dl>
            <div>
                <a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")">Изменить</a> |
                <a href="@($"/teachers")">Назад к списку</a>
            </div>
        </div>
    </div>
}

@code {
    private Teacher? teacher;
    private string? photoSrc;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        teacher = await context.Teachers.FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            photoSrc = Photo.DataSrc(teacher.photo);
        }
    }
}