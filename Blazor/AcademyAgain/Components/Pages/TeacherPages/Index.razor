@page "/teachers"
@attribute [Authorize(Policy = "ManageData")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Teacher>

<PageTitle>Преподаватели</PageTitle>

<div class="list-header">
    <h1>Преподаватели</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="teachers" />
        <a class="btn btn-primary" href="teachers/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="teacher => teacher.teacher_id" Pagination="Pagination">
    <TemplateColumn Title="Фото" Context="teacher">
        <div class="row-key @RowClass(teacher)" data-item-key="@GetKey(teacher)">
            @if (Photo.DataSrc(teacher.photo) is string src)
            {
                <img class="photo-thumb" src="@src" alt="@(teacher.last_name) @(teacher.first_name)" />
            }
            else
            {
                <span class="photo-empty">—</span>
            }
        </div>
    </TemplateColumn>
    <PropertyColumn Property="teacher => teacher.last_name" Title="Фамилия" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.first_name" Title="Имя" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.middle_name" Title="Отчество" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.birth_date" Title="Дата рождения" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.email" Title="Email" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.phone" Title="Телефон" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.work_since" Title="Работает с" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.rate" Title="Ставка" Sortable="true" />
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Teacher> allItems = new();
    private IQueryable<Teacher> query = new List<Teacher>().AsQueryable();
    private List<Teacher> filtered = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        allItems = await context.Teachers.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(allItems).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Фамилия", "Имя", "Отчество", "Дата рождения", "Email", "Телефон", "Работает с", "Ставка" }
        };
        foreach (var t in filtered)
        {
            rows.Add(new[]
            {
                t.last_name, t.first_name, t.middle_name,
                t.birth_date?.ToString("dd.MM.yyyy"), t.email, t.phone,
                t.work_since?.ToString("dd.MM.yyyy"), t.rate?.ToString()
            });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Teacher teacher)
        => TextContains(
            teacher.last_name, teacher.first_name, teacher.middle_name,
            teacher.email, teacher.phone);

    protected override string GetKey(Teacher teacher) => teacher.teacher_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"teachers/details?teacher_id={id}"),
            new("Изменить", $"teachers/edit?teacher_id={id}"),
            new("Удалить", $"teachers/delete?teacher_id={id}", Danger: true),
        };
    }
}