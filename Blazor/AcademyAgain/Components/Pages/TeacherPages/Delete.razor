@page "/teachers/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление преподавателя</PageTitle>

<h1>Удаление преподавателя</h1>

<p class="text-danger">Вы уверены, что хотите удалить этого преподавателя?</p>
<div>
    <hr />
    @if (teacher is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Фото</dt>
            <dd class="col-sm-10">
                @if (photoSrc is not null)
                {
                    <img class="photo-large" src="@photoSrc" alt="@(teacher.last_name) @(teacher.first_name)" />
                }
                else
                {
                    <div class="photo-empty-large">фото нет</div>
                }
            </dd>
            <dt class="col-sm-2">Фамилия</dt>
            <dd class="col-sm-10">@teacher.last_name</dd>
            <dt class="col-sm-2">Имя</dt>
            <dd class="col-sm-10">@teacher.first_name</dd>
            <dt class="col-sm-2">Отчество</dt>
            <dd class="col-sm-10">@teacher.middle_name</dd>
            <dt class="col-sm-2">Дата рождения</dt>
            <dd class="col-sm-10">@teacher.birth_date</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@teacher.email</dd>
            <dt class="col-sm-2">Телефон</dt>
            <dd class="col-sm-10">@teacher.phone</dd>
            <dt class="col-sm-2">Работает с</dt>
            <dd class="col-sm-10">@teacher.work_since</dd>
            <dt class="col-sm-2">Ставка</dt>
            <dd class="col-sm-10">@teacher.rate</dd>
        </dl>

        <EditForm method="post" Model="teacher" OnValidSubmit="DeleteTeacher" FormName="delete" Enhance>
            <input type="hidden" name="Teacher.teacher_id" value="@teacher.teacher_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/teachers">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Teacher? teacher;
    private string? photoSrc;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        teacher = await context.Teachers.FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            photoSrc = Photo.DataSrc(teacher.photo);
        }
    }

    private async Task DeleteTeacher()
    {
        using var context = DbFactory.CreateDbContext();
        context.Teachers.Remove(teacher!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/teachers");
    }
}