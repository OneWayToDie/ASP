@page "/completedisciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Пройденные дисциплины</PageTitle>

<div class="list-header">
    <h1>Пройденные дисциплины</h1>
    <a class="btn btn-primary" href="completedisciplines/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.CompleteDisciplines">
    <PropertyColumn Property="complete => complete.group" Title="Группа" />
    <PropertyColumn Property="complete => complete.discipline" Title="Дисциплина" />

    <TemplateColumn Context="complete">
        <a href="@($"completedisciplines/edit?group={complete.group}&discipline={complete.discipline}")">Изменить</a> |
        <a href="@($"completedisciplines/details?group={complete.group}&discipline={complete.discipline}")">Подробно</a> |
        <a href="@($"completedisciplines/delete?group={complete.group}&discipline={complete.discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}