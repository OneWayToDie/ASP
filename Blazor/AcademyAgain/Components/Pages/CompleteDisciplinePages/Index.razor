@page "/completedisciplines"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<CompleteDiscipline>

<PageTitle>Пройденные дисциплины</PageTitle>

<div class="list-header">
    <h1>Пройденные дисциплины</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="completedisciplines" />
        <a class="btn btn-primary" href="completedisciplines/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="complete => complete.group.ToString() + '_' + complete.discipline.ToString()" Pagination="Pagination">
    <TemplateColumn Title="Группа" Sortable="true" SortBy="GridSort<CompleteDiscipline>.ByAscending(c => GroupName(c.group))" Context="complete">
        <div class="row-key @RowClass(complete)" data-item-key="@GetKey(complete)">
            <a class="table-link" href="@($"/groups/details?group_id={complete.group}")">@GroupName(complete.group)</a>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Дисциплина" Sortable="true" SortBy="GridSort<CompleteDiscipline>.ByAscending(c => DisciplineName(c.discipline))" Context="complete">
        <a class="table-link" href="@($"/disciplines/details?discipline_id={complete.discipline}")">@DisciplineName(complete.discipline)</a>
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<CompleteDiscipline> allItems = new();
    private IQueryable<CompleteDiscipline> query = new List<CompleteDiscipline>().AsQueryable();
    private List<CompleteDiscipline> filtered = new();
    private Dictionary<int, string> groupNames = new();
    private Dictionary<int, string> disciplineNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        groupNames = await context.Groups.ToDictionaryAsync(g => g.group_id, g => g.group_name?.Trim() ?? $"№{g.group_id}");
        disciplineNames = await context.Disciplines.ToDictionaryAsync(d => d.discipline_id, d => d.discipline_name ?? $"№{d.discipline_id}");
        allItems = await context.CompleteDisciplines.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(allItems).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]>
        {
            new[] { "Группа", "Дисциплина" }
        };
        foreach (var c in filtered)
        {
            rows.Add(new[] { GroupName(c.group), DisciplineName(c.discipline) });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(CompleteDiscipline complete)
        => TextContains(GroupName(complete.group), DisciplineName(complete.discipline));

    private string GroupName(int id)
        => groupNames.TryGetValue(id, out var name) ? name : $"№{id}";

    private string DisciplineName(int id)
        => disciplineNames.TryGetValue(id, out var name) ? name : $"№{id}";

    protected override string GetKey(CompleteDiscipline c) => $"{c.group}|{c.discipline}";

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var group) || !int.TryParse(parts[1], out var discipline))
            return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"completedisciplines/details?group={group}&discipline={discipline}"),
            new("Изменить", $"completedisciplines/edit?group={group}&discipline={discipline}"),
            new("Удалить", $"completedisciplines/delete?group={group}&discipline={discipline}", Danger: true),
        };
    }
}