@page "/completedisciplines/delete"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление пройденной дисциплины</PageTitle>

<h1>Удаление пройденной дисциплины</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту пройденную дисциплину?</p>
<div>
    <hr />
    @if (completediscipline is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Группа</dt>
            <dd class="col-sm-10">@GroupName</dd>
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
        </dl>
        <EditForm method="post" Model="completediscipline" OnValidSubmit="DeleteCompleteDiscipline" FormName="delete" Enhance>
            <input type="hidden" name="CompleteDiscipline.group" value="@completediscipline.group" />
            <input type="hidden" name="CompleteDiscipline.discipline" value="@completediscipline.discipline" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/completedisciplines">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private CompleteDiscipline? completediscipline;
    private string? GroupName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int group { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        completediscipline = await context.CompleteDisciplines.FirstOrDefaultAsync(m => m.group == group && m.discipline == discipline);

        if (completediscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            GroupName = await context.Groups
                .Where(g => g.group_id == completediscipline.group)
                .Select(g => g.group_name)
                .FirstOrDefaultAsync() ?? "—";
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == completediscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteCompleteDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.CompleteDisciplines.Remove(completediscipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/completedisciplines");
    }
}