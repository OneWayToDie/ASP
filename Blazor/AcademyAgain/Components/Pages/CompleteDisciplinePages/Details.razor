@page "/completedisciplines/details"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Пройденная дисциплина</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Пройденная дисциплина</h1>

<hr />
@if (completediscipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Группа</dt>
        <dd class="col-sm-10"><a href="@($"/groups/details?group_id={completediscipline.group}")">@GroupName</a></dd>
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={completediscipline.discipline}")">@DisciplineName</a></dd>
    </dl>
    <div>
        <a href="@($"/completedisciplines/edit?group={completediscipline.group}&discipline={completediscipline.discipline}")">Изменить</a> |
        <a href="@($"/completedisciplines")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Пройденные дисциплины", "/completedisciplines"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private CompleteDiscipline? completediscipline;
    private string? GroupName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int group { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        completediscipline = await context.CompleteDisciplines.FirstOrDefaultAsync(m => m.group == group && m.discipline == discipline);

        if (completediscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            GroupName = await context.Groups
                .Where(g => g.group_id == completediscipline.group)
                .Select(g => g.group_name)
                .FirstOrDefaultAsync() ?? "—";
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == completediscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}