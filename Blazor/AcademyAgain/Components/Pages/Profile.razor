            t.email = email;
            t.phone = phone;
        }
        else
        {
            return;
        }
        await context.SaveChangesAsync();
        SaveOk = "Данные сохранены.";
        await LoadAsync();
    }

    private static string? Limit(string? value, int max)
        => value is null ? null : value.Length <= max ? value : value[..max];

    private async Task ChangeLoginAsync()
    {
        LoginError = null;
        LoginOk = null;
        if (user is null)
        {
            return;
        }
        var newLogin = NewLogin?.Trim() ?? string.Empty;
        if (newLogin.Length == 0)
        {
            LoginError = "Введите новый логин.";
            return;
        }
        if (newLogin.Length > 50)
        {
            LoginError = "Логин должен быть не длиннее 50 символов.";
            return;
        }
        if (newLogin == user.username)
        {
            LoginError = "Новый логин совпадает с текущим.";
            return;
        }
        await using var context = DbFactory.CreateDbContext();
        var u = await context.Users.FirstOrDefaultAsync(x => x.username == user.username);
        if (u is null)
        {
            LoginError = "Пользователь не найден.";
            return;
        }
        if (!AuthStore.VerifyPassword(LoginCurPassword, u.password_hash))
        {
            LoginError = "Текущий пароль введён неверно.";
            return;
        }
        if (await context.Users.AsNoTracking().AnyAsync(x => x.username == newLogin && x.user_id != u.user_id))
        {
            LoginError = "Пользователь с таким логином уже существует.";
            return;
        }
        u.username = newLogin;
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex) when (ex.InnerException is SqlException { Number: 2601 or 2627 })
        {
            LoginError = "Пользователь с таким логином уже существует.";
            return;
        }

        var role = await context.Roles.AsNoTracking()
            .FirstOrDefaultAsync(r => r.role_id == u.role_id);
        role ??= new Role { role_id = u.role_id, role_name = u.role_id.ToString() };
        var claims = new[]
        {
            new Claim(ClaimTypes.Name, newLogin),
            new Claim(ClaimTypes.Role, role.role_name)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var authResult = await HttpContext!.AuthenticateAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        var isPersistent = authResult.Properties?.IsPersistent ?? true;
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity), new AuthenticationProperties { IsPersistent = isPersistent });
        Navigation.NavigateTo("/profile", forceLoad: true);
    }

    private async Task ChangePasswordAsync()
    {
        PasswordError = null;
        PasswordOk = null;
        if (user is null)
        {
            return;
        }
        await using var context = DbFactory.CreateDbContext();
        var u = await context.Users.FirstOrDefaultAsync(x => x.username == user.username);
        if (u is null)
        {
            PasswordError = "Пользователь не найден.";
            return;
        }
        if (!AuthStore.VerifyPassword(CurPassword, u.password_hash))
        {
            PasswordError = "Текущий пароль введён неверно.";
            return;
        }
        if (NewPassword.Length < 6)
        {
            PasswordError = "Новый пароль должен быть не короче 6 символов.";
            return;
        }
        if (NewPassword != ConfirmPassword)
        {
            PasswordError = "Пароли не совпадают.";
            return;
        }
        u.password_hash = AuthStore.HashPassword(NewPassword);
        await context.SaveChangesAsync();
        PasswordOk = "Пароль изменён.";
        CurPassword = NewPassword = ConfirmPassword = string.Empty;
    }
