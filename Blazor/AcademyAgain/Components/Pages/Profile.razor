    private async Task SearchAsync()
    {
        searched = true;
        SearchStudents.Clear();
        SearchTeachers.Clear();
        LinkError = null;
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            LinkError = "Введите ФИО для поиска.";
            return;
        }
        await using var context = DbFactory.CreateDbContext();
        if (RoleText == "Студент")
        {
            SearchStudents = await context.Students.AsNoTracking()
                .Where(s => s.last_name.Contains(SearchText.Trim()) ||
                            s.first_name.Contains(SearchText.Trim()) ||
                            (s.middle_name != null && s.middle_name.Contains(SearchText.Trim())))
                .OrderBy(s => s.last_name).ThenBy(s => s.first_name)
                .Take(30).ToListAsync();
        }
        else if (RoleText == "Преподаватель")
        {
            SearchTeachers = await context.Teachers.AsNoTracking()
                .Where(t => (t.last_name != null && t.last_name.Contains(SearchText.Trim())) ||
                            (t.first_name != null && t.first_name.Contains(SearchText.Trim())) ||
                            (t.middle_name != null && t.middle_name.Contains(SearchText.Trim())))
                .OrderBy(t => t.last_name)
                .Take(30).ToListAsync();
        }
    }

