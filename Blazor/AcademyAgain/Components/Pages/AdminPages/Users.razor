@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject IJSRuntime Js

<PageTitle>Пользователи</PageTitle>

<div class="list-header">
    <h1>Пользователи</h1>
    <div class="list-actions">
        <a class="btn btn-outline-secondary" href="">Панель</a>
    </div>
</div>

<div class="table-card mb-3">
    <h2 class="form-section-title">Новый пользователь</h2>
    @if (NewError is not null)
    {
        <div class="alert alert-danger py-2">@NewError</div>
    }
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Логин</label>
            <input class="form-control" @bind="NewUsername" placeholder="логин" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Пароль</label>
            <input type="password" class="form-control" @bind="NewPassword" placeholder="мин. 6 символов" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Роль</label>
            <select class="form-select" @bind="NewRole">
                @foreach (var role in Roles)
                {
                    <option value="@role.role_id">@RoleName(role.role_id)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-primary" @onclick="AddAsync">Добавить</button>
        </div>
    </div>
</div>

@if (loaded)
{
    <table class="table context-table">
        <thead>
            <tr>
                <th>Пользователь</th>
                <th>Роль</th>
                <th>Новый пароль</th>
                <th style="width:120px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td class="fw-semibold">@row.Username</td>
                    <td>
                        <select class="form-select form-select-sm" value="@row.RoleId" @onchange='e => RoleEdit[row.Id] = int.Parse(e.Value?.ToString() ?? "3")'>
                            @foreach (var role in Roles)
                            {
                                <option value="@role.role_id" selected="@(role.role_id == row.RoleId)">@RoleName(role.role_id)</option>
                            }
                        </select>
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <input type="password" class="form-control form-control-sm" placeholder="••••••" @bind="PassEdit[row.Id]" />
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveRowAsync(row.Id)">Сохранить</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(row.Id)">Удалить</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool loaded;
    private List<UserRow> Rows = new();
    private List<Role> Roles = new();

    private string NewUsername = string.Empty;
    private string NewPassword = string.Empty;
    private int NewRole = 3;
    private string? NewError;

    private Dictionary<int, int> RoleEdit = new();
    private Dictionary<int, string> PassEdit = new();

    private sealed record UserRow(int Id, string Username, int RoleId);

    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        Roles = await context.Roles.OrderBy(r => r.role_id).ToListAsync();
        Rows = (await context.Users.OrderBy(u => u.username).ToListAsync())
            .Select(u => new UserRow(u.user_id, u.username, u.role_id))
            .ToList();
        loaded = true;
        StateHasChanged();
    }

    private string RoleName(int id)
        => Roles.FirstOrDefault(r => r.role_id == id)?.role_name ?? id.ToString();

    private async Task AddAsync()
    {
        NewError = null;
        if (string.IsNullOrWhiteSpace(NewUsername))
        {
            NewError = "Введите логин.";
            return;
        }
        if (NewPassword.Length < 6)
        {
            NewError = "Пароль должен быть не короче 6 символов.";
            return;
        }
        await using var context = DbFactory.CreateDbContext();
        if (await context.Users.AnyAsync(u => u.username == NewUsername))
        {
            NewError = "Пользователь с таким логином уже существует.";
            return;
        }
        context.Users.Add(new User
        {
            username = NewUsername,
            password_hash = AuthStore.HashPassword(NewPassword),
            role_id = NewRole
        });
        await context.SaveChangesAsync();
        NewUsername = string.Empty;
        NewPassword = string.Empty;
        await ReloadAsync();
    }

    private async Task SaveRowAsync(int id)
    {
        await using var context = DbFactory.CreateDbContext();
        var user = await context.Users.FindAsync(id);
        if (user is null)
        {
            await ReloadAsync();
            return;
        }
        if (RoleEdit.TryGetValue(id, out var roleId))
        {
            user.role_id = roleId;
        }
        if (PassEdit.TryGetValue(id, out var pass) && !string.IsNullOrWhiteSpace(pass))
        {
            user.password_hash = AuthStore.HashPassword(pass);
        }
        await context.SaveChangesAsync();
        await ReloadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var currentName = authState.User.Identity?.Name;

        await using var context = DbFactory.CreateDbContext();
        var user = await context.Users.FindAsync(id);
        if (user is null)
        {
            await ReloadAsync();
            return;
        }
        if (user.username == currentName)
        {
            await Js.InvokeVoidAsync("alert", "Нельзя удалить собственную учётную запись.");
            return;
        }
        if (!await Js.InvokeAsync<bool>("confirm", $"Удалить пользователя «{user.username}»?"))
        {
            return;
        }
        context.Users.Remove(user);
        await context.SaveChangesAsync();
        await ReloadAsync();
    }
}