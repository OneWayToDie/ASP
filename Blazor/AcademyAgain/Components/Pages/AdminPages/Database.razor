@page "/admin/database"
@attribute [Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@using AcademyAgain.Components.Admin

<PageTitle>База данных</PageTitle>

<div class="list-header">
    <h1>База данных</h1>
    <div class="list-actions">
        <a class="btn btn-outline-secondary" href="admin/users">Пользователи</a>
        <a class="btn btn-outline-secondary" href="">Панель</a>
    </div>
</div>

@if (loaded)
{
    <div class="table-card mb-3">
        <h2 class="form-section-title">Резервная копия</h2>
        <BackupPanel />
    </div>
}

@code {
    private bool loaded;

    protected override void OnInitialized()
    {
        loaded = true;
    }
}