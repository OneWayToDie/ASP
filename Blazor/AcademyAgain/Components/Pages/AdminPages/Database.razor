@page "/admin/database"
@attribute [Authorize(Roles = "admin,moderator")]
@rendermode InteractiveServer
@using AcademyAgain.Components.Admin
@inject AuthenticationStateProvider Auth

<PageTitle>База данных</PageTitle>

<div class="list-header">
    <h1>База данных</h1>
    <div class="list-actions">
        <a class="btn btn-outline-secondary" href="">Панель</a>
    </div>
</div>

@if (loaded)
{
    <div class="table-card mb-3">
        <h2 class="form-section-title">Пользователи</h2>
        <UserManager />
    </div>

    @if (IsAdmin)
    {
        <div class="table-card mb-3">
            <h2 class="form-section-title">Резервная копия</h2>
            <BackupPanel />
        </div>
    }
}

@code {
    private bool loaded;
    private bool IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        IsAdmin = state.User.IsInRole("admin");
        loaded = true;
    }
}