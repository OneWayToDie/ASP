@page "/notfound"
@attribute [AllowAnonymous]

<PageTitle>Здесь ничего нет</PageTitle>

<div class="notfound-page" data-notfound>
    <div class="notfound-back">
        <a class="btn btn-outline-secondary" href="/">← Назад</a>
    </div>

    <div class="notfound-eye" aria-hidden="true">
        <div class="eye-eye">
            <div class="eye-iris">
                <div class="eye-pupil"></div>
            </div>
        </div>
    </div>

    <p class="notfound-text">здесь ничего нет, но возможно в будущем появится</p>
</div>