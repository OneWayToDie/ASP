@page "/disciplines/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление дисциплины</PageTitle>

<h1>Удаление дисциплины</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту дисциплину?</p>
<div>
    <hr />
    @if (discipline is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-2">Кол-во занятий</dt>
            <dd class="col-sm-10">@discipline.number_of_lessons</dd>
        </dl>
        <EditForm method="post" Model="discipline" OnValidSubmit="DeleteDiscipline" FormName="delete" Enhance>
            <input type="hidden" name="Discipline.discipline_id" value="@discipline.discipline_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/disciplines">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.Disciplines.Remove(discipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");
    }
}