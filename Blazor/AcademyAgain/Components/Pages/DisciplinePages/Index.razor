@page "/disciplines"
@attribute [Authorize(Policy = "ManageData")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Discipline>

<PageTitle>Дисциплины</PageTitle>

<div class="list-header">
    <h1>Дисциплины</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="disciplines" />
        <a class="btn btn-primary" href="disciplines/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="discipline => discipline.discipline_id" Pagination="Pagination">
    <TemplateColumn Title="Название" Sortable="true" SortBy="GridSort<Discipline>.ByAscending(d => d.discipline_name)" Context="discipline">
        <div class="row-key @RowClass(discipline)" data-item-key="@GetKey(discipline)">
            @DisciplineName(discipline)
        </div>
    </TemplateColumn>
    <PropertyColumn Property="discipline => discipline.number_of_lessons" Title="Кол-во занятий" Sortable="true" />
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Discipline> allItems = new();
    private IQueryable<Discipline> query = new List<Discipline>().AsQueryable();
    private List<Discipline> filtered = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        allItems = await context.Disciplines.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(allItems).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]>
        {
            new[] { "Название", "Кол-во занятий" }
        };
        rows.AddRange(filtered.Select(d => new[] { DisciplineName(d), d.number_of_lessons.ToString() }));
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Discipline discipline)
        => TextContains(discipline.discipline_name);

    private string DisciplineName(Discipline d) => d.discipline_name ?? $"№{d.discipline_id}";

    protected override string GetKey(Discipline d) => d.discipline_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"disciplines/details?discipline_id={id}"),
            new("Изменить", $"disciplines/edit?discipline_id={id}"),
            new("Удалить", $"disciplines/delete?discipline_id={id}", Danger: true),
        };
    }
}