@page "/disciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Дисциплины</PageTitle>

<div class="list-header">
    <h1>Дисциплины</h1>
    <a class="btn btn-primary" href="disciplines/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Disciplines">
    <PropertyColumn Property="discipline => discipline.discipline_name" Title="Название" />
    <PropertyColumn Property="discipline => discipline.number_of_lessons" Title="Кол-во занятий" />

    <TemplateColumn Context="discipline">
        <a href="@($"disciplines/edit?discipline_id={discipline.discipline_id}")">Изменить</a> |
        <a href="@($"disciplines/details?discipline_id={discipline.discipline_id}")">Подробно</a> |
        <a href="@($"disciplines/delete?discipline_id={discipline.discipline_id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
