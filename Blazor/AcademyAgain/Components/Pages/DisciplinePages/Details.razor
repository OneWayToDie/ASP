@page "/disciplines/details"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Дисциплина: @(discipline?.discipline_name)</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Дисциплина: @(discipline?.discipline_name)</h1>

<hr />
@if (discipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@discipline.discipline_name</dd>
        <dt class="col-sm-2">Кол-во занятий</dt>
        <dd class="col-sm-10">@discipline.number_of_lessons</dd>
    </dl>
    <div>
        <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")">Изменить</a> |
        <a href="@($"/disciplines")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Дисциплины", "/disciplines"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}