@page "/disciplines/create"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using System.Data
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление дисциплины</PageTitle>

<h1>Добавление дисциплины</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Discipline" OnValidSubmit="AddDiscipline" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="discipline_name" class="form-label">Название:</label>
                <InputText id="discipline_name" @bind-Value="Discipline.discipline_name" class="form-control" />
                <ValidationMessage For="() => Discipline.discipline_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="number_of_lessons" class="form-label">Кол-во занятий:</label>
                <InputNumber id="number_of_lessons" @bind-Value="Discipline.number_of_lessons" class="form-control" aria-required="true"/>
                <ValidationMessage For="() => Discipline.number_of_lessons" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplines">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Discipline Discipline { get; set; } = default!;

    protected override void OnInitialized() => Discipline ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        await using var transaction = await context.Database.BeginTransactionAsync(IsolationLevel.Serializable);
        Discipline.discipline_id = context.Disciplines.Any()
            ? context.Disciplines.Max(d => d.discipline_id) + 1
            : 1;
        context.Disciplines.Add(Discipline);
        await context.SaveChangesAsync();
        await transaction.CommitAsync();
        NavigationManager.NavigateTo("/disciplines");
    }
}