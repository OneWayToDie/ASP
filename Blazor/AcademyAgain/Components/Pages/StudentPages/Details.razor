@page "/students/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Студент: @(student?.last_name) @(student?.first_name)</PageTitle>

<h1>Студент: @(student?.last_name) @(student?.first_name)</h1>

<hr />
@if (student is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3">
            @if (photoSrc is not null)
            {
                <img class="photo-large" src="@photoSrc" alt="@(student.last_name) @(student.first_name)" />
            }
            else
            {
                <div class="photo-empty-large">фото нет</div>
            }
        </div>
        <div class="col-md-9">
            <dl class="row">
                <dt class="col-sm-3">Фамилия</dt>
                <dd class="col-sm-9">@student.last_name</dd>
                <dt class="col-sm-3">Имя</dt>
                <dd class="col-sm-9">@student.first_name</dd>
                <dt class="col-sm-3">Отчество</dt>
                <dd class="col-sm-9">@student.middle_name</dd>
                <dt class="col-sm-3">Дата рождения</dt>
                <dd class="col-sm-9">@student.birth_date</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@student.email</dd>
                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">@student.phone</dd>
                <dt class="col-sm-3">Группа</dt>
                <dd class="col-sm-9">@GroupName</dd>
                <dt class="col-sm-3">Направление</dt>
                <dd class="col-sm-9">@DirectionName</dd>
            </dl>
            <div>
                <a href="@($"/students/edit?stud_id={student.stud_id}")">Изменить</a> |
                <a href="@($"/students")">Назад к списку</a>
            </div>
        </div>
    </div>
}

@code {
    private Student? student;
    private string? photoSrc;
    private string GroupName = "—";
    private string DirectionName = "—";

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        student = await context.Students.FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (student is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            photoSrc = Photo.DataSrc(student.photo);

            var group = await context.Groups.FirstOrDefaultAsync(g => g.group_id == student.group);
            if (group is not null)
            {
                GroupName = group.group_name ?? "—";
                DirectionName = await context.Directions
                    .Where(d => d.direction_id == group.direction)
                    .Select(d => d.direction_name)
                    .FirstOrDefaultAsync() ?? "—";
            }
        }
    }
}