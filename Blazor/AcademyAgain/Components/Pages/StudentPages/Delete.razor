@page "/students/delete"
@attribute [Authorize(Policy = "Teaching")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление студента</PageTitle>

<h1>Удаление студента</h1>

<p class="text-danger">Вы уверены, что хотите удалить этого студента?</p>
<div>
    <hr />
    @if (student is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Фото</dt>
            <dd class="col-sm-10">
                @if (photoSrc is not null)
                {
                    <img class="photo-large" src="@photoSrc" alt="@(student.last_name) @(student.first_name)" />
                }
                else
                {
                    <div class="photo-empty-large">фото нет</div>
                }
            </dd>
            <dt class="col-sm-2">Фамилия</dt>
            <dd class="col-sm-10">@student.last_name</dd>
            <dt class="col-sm-2">Имя</dt>
            <dd class="col-sm-10">@student.first_name</dd>
            <dt class="col-sm-2">Отчество</dt>
            <dd class="col-sm-10">@student.middle_name</dd>
            <dt class="col-sm-2">Дата рождения</dt>
            <dd class="col-sm-10">@student.birth_date</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@student.email</dd>
            <dt class="col-sm-2">Телефон</dt>
            <dd class="col-sm-10">@student.phone</dd>
        </dl>

        <EditForm method="post" Model="student" OnValidSubmit="DeleteStudent" FormName="delete" Enhance>
            <input type="hidden" name="Student.stud_id" value="@student.stud_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/students">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Student? student;
    private string? photoSrc;

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        student = await context.Students.FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (student is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            photoSrc = Photo.DataSrc(student.photo);
        }
    }

    private async Task DeleteStudent()
    {
        using var context = DbFactory.CreateDbContext();
        context.Students.Remove(student!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/students");
    }
}