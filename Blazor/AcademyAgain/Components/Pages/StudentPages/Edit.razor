@page "/students/edit"
@attribute [Authorize]
@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование студента</PageTitle>

<h1>Редактирование студента</h1>

<hr />
@if (Student is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" enctype="multipart/form-data" Model="Student" OnValidSubmit="UpdateStudent" FormName="edit" >
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Student.stud_id" value="@Student.stud_id" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="last_name" class="form-label">Фамилия:</label>
                    <InputText id="last_name" @bind-Value="Student.last_name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Student.last_name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="first_name" class="form-label">Имя:</label>
                    <InputText id="first_name" @bind-Value="Student.first_name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Student.first_name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="middle_name" class="form-label">Отчество:</label>
                    <InputText id="middle_name" @bind-Value="Student.middle_name" class="form-control" />
                    <ValidationMessage For="() => Student.middle_name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="birth_date" class="form-label">Дата рождения:</label>
                    <InputDate id="birth_date" @bind-Value="Student.birth_date" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Student.birth_date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="Student.email" class="form-control" />
                    <ValidationMessage For="() => Student.email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phone" class="form-label">Телефон:</label>
                    <InputText id="phone" @bind-Value="Student.phone" class="form-control" />
                    <ValidationMessage For="() => Student.phone" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="group" class="form-label">Группа:</label>
                    <select id="group" name="group" class="form-select">
                        <option value="">— не выбрано —</option>
                        @foreach (var grp in groups.OrderBy(g => g.group_name))
                        {
                            <option value="@grp.group_id" selected="@(SelectedGroup == grp.group_id)">@grp.group_name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Фотография:</label>
                    <div class="mb-2">
                        <img id="photoPreview" class="photo-preview" src="@previewSrc" alt="Фото" style="display: @(previewSrc is null ? "none" : "inline-block");" />
                    </div>
                    <input id="PhotoFile" name="PhotoFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp" class="form-control" data-photo-input="photoPreview" />
                    @if (previewSrc is not null)
                    {
                        <div class="form-check mt-2">
                            <input id="removePhoto" name="removePhoto" type="checkbox" value="1" class="form-check-input" />
                            <label for="removePhoto" class="form-check-label">Удалить фото</label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/students">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    [SupplyParameterFromForm]
    private Student? Student { get; set; }

    [SupplyParameterFromForm]
    private string? group { get; set; }

    [SupplyParameterFromForm]
    private string? removePhoto { get; set; }

    [SupplyParameterFromForm]
    private IFormFile? PhotoFile { get; set; }

    private List<Group> groups = new();
    private string? previewSrc;

    private int? SelectedGroup
        => int.TryParse(group, out var value) ? value : Student?.group;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Student ??= await context.Students.FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (Student is null)
        {
            NavigationManager.NavigateTo("notfound");
        }

        groups = await context.Groups.OrderBy(g => g.group_name).ToListAsync();
        var photoBytes = await context.Students
            .Where(s => s.stud_id == stud_id)
            .Select(s => s.photo)
            .FirstOrDefaultAsync();
        previewSrc = Photo.DataSrc(photoBytes);
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateStudent()
    {
        Student!.group = int.TryParse(group, out var value) ? value : null;

        if (PhotoFile is { Length: > 0 })
        {
            using var stream = new MemoryStream();
            await PhotoFile.CopyToAsync(stream);
            Student.photo = stream.ToArray();
        }
        else if (removePhoto == "1")
        {
            Student.photo = null;
        }
        else
        {
            using var existing = DbFactory.CreateDbContext();
            Student.photo = await existing.Students
                .Where(s => s.stud_id == Student.stud_id)
                .Select(s => s.photo)
                .FirstOrDefaultAsync();
        }

        using var context = DbFactory.CreateDbContext();
        context.Attach(Student).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!StudentExists(Student!.stud_id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/students");
    }

    private bool StudentExists(int stud_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Students.Any(e => e.stud_id == stud_id);
    }
}