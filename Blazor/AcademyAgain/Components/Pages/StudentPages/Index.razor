@page "/students"
@attribute [Authorize(Policy = "Teaching")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Student>

<PageTitle>Студенты</PageTitle>

<div class="list-header">
    <h1>Студенты</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="students" />
        <a class="btn btn-primary" href="students/create">Создать</a>
    </div>
</div>

<div class="filter-bar">
    <label class="form-label mb-0">Направление</label>
    <select class="form-select" value="@selectedDirection" @onchange="OnDirectionChanged">
        <option value="">Все</option>
        @foreach (var dir in directions.OrderBy(d => d.direction_id))
        {
            <option value="@dir.direction_id">@dir.direction_name</option>
        }
    </select>
    <label class="form-label mb-0">Группа</label>
    <select class="form-select" value="@selectedGroup" @onchange="OnGroupChanged">
        <option value="">Все</option>
        @foreach (var grp in availableGroups.OrderBy(g => g.group_name))
        {
            <option value="@grp.group_id">@grp.group_name</option>
        }
    </select>
</div>

<QuickGrid Class="table context-table" Items="filteredStudents" ItemKey="s => s.stud_id" Pagination="Pagination">
    <TemplateColumn Title="Фото" Context="s">
        <div class="row-key @RowClass(s)" data-item-key="@GetKey(s)">
            @if (Photo.DataSrc(s.photo) is string src)
            {
                <img class="photo-thumb" src="@src" alt="@(s.last_name) @(s.first_name)" />
            }
            else
            {
                <span class="photo-empty">—</span>
            }
        </div>
    </TemplateColumn>
    <PropertyColumn Property="s => s.last_name" Title="Фамилия" Sortable="true" />
    <PropertyColumn Property="s => s.first_name" Title="Имя" Sortable="true" />
    <PropertyColumn Property="s => s.middle_name" Title="Отчество" Sortable="true" />
    <TemplateColumn Title="Группа" Sortable="true" SortBy="GridSort<Student>.ByAscending(s => GroupName(s.group))" Context="s">
        <a class="table-link" href="@($"/groups/details?group_id={s.group}")">@GroupName(s.group)</a>
    </TemplateColumn>
    <TemplateColumn Title="Направление" Sortable="true" SortBy="GridSort<Student>.ByAscending(s => GroupDirectionName(s.group))" Context="s">
        @GroupDirectionName(s.group)
    </TemplateColumn>
    <PropertyColumn Property="s => s.birth_date" Title="Дата рождения" Sortable="true" />
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Direction> directions = new();
    private List<Group> allGroups = new();
    private List<Student> allStudents = new();
    private IQueryable<Student> filteredStudents = new List<Student>().AsQueryable();

    private int? selectedDirection;
    private int? selectedGroup;

    private List<Group> availableGroups
        => allGroups
            .Where(g => selectedDirection is null || g.direction == selectedDirection)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        directions = await context.Directions.ToListAsync();
        allGroups = await context.Groups.ToListAsync();
        allStudents = await context.Students.ToListAsync();
        ApplyFilter();
    }

    private void OnDirectionChanged(ChangeEventArgs e)
    {
        selectedDirection = int.TryParse(e.Value?.ToString(), out var value) ? value : null;
        selectedGroup = null;
        ApplyFilter();
    }

    private void OnGroupChanged(ChangeEventArgs e)
    {
        selectedGroup = int.TryParse(e.Value?.ToString(), out var value) ? value : null;
        ApplyFilter();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    private void ApplyFilter()
    {
        IEnumerable<Student> query = ApplySearch(allStudents);

        if (selectedGroup is int groupId)
        {
            query = query.Where(s => s.group == groupId);
        }
        else if (selectedDirection is int directionId)
        {
            var groupIds = allGroups
                .Where(g => g.direction == directionId)
                .Select(g => g.group_id)
                .ToHashSet();
            query = query.Where(s => s.group is int g && groupIds.Contains(g));
        }

        filteredStudents = query.OrderBy(s => s.last_name).ThenBy(s => s.first_name).AsQueryable();
        TotalCount = filteredStudents.Count();
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Фамилия", "Имя", "Отчество", "Группа", "Направление", "Дата рождения" }
        };
        foreach (var s in filteredStudents)
        {
            rows.Add(new[] { s.last_name, s.first_name, s.middle_name, GroupName(s.group), GroupDirectionName(s.group), s.birth_date.ToString("dd.MM.yyyy") });
        }
        return rows;
    }

    protected override bool MatchesSearch(Student s)
        => TextContains(
            s.last_name, s.first_name, s.middle_name,
            GroupName(s.group), GroupDirectionName(s.group));

    private string GroupName(int? id)
        => allGroups.FirstOrDefault(g => g.group_id == id)?.group_name ?? "—";

    private string GroupDirectionName(int? id)
    {
        var groupId = allGroups.FirstOrDefault(g => g.group_id == id)?.direction;
        return directions.FirstOrDefault(d => d.direction_id == groupId)?.direction_name ?? "—";
    }

    protected override string GetKey(Student s) => s.stud_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"students/details?stud_id={id}"),
            new("Изменить", $"students/edit?stud_id={id}"),
            new("Удалить", $"students/delete?stud_id={id}", Danger: true),
        };
    }
}