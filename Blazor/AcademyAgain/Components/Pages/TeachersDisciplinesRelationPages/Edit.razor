@page "/teachersdisciplinesrelations/edit"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование преподавателя и дисциплины</PageTitle>

<h1>Редактирование преподавателя и дисциплины</h1>

<hr />
@if (TeachersDisciplinesRelation is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TeachersDisciplinesRelation" OnValidSubmit="UpdateTeachersDisciplinesRelation" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="TeachersDisciplinesRelation.teacher" value="@TeachersDisciplinesRelation.teacher" />
                <input type="hidden" name="TeachersDisciplinesRelation.discipline" value="@TeachersDisciplinesRelation.discipline" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="teacher" class="form-label">Преподаватель:</label>
                    <select id="teacher" name="teacherId" class="form-select" aria-required="true">
                        <option value="">— выберите преподавателя —</option>
                        @foreach (var teacher in teachers.OrderBy(t => t.last_name))
                        {
                            <option value="@teacher.teacher_id" selected="@(SelectedTeacher == teacher.teacher_id)">@FullName(teacher)</option>
                        }
                    </select>
                    <ValidationMessage For="() => TeachersDisciplinesRelation.teacher" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="discipline" class="form-label">Дисциплина:</label>
                    <select id="discipline" name="disciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => TeachersDisciplinesRelation.discipline" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/teachersdisciplinesrelations">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int teacher { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromForm]
    private TeachersDisciplinesRelation? TeachersDisciplinesRelation { get; set; }

    [SupplyParameterFromForm]
    private string? teacherId { get; set; }

    [SupplyParameterFromForm]
    private string? disciplineId { get; set; }

    private List<Teacher> teachers = new();
    private List<Discipline> disciplines = new();
    private string? SaveError;

    private int? SelectedTeacher
        => int.TryParse(teacherId, out var value) ? value : TeachersDisciplinesRelation?.teacher;

    private int? SelectedDiscipline
        => int.TryParse(disciplineId, out var value) ? value : TeachersDisciplinesRelation?.discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        TeachersDisciplinesRelation ??= await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);
        teachers = await context.Teachers.ToListAsync();
        disciplines = await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync();

        if (TeachersDisciplinesRelation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTeachersDisciplinesRelation()
    {
        if (!int.TryParse(teacherId, out var teacherValue)
            || !int.TryParse(disciplineId, out var disciplineValue))
        {
            SaveError = "Выберите преподавателя и дисциплину.";
            return;
        }

        var originalTeacher = TeachersDisciplinesRelation!.teacher;
        var originalDiscipline = TeachersDisciplinesRelation.discipline;
        var keysChanged = originalTeacher != teacherValue || originalDiscipline != disciplineValue;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(r => r.teacher == originalTeacher && r.discipline == originalDiscipline);
            if (original is not null)
            {
                context.TeachersDisciplinesRelation.Remove(original);
                await context.SaveChangesAsync();
            }

            TeachersDisciplinesRelation.teacher = teacherValue;
            TeachersDisciplinesRelation.discipline = disciplineValue;
            context.TeachersDisciplinesRelation.Add(TeachersDisciplinesRelation);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(TeachersDisciplinesRelation).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!TeachersDisciplinesRelationExists(TeachersDisciplinesRelation.teacher, TeachersDisciplinesRelation.discipline))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/teachersdisciplinesrelations");
    }

    private bool TeachersDisciplinesRelationExists(int teacher, int discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.TeachersDisciplinesRelation.Any(e => e.teacher == teacher && e.discipline == discipline);
    }

    private static string FullName(Teacher teacher)
        => string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }.Where(n => !string.IsNullOrWhiteSpace(n)));
}