@page "/teachersdisciplinesrelations/edit"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>TeachersDisciplinesRelation</h2>
<hr />
@if (TeachersDisciplinesRelation is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TeachersDisciplinesRelation" OnValidSubmit="UpdateTeachersDisciplinesRelation" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="TeachersDisciplinesRelation.teacher" value="@TeachersDisciplinesRelation.teacher" />
                <input type="hidden" name="TeachersDisciplinesRelation.discipline" value="@TeachersDisciplinesRelation.discipline" />
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/teachersdisciplinesrelations">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int teacher { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromForm]
    private TeachersDisciplinesRelation? TeachersDisciplinesRelation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        TeachersDisciplinesRelation ??= await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

        if (TeachersDisciplinesRelation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTeachersDisciplinesRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(TeachersDisciplinesRelation!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TeachersDisciplinesRelationExists(TeachersDisciplinesRelation!.teacher, TeachersDisciplinesRelation.discipline))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/teachersdisciplinesrelations");
    }

    private bool TeachersDisciplinesRelationExists(int teacher, int discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.TeachersDisciplinesRelation.Any(e => e.teacher == teacher && e.discipline == discipline);
    }
}