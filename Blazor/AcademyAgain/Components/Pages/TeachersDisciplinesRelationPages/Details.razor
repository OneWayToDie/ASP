@page "/teachersdisciplinesrelations/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>РџРѕРґСЂРѕР±РЅРѕСЃС‚Рё: РїСЂРµРїРѕРґР°РІР°С‚РµР»СЊ Рё РґРёСЃС†РёРїР»РёРЅР°</PageTitle>

<h1>РџРѕРґСЂРѕР±РЅРѕСЃС‚Рё: РїСЂРµРїРѕРґР°РІР°С‚РµР»СЊ Рё РґРёСЃС†РёРїР»РёРЅР°</h1>

<hr />
@if (relation is null)
{
    <p><em>Р—Р°РіСЂСѓР·РєР°...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">РџСЂРµРїРѕРґР°РІР°С‚РµР»СЊ</dt>
        <dd class="col-sm-10">@TeacherName</dd>
        <dt class="col-sm-2">Р”РёСЃС†РёРїР»РёРЅР°</dt>
        <dd class="col-sm-10">@DisciplineName</dd>
    </dl>
    <div>
        <a href="@($"/teachersdisciplinesrelations/edit?teacher={relation.teacher}&discipline={relation.discipline}")">РР·РјРµРЅРёС‚СЊ</a> |
        <a href="@($"/teachersdisciplinesrelations")">РќР°Р·Р°Рґ Рє СЃРїРёСЃРєСѓ</a>
    </div>
}

@code {
    private TeachersDisciplinesRelation? relation;
    private string? TeacherName = "вЂ”";
    private string? DisciplineName = "вЂ”";

    [SupplyParameterFromQuery]
    private int teacher { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var teacherEntity = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == relation.teacher);
            TeacherName = teacherEntity is null ? "вЂ”" : FullName(teacherEntity);
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == relation.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "вЂ”";
        }
    }

    private static string FullName(Teacher teacher)
        => string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }.Where(n => !string.IsNullOrWhiteSpace(n)));
}