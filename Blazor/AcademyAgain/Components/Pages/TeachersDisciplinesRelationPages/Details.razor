@page "/teachersdisciplinesrelations/details"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Профиль: преподаватель и дисциплина</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Профиль: преподаватель и дисциплина</h1>

<hr />
@if (relation is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Преподаватель</dt>
        <dd class="col-sm-10"><a href="@($"/teachers/details?teacher_id={relation.teacher}")">@TeacherName</a></dd>
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={relation.discipline}")">@DisciplineName</a></dd>
    </dl>
    <div>
        <a href="@($"/teachersdisciplinesrelations/edit?teacher={relation.teacher}&discipline={relation.discipline}")">Изменить</a> |
        <a href="@($"/teachersdisciplinesrelations")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Преподаватели и дисциплины", "/teachersdisciplinesrelations"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private TeachersDisciplinesRelation? relation;
    private string? TeacherName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int teacher { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var teacherEntity = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == relation.teacher);
            TeacherName = teacherEntity is null ? "—" : FullName(teacherEntity);
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == relation.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private static string FullName(Teacher teacher)
        => string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }.Where(n => !string.IsNullOrWhiteSpace(n)));
}