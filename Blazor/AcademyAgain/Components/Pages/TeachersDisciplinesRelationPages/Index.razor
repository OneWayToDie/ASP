@page "/teachersdisciplinesrelations"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Преподаватели и дисциплины</PageTitle>

<div class="list-header">
    <h1>Преподаватели и дисциплины</h1>
    <a class="btn btn-primary" href="teachersdisciplinesrelations/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.TeachersDisciplinesRelation">
    <PropertyColumn Property="relation => relation.teacher" Title="Преподаватель" />
    <PropertyColumn Property="relation => relation.discipline" Title="Дисциплина" />

    <TemplateColumn Context="relation">
        <a href="@($"teachersdisciplinesrelations/edit?teacher={relation.teacher}&discipline={relation.discipline}")">Изменить</a> |
        <a href="@($"teachersdisciplinesrelations/details?teacher={relation.teacher}&discipline={relation.discipline}")">Подробно</a> |
        <a href="@($"teachersdisciplinesrelations/delete?teacher={relation.teacher}&discipline={relation.discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}