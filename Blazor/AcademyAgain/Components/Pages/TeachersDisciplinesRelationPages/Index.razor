@page "/teachersdisciplinesrelations"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<TeachersDisciplinesRelation>

<PageTitle>Преподаватели и дисциплины</PageTitle>

<div class="list-header">
    <h1>Преподаватели и дисциплины</h1>
    <a class="btn btn-primary" href="teachersdisciplinesrelations/create">Создать</a>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="relation => relation.teacher.ToString() + '_' + relation.discipline.ToString()">
    <TemplateColumn Title="Преподаватель" Sortable="true" SortBy="GridSort<TeachersDisciplinesRelation>.ByAscending(r => TeacherName(r.teacher))" Context="relation">
        <div class="row-key @RowClass(relation)" data-item-key="@GetKey(relation)">
            @TeacherName(relation.teacher)
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Дисциплина" Sortable="true" SortBy="GridSort<TeachersDisciplinesRelation>.ByAscending(r => DisciplineName(r.discipline))" Context="relation">
        @DisciplineName(relation.discipline)
    </TemplateColumn>
</QuickGrid>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private IQueryable<TeachersDisciplinesRelation> query = new List<TeachersDisciplinesRelation>().AsQueryable();
    private Dictionary<int, string> teacherNames = new();
    private Dictionary<int, string> disciplineNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        teacherNames = await context.Teachers.ToDictionaryAsync(t => t.teacher_id, t => FullName(t));
        disciplineNames = await context.Disciplines.ToDictionaryAsync(d => d.discipline_id, d => d.discipline_name ?? $"№{d.discipline_id}");
        query = (await context.TeachersDisciplinesRelation.ToListAsync()).AsQueryable();
    }

    private string TeacherName(int id)
        => teacherNames.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name) ? name : $"№{id}";

    private string DisciplineName(int id)
        => disciplineNames.TryGetValue(id, out var name) ? name : $"№{id}";

    private static string FullName(Teacher teacher)
        => string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }.Where(n => !string.IsNullOrWhiteSpace(n)));

    protected override string GetKey(TeachersDisciplinesRelation r) => $"{r.teacher}|{r.discipline}";

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var teacher) || !int.TryParse(parts[1], out var discipline))
            return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"teachersdisciplinesrelations/details?teacher={teacher}&discipline={discipline}"),
            new("Изменить", $"teachersdisciplinesrelations/edit?teacher={teacher}&discipline={discipline}"),
            new("Удалить", $"teachersdisciplinesrelations/delete?teacher={teacher}&discipline={discipline}", Danger: true),
        };
    }
}