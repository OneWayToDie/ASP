@page "/teachersdisciplinesrelations/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление преподавателя и дисциплины</PageTitle>

<h1>Удаление преподавателя и дисциплины</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту связь преподавателя и дисциплины?</p>
<div>
    <hr />
    @if (relation is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Преподаватель</dt>
            <dd class="col-sm-10">@TeacherName</dd>
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
        </dl>
        <EditForm method="post" Model="relation" OnValidSubmit="DeleteTeachersDisciplinesRelation" FormName="delete" Enhance>
            <input type="hidden" name="TeachersDisciplinesRelation.teacher" value="@relation.teacher" />
            <input type="hidden" name="TeachersDisciplinesRelation.discipline" value="@relation.discipline" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/teachersdisciplinesrelations">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private TeachersDisciplinesRelation? relation;
    private string? TeacherName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int teacher { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.TeachersDisciplinesRelation.FirstOrDefaultAsync(m => m.teacher == teacher && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var teacherEntity = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == relation.teacher);
            TeacherName = teacherEntity is null ? "—" : FullName(teacherEntity);
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == relation.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteTeachersDisciplinesRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.TeachersDisciplinesRelation.Remove(relation!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/teachersdisciplinesrelations");
    }

    private static string FullName(Teacher teacher)
        => string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }.Where(n => !string.IsNullOrWhiteSpace(n)));
}