@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Group</h2>
    <hr />
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">group_name</dt>
            <dd class="col-sm-10">@group.group_name</dd>
            <dt class="col-sm-2">direction</dt>
            <dd class="col-sm-10">@group.Direction.direction_Name</dd>
            <dt class="col-sm-2">learning_days</dt>
            <dd class="col-sm-10">@group.learning_days</dd>
            <dt class="col-sm-2">start_time</dt>
            <dd class="col-sm-10">@group.start_time</dd>
            <dt class="col-sm-2">start_date</dt>
            <dd class="col-sm-10">@group.start_date</dd>
        </dl>
        <div>
            <a href="@($"/groups/edit?group_id={group.group_Id}")">Edit</a> |
            <a href="@($"/groups")">Back to List</a>
        </div>
    }
</div>

@code {
    private Group? group;

    [SupplyParameterFromQuery]
    private int group_Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context
                             .Groups
                             .Include(g => g.Direction)
                             .FirstOrDefaultAsync(m => m.group_Id == group_Id);

        // group = await context.Groups.FirstOrDefaultAsync(m => m.group_Id == group_Id);

        if (group is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
