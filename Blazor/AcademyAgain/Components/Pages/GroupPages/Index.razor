@page "/groups"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Group>

<PageTitle>Группы</PageTitle>

<div class="list-header">
    <h1>Группы</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="groups" />
        <a class="btn btn-primary" href="groups/create">Создать</a>
    </div>
</div>

<div class="filter-bar">
    <label class="form-label mb-0">Направление</label>
    <select class="form-select" value="@selectedDirection" @onchange="OnDirectionChanged">
        <option value="">Все</option>
        @foreach (var dir in directions.OrderBy(d => d.direction_id))
        {
            <option value="@dir.direction_id">@dir.direction_name</option>
        }
    </select>
</div>

<QuickGrid Class="table context-table" Items="filteredGroups" ItemKey="g => g.group_id" Pagination="Pagination">
    <TemplateColumn Title="Название" Sortable="true" SortBy="GridSort<Group>.ByAscending(g => GroupName(g))" Context="g">
        <div class="row-key @RowClass(g)" data-item-key="@GetKey(g)">
            @GroupName(g)
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Направление" Sortable="true" SortBy="GridSort<Group>.ByAscending(g => DirectionName(g.direction))" Context="g">
        <a class="table-link" href="@($"/directions/details?direction_id={g.direction}")">@DirectionName(g.direction)</a>
    </TemplateColumn>
    <TemplateColumn Title="Дни недели" Sortable="true" SortBy="GridSort<Group>.ByAscending(g => Weekdays.ToDisplay(g.weekdays))" Context="g">
        @Weekdays.ToDisplay(g.weekdays)
    </TemplateColumn>
    <PropertyColumn Property="g => g.start_time" Title="Время начала" Sortable="true" />
    <PropertyColumn Property="g => g.start_date" Title="Дата начала" Sortable="true" />
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Direction> directions = new();
    private List<Group> allGroups = new();
    private IQueryable<Group> filteredGroups = new List<Group>().AsQueryable();
    private int? selectedDirection;

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        directions = await context.Directions.ToListAsync();
        allGroups = await context.Groups.ToListAsync();
        ApplyFilter();
    }

    private async Task OnDirectionChanged(ChangeEventArgs e)
    {
        selectedDirection = int.TryParse(e.Value?.ToString(), out var value) ? value : null;
        ApplyFilter();
        await ResetPaginationAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    private void ApplyFilter()
    {
        filteredGroups = ApplySearch(allGroups)
            .Where(g => selectedDirection is null || g.direction == selectedDirection)
            .OrderBy(g => g.group_id)
            .AsQueryable();
        TotalCount = filteredGroups.Count();
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Название", "Направление", "Дни недели", "Время начала", "Дата начала" }
        };
        foreach (var g in filteredGroups)
        {
            rows.Add(new[] { GroupName(g), DirectionName(g.direction), Weekdays.ToDisplay(g.weekdays), g.start_time?.ToString(), g.start_date?.ToString("dd.MM.yyyy") });
        }
        return rows;
    }

    protected override bool MatchesSearch(Group g)
        => TextContains(GroupName(g), DirectionName(g.direction), Weekdays.ToDisplay(g.weekdays));

    private string GroupName(Group g) => g.group_name ?? $"№{g.group_id}";

    private string DirectionName(int? id)
        => directions.FirstOrDefault(d => d.direction_id == id)?.direction_name ?? "—";

    protected override string GetKey(Group g) => g.group_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"groups/details?group_id={id}"),
            new("Изменить", $"groups/edit?group_id={id}"),
            new("Удалить", $"groups/delete?group_id={id}", Danger: true),
        };
    }
}