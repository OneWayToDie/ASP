@page "/salarys"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Salary>

<PageTitle>Зарплаты</PageTitle>

<div class="list-header">
    <h1>Зарплаты</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="salarys" />
        <a class="btn btn-primary" href="salarys/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="salary => salary.payment_id" Pagination="Pagination">
    <PropertyColumn Property="salary => salary.payment_id" Title="№ платежа" Sortable="true" />
    <TemplateColumn Title="Преподаватель" Sortable="true" SortBy="GridSort<Salary>.ByAscending(s => TeacherName(s.teacher))" Context="salary">
        <div class="row-key @RowClass(salary)" data-item-key="@GetKey(salary)">
            <a class="table-link" href="@($"/teachers/details?teacher_id={salary.teacher}")">@TeacherName(salary.teacher)</a>
        </div>
    </TemplateColumn>
    <PropertyColumn Property="salary => salary.accrued" Title="Начислено" Sortable="true" />
    <TemplateColumn Title="Выплачено" Sortable="true" SortBy="GridSort<Salary>.ByAscending(s => s.received)" Context="salary">
        @(salary.received ? "да" : "нет")
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Salary> allItems = new();
    private IQueryable<Salary> query = new List<Salary>().AsQueryable();
    private List<Salary> filtered = new();
    private Dictionary<int, string> teacherNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        teacherNames = await context.Teachers.ToDictionaryAsync(
            t => t.teacher_id,
            t => $"{t.last_name} {t.first_name} {t.middle_name}".Trim());
        allItems = await context.Salary.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(allItems).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]>
        {
            new[] { "№ платежа", "Преподаватель", "Начислено", "Выплачено" }
        };
        foreach (var s in filtered)
        {
            rows.Add(new[] { s.payment_id.ToString(), TeacherName(s.teacher), s.accrued.ToString(), s.received ? "да" : "нет" });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Salary salary)
        => TextContains(
            TeacherName(salary.teacher),
            salary.payment_id.ToString(),
            salary.received ? "да" : "нет");

    private string TeacherName(int id)
        => teacherNames.TryGetValue(id, out var name) ? name : $"№{id}";

    protected override string GetKey(Salary s) => s.payment_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!long.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"salarys/details?payment_id={id}"),
            new("Изменить", $"salarys/edit?payment_id={id}"),
            new("Удалить", $"salarys/delete?payment_id={id}", Danger: true),
        };
    }
}