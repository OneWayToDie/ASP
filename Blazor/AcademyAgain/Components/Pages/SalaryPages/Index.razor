@page "/salarys"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Зарплаты</PageTitle>

<div class="list-header">
    <h1>Зарплаты</h1>
    <a class="btn btn-primary" href="salarys/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Salary">
    <PropertyColumn Property="salary => salary.teacher" Title="Преподаватель" />
    <PropertyColumn Property="salary => salary.accrued" Title="Начислено" />
    <PropertyColumn Property="salary => salary.received" Title="Выплачено" />

    <TemplateColumn Context="salary">
        <a href="@($"salarys/edit?payment_id={salary.payment_id}")">Изменить</a> |
        <a href="@($"salarys/details?payment_id={salary.payment_id}")">Подробно</a> |
        <a href="@($"salarys/delete?payment_id={salary.payment_id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
