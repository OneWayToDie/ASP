@page "/salarys/edit"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование зарплаты</PageTitle>

<h1>Редактирование зарплаты</h1>

<hr />
@if (Salary is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Salary" OnValidSubmit="UpdateSalary" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="Salary.payment_id" value="@Salary.payment_id" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="teacher" class="form-label">Преподаватель:</label>
                    <select id="teacher" name="teacher" class="form-select" aria-required="true">
                        <option value="">— выберите преподавателя —</option>
                        @foreach (var teacher in teachers.OrderBy(t => t.last_name).ThenBy(t => t.first_name))
                        {
                            <option value="@teacher.teacher_id" selected="@(SelectedTeacher == teacher.teacher_id)">@FullName(teacher)</option>
                        }
                    </select>
                    <ValidationMessage For="() => Salary.teacher" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="accrued" class="form-label">Начислено:</label>
                    <InputNumber id="accrued" @bind-Value="Salary.accrued" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Salary.accrued" class="text-danger" />
                </div>
                <div class="mb-3 form-check">
                    <input id="received" type="checkbox" name="received" value="true" checked="@(received == "true")" class="form-check-input" />
                    <label for="received" class="form-check-label">Выплачено</label>
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/salarys">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private long payment_id { get; set; }

    [SupplyParameterFromForm]
    private Salary? Salary { get; set; }

    [SupplyParameterFromForm]
    private string? teacher { get; set; }

    [SupplyParameterFromForm]
    private string? received { get; set; }

    private List<Teacher> teachers = new();
    private string? SaveError;

    private int? SelectedTeacher
        => int.TryParse(teacher, out var value) ? value : Salary?.teacher;

    private static string FullName(Teacher t)
        => $"{t.last_name} {t.first_name} {t.middle_name}".Trim();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Salary ??= await context.Salary.FirstOrDefaultAsync(m => m.payment_id == payment_id);
        teachers = await context.Teachers.OrderBy(t => t.last_name).ThenBy(t => t.first_name).ToListAsync();
        received ??= (Salary?.received == true ? "true" : null);

        if (Salary is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSalary()
    {
        if (!int.TryParse(teacher, out var teacherId))
        {
            SaveError = "Выберите преподавателя.";
            return;
        }

        Salary!.teacher = teacherId;
        Salary.received = received == "true";

        using var context = DbFactory.CreateDbContext();
        context.Attach(Salary!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SalaryExists(Salary!.payment_id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/salarys");
    }

    private bool SalaryExists(long payment_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Salary.Any(e => e.payment_id == payment_id);
    }
}