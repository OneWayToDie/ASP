@page "/salarys/details"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Зарплата №@(salary?.payment_id)</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Зарплата №@(salary?.payment_id)</h1>

<hr />
@if (salary is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">№ платежа</dt>
        <dd class="col-sm-10">@salary.payment_id</dd>
        <dt class="col-sm-2">Преподаватель</dt>
        <dd class="col-sm-10"><a href="@($"/teachers/details?teacher_id={salary.teacher}")">@TeacherName</a></dd>
        <dt class="col-sm-2">Начислено</dt>
        <dd class="col-sm-10">@salary.accrued</dd>
        <dt class="col-sm-2">Выплачено</dt>
        <dd class="col-sm-10">@(salary.received ? "да" : "нет")</dd>
    </dl>
    <div>
        <a href="@($"/salarys/edit?payment_id={salary.payment_id}")">Изменить</a> |
        <a href="@($"/salarys")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Зарплаты", "/salarys"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private Salary? salary;
    private string? TeacherName = "—";

    [SupplyParameterFromQuery]
    private long payment_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        salary = await context.Salary.FirstOrDefaultAsync(m => m.payment_id == payment_id);

        if (salary is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var teacher = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == salary.teacher);
            TeacherName = teacher is null ? "—" : $"{teacher.last_name} {teacher.first_name} {teacher.middle_name}".Trim();
        }
    }
}