@page "/salarys/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление зарплаты</PageTitle>

<h1>Удаление зарплаты</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту зарплату?</p>
<div>
    <hr />
    @if (salary is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">№ платежа</dt>
            <dd class="col-sm-10">@salary.payment_id</dd>
            <dt class="col-sm-2">Преподаватель</dt>
            <dd class="col-sm-10">@TeacherName</dd>
            <dt class="col-sm-2">Начислено</dt>
            <dd class="col-sm-10">@salary.accrued</dd>
            <dt class="col-sm-2">Выплачено</dt>
            <dd class="col-sm-10">@(salary.received ? "да" : "нет")</dd>
        </dl>
        <EditForm method="post" Model="salary" OnValidSubmit="DeleteSalary" FormName="delete" Enhance>
            <input type="hidden" name="Salary.payment_id" value="@salary.payment_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/salarys">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Salary? salary;
    private string? TeacherName = "—";

    [SupplyParameterFromQuery]
    private long payment_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        salary = await context.Salary.FirstOrDefaultAsync(m => m.payment_id == payment_id);

        if (salary is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var teacher = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == salary.teacher);
            TeacherName = teacher is null ? "—" : $"{teacher.last_name} {teacher.first_name} {teacher.middle_name}".Trim();
        }
    }

    private async Task DeleteSalary()
    {
        using var context = DbFactory.CreateDbContext();
        context.Salary.Remove(salary!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/salarys");
    }
}