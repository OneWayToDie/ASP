@page "/salarys/create"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using System.Data
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление зарплаты</PageTitle>

<h1>Добавление зарплаты</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Salary" OnValidSubmit="AddSalary" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            @if (!string.IsNullOrEmpty(SaveError))
            {
                <div class="alert alert-danger" role="alert">@SaveError</div>
            }
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="teacher" class="form-label">Преподаватель:</label>
                <select id="teacher" name="teacher" class="form-select" aria-required="true">
                    <option value="">— выберите преподавателя —</option>
                    @foreach (var teacher in teachers.OrderBy(t => t.last_name).ThenBy(t => t.first_name))
                    {
                        <option value="@teacher.teacher_id" selected="@(Salary.teacher == teacher.teacher_id)">@FullName(teacher)</option>
                    }
                </select>
                <ValidationMessage For="() => Salary.teacher" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="accrued" class="form-label">Начислено:</label>
                <InputNumber id="accrued" @bind-Value="Salary.accrued" class="form-control" aria-required="true"/>
                <ValidationMessage For="() => Salary.accrued" class="text-danger" />
            </div>
            <div class="mb-3 form-check">
                <input id="received" type="checkbox" name="received" value="true" checked="@(received == "true")" class="form-check-input" />
                <label for="received" class="form-check-label">Выплачено</label>
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/salarys">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Salary Salary { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? teacher { get; set; }

    [SupplyParameterFromForm]
    private string? received { get; set; }

    private List<Teacher> teachers = new();
    private string? SaveError;

    protected override async Task OnInitializedAsync()
    {
        Salary ??= new();
        await using var context = DbFactory.CreateDbContext();
        teachers = await context.Teachers.OrderBy(t => t.last_name).ThenBy(t => t.first_name).ToListAsync();
    }

    private static string FullName(Teacher t)
        => $"{t.last_name} {t.first_name} {t.middle_name}".Trim();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSalary()
    {
        if (!int.TryParse(teacher, out var teacherId))
        {
            SaveError = "Выберите преподавателя.";
            return;
        }

        Salary.teacher = teacherId;
        Salary.received = received == "true";

        using var context = DbFactory.CreateDbContext();
        await using var transaction = await context.Database.BeginTransactionAsync(IsolationLevel.Serializable);
        Salary.payment_id = context.Salary.Any()
            ? context.Salary.Max(s => s.payment_id) + 1
            : 1;
        context.Salary.Add(Salary);
        await context.SaveChangesAsync();
        await transaction.CommitAsync();
        NavigationManager.NavigateTo("/salarys");
    }
}