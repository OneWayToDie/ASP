@page "/daysoffs/edit"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование выходного дня</PageTitle>

<h1>Редактирование выходного дня</h1>

<hr />
@if (DaysOFF is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="DaysOFF" OnValidSubmit="UpdateDaysOFF" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="DaysOFF.date" value="@DaysOFF.date" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="date" class="form-label">Дата:</label>
                    <input id="date" class="form-control" value="@DaysOFF.date.ToString("yyyy-MM-dd")" readonly />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="holiday" class="form-label">Праздник:</label>
                    <select id="holiday" name="holiday" class="form-select" aria-required="true">
                        <option value="">— выберите праздник —</option>
                        @foreach (var holiday in holidays.OrderBy(h => h.holiday_name))
                        {
                            <option value="@holiday.holiday_id" selected="@(SelectedHoliday == holiday.holiday_id)">@holiday.holiday_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => DaysOFF.holiday" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/daysoffs">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private DateTime date { get; set; }

    [SupplyParameterFromForm]
    private DaysOFF? DaysOFF { get; set; }

    [SupplyParameterFromForm]
    private string? holiday { get; set; }

    private List<Holiday> holidays = new();
    private string? SaveError;

    private int? SelectedHoliday
        => int.TryParse(holiday, out var value) ? value : DaysOFF?.holiday;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        DaysOFF ??= await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);
        holidays = await context.Holidays.OrderBy(h => h.holiday_name).ToListAsync();

        if (DaysOFF is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDaysOFF()
    {
        if (!int.TryParse(holiday, out var holidayId))
        {
            SaveError = "Выберите праздник.";
            return;
        }

        DaysOFF!.holiday = holidayId;

        using var context = DbFactory.CreateDbContext();
        context.Attach(DaysOFF).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DaysOFFExists(DaysOFF.date))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/daysoffs");
    }

    private bool DaysOFFExists(DateTime date)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DaysOFF.Any(e => e.date == date);
    }
}