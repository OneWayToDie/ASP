@page "/daysoffs/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DaysOFF</h2>
    <hr />
    @if (daysoff is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">holiday</dt>
            <dd class="col-sm-10">@daysoff.holiday</dd>
        </dl>
        <EditForm method="post" Model="daysoff" OnValidSubmit="DeleteDaysOFF" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(daysoff is null)">Delete</button> |
            <a href="/daysoffs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DaysOFF? daysoff;

    [SupplyParameterFromQuery]
    private System.DateTime date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        daysoff = await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (daysoff is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDaysOFF()
    {
        using var context = DbFactory.CreateDbContext();
        context.DaysOFF.Remove(daysoff!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/daysoffs");
    }
}
