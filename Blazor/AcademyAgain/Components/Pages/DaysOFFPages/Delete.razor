@page "/daysoffs/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление выходного дня</PageTitle>

<h1>Удаление выходного дня</h1>

<p class="text-danger">Вы уверены, что хотите удалить этот выходной день?</p>
<div>
    <hr />
    @if (daysoff is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Дата</dt>
            <dd class="col-sm-10">@daysoff.date.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-2">Праздник</dt>
            <dd class="col-sm-10">@HolidayName</dd>
        </dl>
        <EditForm method="post" Model="daysoff" OnValidSubmit="DeleteDaysOFF" FormName="delete" Enhance>
            <input type="hidden" name="DaysOFF.date" value="@daysoff.date" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/daysoffs">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private DaysOFF? daysoff;
    private string? HolidayName = "—";

    [SupplyParameterFromQuery]
    private DateTime date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        daysoff = await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (daysoff is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            HolidayName = await context.Holidays
                .Where(h => h.holiday_id == daysoff.holiday)
                .Select(h => h.holiday_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteDaysOFF()
    {
        using var context = DbFactory.CreateDbContext();
        context.DaysOFF.Remove(daysoff!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/daysoffs");
    }
}