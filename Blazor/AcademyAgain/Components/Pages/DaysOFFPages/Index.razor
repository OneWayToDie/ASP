@page "/daysoffs"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<DaysOFF>

<PageTitle>Выходные дни</PageTitle>

<div class="list-header">
    <h1>Выходные дни</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="daysoffs" />
        <a class="btn btn-primary" href="daysoffs/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="daysoff => daysoff.date" Pagination="Pagination">
    <TemplateColumn Title="Дата" Sortable="true" SortBy="GridSort<DaysOFF>.ByAscending(d => d.date)" Context="daysoff">
        <div class="row-key @RowClass(daysoff)" data-item-key="@GetKey(daysoff)">
            @daysoff.date.ToString("dd.MM.yyyy")
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Праздник" Sortable="true" SortBy="GridSort<DaysOFF>.ByAscending(d => HolidayName(d.holiday))" Context="daysoff">
        @HolidayName(daysoff.holiday)
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<DaysOFF> allItems = new();
    private IQueryable<DaysOFF> query = new List<DaysOFF>().AsQueryable();
    private Dictionary<int, string> holidayNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        holidayNames = await context.Holidays.ToDictionaryAsync(h => h.holiday_id, h => h.holiday_name);
        allItems = await context.DaysOFF.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        query = ApplySearch(allItems).AsQueryable();
        TotalCount = ApplySearch(allItems).Count();
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]>
        {
            new[] { "Дата", "Праздник" }
        };
        foreach (var d in ApplySearch(allItems))
        {
            rows.Add(new[] { d.date.ToString("dd.MM.yyyy"), HolidayName(d.holiday) });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(DaysOFF daysoff)
        => TextContains(daysoff.date.ToString("dd.MM.yyyy"), daysoff.date.ToString("yyyy-MM-dd"), HolidayName(daysoff.holiday));

    private string HolidayName(int id)
        => holidayNames.TryGetValue(id, out var name) ? name : $"№{id}";

    protected override string GetKey(DaysOFF d) => d.date.ToString("yyyy-MM-dd");

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!DateTime.TryParse(key, out var date)) return new List<RowMenuItem>();
        var formatted = date.ToString("yyyy-MM-dd");
        return new List<RowMenuItem>
        {
            new("Профиль", $"daysoffs/details?date={formatted}"),
            new("Изменить", $"daysoffs/edit?date={formatted}"),
            new("Удалить", $"daysoffs/delete?date={formatted}", Danger: true),
        };
    }
}