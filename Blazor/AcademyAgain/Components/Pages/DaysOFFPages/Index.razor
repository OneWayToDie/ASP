@page "/daysoffs"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Выходные дни</PageTitle>

<div class="list-header">
    <h1>Выходные дни</h1>
    <a class="btn btn-primary" href="daysoffs/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.DaysOFF">
    <PropertyColumn Property="daysoff => daysoff.date" Title="Дата" />
    <PropertyColumn Property="daysoff => daysoff.holiday" Title="Праздник" />

    <TemplateColumn Context="daysoff">
        <a href="@($"daysoffs/edit?date={daysoff.date}")">Изменить</a> |
        <a href="@($"daysoffs/details?date={daysoff.date}")">Подробно</a> |
        <a href="@($"daysoffs/delete?date={daysoff.date}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
