@page "/daysoffs/details"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Выходной день: @(daysoff?.date.ToString("dd.MM.yyyy"))</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Выходной день: @(daysoff?.date.ToString("dd.MM.yyyy"))</h1>

<hr />
@if (daysoff is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Дата</dt>
        <dd class="col-sm-10">@daysoff.date.ToString("dd.MM.yyyy")</dd>
        <dt class="col-sm-2">Праздник</dt>
        <dd class="col-sm-10">@HolidayName</dd>
    </dl>
    <div>
        <a href="@($"/daysoffs/edit?date={daysoff.date:yyyy-MM-dd}")">Изменить</a> |
        <a href="@($"/daysoffs")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Выходные дни", "/daysoffs"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private DaysOFF? daysoff;
    private string? HolidayName = "—";

    [SupplyParameterFromQuery]
    private DateTime date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        daysoff = await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (daysoff is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            HolidayName = await context.Holidays
                .Where(h => h.holiday_id == daysoff.holiday)
                .Select(h => h.holiday_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}