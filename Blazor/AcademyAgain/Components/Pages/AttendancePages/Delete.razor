@page "/attendances/delete"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление посещаемости</PageTitle>

<h1>Удаление посещаемости</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту запись посещаемости?</p>
<div>
    <hr />
    @if (attendance is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Студент</dt>
            <dd class="col-sm-10">@StudentName</dd>
            <dt class="col-sm-2">Занятие</dt>
            <dd class="col-sm-10">@LessonName</dd>
            <dt class="col-sm-2">Присутствовал</dt>
            <dd class="col-sm-10">@(attendance.present ? "Да" : "Нет")</dd>
        </dl>
        <EditForm method="post" Model="attendance" OnValidSubmit="DeleteAttendance" FormName="delete" Enhance>
            <input type="hidden" name="Attendance.student" value="@attendance.student" />
            <input type="hidden" name="Attendance.lesson" value="@attendance.lesson" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/attendances">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Attendance? attendance;
    private string? StudentName = "—";
    private string? LessonName = "—";

    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        attendance = await context.Attendance.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);

        if (attendance is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var stud = await context.Students.FirstOrDefaultAsync(s => s.stud_id == attendance.student);
            if (stud is not null)
            {
                StudentName = !string.IsNullOrWhiteSpace(stud.middle_name)
                    ? $"{stud.last_name} {stud.first_name} {stud.middle_name}"
                    : $"{stud.last_name} {stud.first_name}";
            }

            var sched = await context.Schedule.FirstOrDefaultAsync(s => s.lesson_id == attendance.lesson);
            if (sched is not null)
            {
                var groupName = await context.Groups
                    .Where(g => g.group_id == sched.group)
                    .Select(g => g.group_name)
                    .FirstOrDefaultAsync() ?? $"№{sched.group}";
                LessonName = sched.date.HasValue
                    ? $"{sched.lesson_id} · {groupName} · {sched.date:d}"
                    : $"{sched.lesson_id} · {groupName}";
            }
            else
            {
                LessonName = $"№{attendance.lesson}";
            }
        }
    }

    private async Task DeleteAttendance()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attendance.Remove(attendance!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/attendances");
    }
}