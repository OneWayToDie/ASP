@page "/attendances/edit"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование посещаемости</PageTitle>

<h1>Редактирование посещаемости</h1>

<hr />
@if (Attendance is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Attendance" OnValidSubmit="UpdateAttendance" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="Attendance.student" value="@Attendance.student" />
                <input type="hidden" name="Attendance.lesson" value="@Attendance.lesson" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="student" class="form-label">Студент:</label>
                    <select id="student" name="studentSel" class="form-select" aria-required="true">
                        <option value="">— выберите студента —</option>
                        @foreach (var student in students)
                        {
                            <option value="@student.Key" selected="@(SelectedStudent == student.Key)">@student.Value</option>
                        }
                    </select>
                    <ValidationMessage For="() => Attendance.student" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="lesson" class="form-label">Занятие:</label>
                    <select id="lesson" name="lessonSel" class="form-select" aria-required="true">
                        <option value="">— выберите занятие —</option>
                        @foreach (var lesson in lessonNames)
                        {
                            <option value="@lesson.Key" selected="@(SelectedLesson == lesson.Key)">@lesson.Value</option>
                        }
                    </select>
                    <ValidationMessage For="() => Attendance.lesson" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="present" class="form-label">Присутствовал:</label>
                    <InputCheckbox id="present" @bind-Value="Attendance.present" class="form-check-input" aria-required="true"/>
                    <ValidationMessage For="() => Attendance.present" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/attendances">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    [SupplyParameterFromForm]
    private Attendance? Attendance { get; set; }

    [SupplyParameterFromForm]
    private string? studentSel { get; set; }

    [SupplyParameterFromForm]
    private string? lessonSel { get; set; }

    private List<KeyValuePair<int, string>> students = new();
    private List<KeyValuePair<long, string>> lessonNames = new();
    private string? SaveError;

    private int SelectedStudent
        => int.TryParse(studentSel, out var value) ? value : Attendance?.student ?? 0;

    private long SelectedLesson
        => long.TryParse(lessonSel, out var value) ? value : Attendance?.lesson ?? 0;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Attendance ??= await context.Attendance.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);
        students = (await context.Students.OrderBy(s => s.last_name).ToListAsync())
            .Select(s => new KeyValuePair<int, string>(s.stud_id,
                !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}"))
            .ToList();
        var groupNames = (await context.Groups.ToListAsync())
            .ToDictionary(g => g.group_id, g => g.group_name ?? "");
        lessonNames = (await context.Schedule.OrderBy(s => s.lesson_id).ToListAsync())
            .Select(s =>
            {
                var groupName = groupNames.TryGetValue(s.group, out var name) ? name : $"№{s.group}";
                return new KeyValuePair<long, string>(s.lesson_id, s.date.HasValue
                    ? $"{s.lesson_id} · {groupName} · {s.date:d}"
                    : $"{s.lesson_id} · {groupName}");
            })
            .ToList();

        if (Attendance is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateAttendance()
    {
        if (!int.TryParse(studentSel, out var studentId) || !long.TryParse(lessonSel, out var lessonId))
        {
            SaveError = "Выберите студента и занятие.";
            return;
        }

        var originalStudent = Attendance!.student;
        var originalLesson = Attendance.lesson;
        var keysChanged = originalStudent != studentId || originalLesson != lessonId;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.Attendance.FirstOrDefaultAsync(a => a.student == originalStudent && a.lesson == originalLesson);
            if (original is not null)
            {
                context.Attendance.Remove(original);
                await context.SaveChangesAsync();
            }

            Attendance.student = studentId;
            Attendance.lesson = lessonId;
            context.Attendance.Add(Attendance);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(Attendance).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!AttendanceExists(Attendance.student, Attendance.lesson))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/attendances");
    }

    private bool AttendanceExists(int student, long lesson)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Attendance.Any(e => e.student == student && e.lesson == lesson);
    }
}