@page "/attendances"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Посещаемость</PageTitle>

<div class="list-header">
    <h1>Посещаемость</h1>
    <a class="btn btn-primary" href="attendances/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Attendance">
    <PropertyColumn Property="att => att.student" Title="Студент" />
    <PropertyColumn Property="att => att.lesson" Title="Занятие" />
    <PropertyColumn Property="att => att.present" Title="Присутствовал" />

    <TemplateColumn Context="att">
        <a href="@($"attendances/edit?student={att.student}&lesson={att.lesson}")">Изменить</a> |
        <a href="@($"attendances/details?student={att.student}&lesson={att.lesson}")">Подробно</a> |
        <a href="@($"attendances/delete?student={att.student}&lesson={att.lesson}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}