@page "/database/backup"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Резервное копирование</PageTitle>

<h1>Резервное копирование базы данных</h1>

<hr />
<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">Создать резервную копию</div>
            <div class="card-body">
                <p class="text-secondary small">Скачает текущее содержимое базы данных в виде файла.</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="DownloadSqlAsync" disabled="@busy">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M2.5 11.5v2h11v-2"/></svg>
                        Скачать SQL
                    </button>
                    <button class="btn btn-primary" @onclick="DownloadJsonAsync" disabled="@busy">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5.5C1 5.5 1 7 2.2 7 1 7 1 8.5 2 8.5M6 5.5C7 5.5 7 7 5.8 7 7 7 7 8.5 6 8.5M9.5 3.5l1 9"/><path d="M10.5 4.5 12 3.2c.9-.9 2.6-.4 2.7 1 .1 1.7-1 3.3-2.7 5.8-1.7 2.5-2.8 4.1-2.7 5.8.1 1.4 1.8 1.9 2.7.9"/></svg>
                        Скачать JSON
                    </button>
                </div>
                @if (busy)
                {
                    <div class="mt-3 text-muted small">Формирую копию…</div>
                }
                @if (exportError != null)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@exportError</div>
                }
                @if (exportInfo != null)
                {
                    <div class="alert alert-success mt-3 mb-0" role="alert">@exportInfo</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header text-danger">Восстановить данные</div>
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <strong>Внимание!</strong> Восстановление полностью перезапишет все данные в базе.
                    Отменить это действие невозможно. Перед восстановлением рекомендуется создать резервную копию.
                </div>
                <div class="mb-3">
                    <label class="form-label">Файл резервной копии (.sql или .json):</label>
                    <InputFile OnChange="LoadFile" accept=".sql,.json" class="form-control" disabled="@busy" />
                    @if (fileName != null)
                    {
                        <div class="form-text">Выбран: @fileName</div>
                    }
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="confirmed" />
                    <label class="form-check-label" for="confirmed">
                        Я понимаю, что данные будут перезаписаны, и это действие необратимо.
                    </label>
                </div>
                <button class="btn btn-danger" @onclick="RestoreAsync"
                        disabled="@(fileData is null || !confirmed || busy)">
                    Восстановить
                </button>
                @if (restoreError != null)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@restoreError</div>
                }
                @if (restoreInfo != null)
                {
                    <div class="alert alert-success mt-3 mb-0" role="alert">@restoreInfo</div>
                }
            </div>
        </div>
    </div>
</div>

<div>
    <a href="">← На главную</a>
</div>

@code {
    private const long MaxFileSize = 50 * 1024 * 1024;

    private byte[]? fileData;
    private string? fileName;
    private bool confirmed;
    private bool busy;
    private string? exportError;
    private string? exportInfo;
    private string? restoreError;
    private string? restoreInfo;

    private Task DownloadSqlAsync() => DownloadAsync("sql");
    private Task DownloadJsonAsync() => DownloadAsync("json");

    private async Task DownloadAsync(string kind)
    {
        busy = true;
        exportError = null;
        exportInfo = null;
        restoreError = null;
        restoreInfo = null;
        await Task.Yield();
        try
        {
            await using var context = DbFactory.CreateDbContext();
            var dto = await BackupExport.ReadBackupAsync(context);

            string content;
            string ext;
            if (kind == "json")
            {
                content = JsonSerializer.Serialize(dto, JsonOptions);
                ext = "json";
            }
            else
            {
                content = BackupExport.BuildSql(dto);
                ext = "sql";
            }

            var stamp = DateTime.Now.ToString("yyyy-MM-dd_HHmm");
            await JS.InvokeVoidAsync("downloadTextFile", $"academy-backup_{stamp}.{ext}", content);
            exportInfo = "Копия сформирована и скачана.";
        }
        catch (Exception ex)
        {
            exportError = "Не удалось создать копию: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        fileData = null;
        fileName = null;
        confirmed = false;
        restoreError = null;
        restoreInfo = null;

        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxFileSize)
        {
            restoreError = "Файл слишком большой (лимит 50 МБ).";
            return;
        }

        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: MaxFileSize).CopyToAsync(ms);
        fileData = ms.ToArray();
        fileName = file.Name;
    }

    private async Task RestoreAsync()
    {
        if (fileData is null) return;

        busy = true;
        restoreError = null;
        restoreInfo = null;
        exportError = null;
        exportInfo = null;
        await Task.Yield();
        try
        {
            var isJson = fileName?.EndsWith(".json", StringComparison.OrdinalIgnoreCase) ?? false;
            await using var context = DbFactory.CreateDbContext();

            if (isJson)
            {
                var dto = JsonSerializer.Deserialize<BackupExport.BackupDto>(GetText())!;
                await BackupExport.RestoreJsonAsync(context, dto);
            }
            else
            {
                var script = GetText();
                await BackupExport.RestoreSqlAsync(context, script);
            }

            restoreInfo = "Данные восстановлены.";
            fileData = null;
            fileName = null;
            confirmed = false;
        }
        catch (Exception ex)
        {
            restoreError = "Ошибка восстановления: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private string GetText() => Encoding.UTF8.GetString(fileData!).TrimStart('\uFEFF');

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
}