@page "/holidays/edit"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование праздника</PageTitle>

<h1>Редактирование праздника</h1>

<hr />
@if (Holiday is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Holiday" OnValidSubmit="UpdateHoliday" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Holiday.holiday_id" value="@Holiday.holiday_id" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="holiday_name" class="form-label">Название:</label>
                    <InputText id="holiday_name" @bind-Value="Holiday.holiday_name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Holiday.holiday_name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="duration" class="form-label">Длительность:</label>
                    <InputNumber id="duration" @bind-Value="Holiday.duration" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Holiday.duration" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="month" class="form-label">Месяц:</label>
                    <select id="month" name="month" class="form-select">
                        <option value="">— не выбран —</option>
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(SelectedMonth == m)">@m</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="day" class="form-label">День:</label>
                    <InputNumber id="day" @bind-Value="Holiday.day" class="form-control" />
                    <ValidationMessage For="() => Holiday.day" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/holidays">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int holiday_id { get; set; }

    [SupplyParameterFromForm]
    private Holiday? Holiday { get; set; }

    [SupplyParameterFromForm]
    private string? month { get; set; }

    private int? SelectedMonth
        => int.TryParse(month, out var value) ? value : Holiday?.month;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Holiday ??= await context.Holidays.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

        if (Holiday is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateHoliday()
    {
        Holiday!.month = int.TryParse(month, out var m) ? m : null;

        using var context = DbFactory.CreateDbContext();
        context.Attach(Holiday).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!HolidayExists(Holiday!.holiday_id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/holidays");
    }

    private bool HolidayExists(int holiday_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Holidays.Any(e => e.holiday_id == holiday_id);
    }
}