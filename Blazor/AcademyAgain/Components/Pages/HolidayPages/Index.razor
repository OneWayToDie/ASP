@page "/holidays"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Праздники</PageTitle>

<div class="list-header">
    <h1>Праздники</h1>
    <a class="btn btn-primary" href="holidays/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Holidays">
    <PropertyColumn Property="holiday => holiday.holiday_name" Title="Название" />
    <PropertyColumn Property="holiday => holiday.duration" Title="Длительность" />
    <PropertyColumn Property="holiday => holiday.month" Title="Месяц" />
    <PropertyColumn Property="holiday => holiday.day" Title="День" />

    <TemplateColumn Context="holiday">
        <a href="@($"holidays/edit?holiday_id={holiday.holiday_id}")">Изменить</a> |
        <a href="@($"holidays/details?holiday_id={holiday.holiday_id}")">Подробно</a> |
        <a href="@($"holidays/delete?holiday_id={holiday.holiday_id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
