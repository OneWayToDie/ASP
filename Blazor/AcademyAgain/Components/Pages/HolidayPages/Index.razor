@page "/holidays"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Holiday>

<PageTitle>Праздники</PageTitle>

<div class="list-header">
    <h1>Праздники</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="holidays" />
        <a class="btn btn-primary" href="holidays/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="holiday => holiday.holiday_id" Pagination="Pagination">
    <TemplateColumn Title="Название" Sortable="true" SortBy="GridSort<Holiday>.ByAscending(h => h.holiday_name)" Context="holiday">
        <div class="row-key @RowClass(holiday)" data-item-key="@GetKey(holiday)">
            @HolidayName(holiday)
        </div>
    </TemplateColumn>
    <PropertyColumn Property="holiday => holiday.duration" Title="Длительность" Sortable="true" />
    <TemplateColumn Title="Месяц" Sortable="true" SortBy="GridSort<Holiday>.ByAscending(h => h.month)" Context="holiday">
        @MonthName(holiday.month)
    </TemplateColumn>
    <PropertyColumn Property="holiday => holiday.day" Title="День" Sortable="true" />
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Holiday> allItems = new();
    private IQueryable<Holiday> query = new List<Holiday>().AsQueryable();

    private static readonly string[] MonthNames = { "", "январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь" };

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        allItems = await context.Holidays.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        query = ApplySearch(allItems).AsQueryable();
        TotalCount = ApplySearch(allItems).Count();
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Название", "Длительность", "Месяц", "День" }
        };
        foreach (var h in ApplySearch(allItems))
        {
            rows.Add(new[] { HolidayName(h), h.duration.ToString(), MonthName(h.month), h.day.ToString() });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Holiday holiday)
        => TextContains(holiday.holiday_name, MonthName(holiday.month));

    private string HolidayName(Holiday h) => h.holiday_name ?? $"№{h.holiday_id}";

    private string MonthName(int? month)
        => month is >= 1 and <= 12 ? MonthNames[month.Value] : "—";

    protected override string GetKey(Holiday h) => h.holiday_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"holidays/details?holiday_id={id}"),
            new("Изменить", $"holidays/edit?holiday_id={id}"),
            new("Удалить", $"holidays/delete?holiday_id={id}", Danger: true),
        };
    }
}