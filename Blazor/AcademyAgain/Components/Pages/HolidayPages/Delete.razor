@page "/holidays/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление праздника</PageTitle>

<h1>Удаление праздника</h1>

<p class="text-danger">Вы уверены, что хотите удалить этот праздник?</p>
<div>
    <hr />
    @if (holiday is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@holiday.holiday_name</dd>
            <dt class="col-sm-2">Длительность</dt>
            <dd class="col-sm-10">@holiday.duration</dd>
            <dt class="col-sm-2">Месяц</dt>
            <dd class="col-sm-10">@MonthName</dd>
            <dt class="col-sm-2">День</dt>
            <dd class="col-sm-10">@(holiday.day?.ToString() ?? "—")</dd>
        </dl>
        <EditForm method="post" Model="holiday" OnValidSubmit="DeleteHoliday" FormName="delete" Enhance>
            <input type="hidden" name="Holiday.holiday_id" value="@holiday.holiday_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/holidays">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Holiday? holiday;
    private string? MonthName = "—";

    private static readonly string[] MonthNames = { "", "январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь" };

    [SupplyParameterFromQuery]
    private int holiday_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        holiday = await context.Holidays.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

        if (holiday is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else if (holiday.month is >= 1 and <= 12)
        {
            MonthName = MonthNames[holiday.month.Value];
        }
    }

    private async Task DeleteHoliday()
    {
        using var context = DbFactory.CreateDbContext();
        context.Holidays.Remove(holiday!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/holidays");
    }
}