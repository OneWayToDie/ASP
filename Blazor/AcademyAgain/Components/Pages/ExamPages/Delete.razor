@page "/exams/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Exam</h2>
    <hr />
    @if (exam is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">student</dt>
            <dd class="col-sm-10">@exam.student</dd>
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@exam.discipline</dd>
            <dt class="col-sm-2">date</dt>
            <dd class="col-sm-10">@exam.date</dd>
            <dt class="col-sm-2">grade</dt>
            <dd class="col-sm-10">@exam.grade</dd>
        </dl>
        <EditForm method="post" Model="exam" OnValidSubmit="DeleteExam" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(exam is null)">Delete</button> |
            <a href="/exams">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Exam? exam;

    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        exam = await context.Exams.FirstOrDefaultAsync(m => m.student == student && m.discipline == discipline);

        if (exam is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteExam()
    {
        using var context = DbFactory.CreateDbContext();
        context.Exams.Remove(exam!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/exams");
    }
}