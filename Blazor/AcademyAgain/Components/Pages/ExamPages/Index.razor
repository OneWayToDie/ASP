@page "/exams"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Экзамены</PageTitle>

<div class="list-header">
    <h1>Экзамены</h1>
    <a class="btn btn-primary" href="exams/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Exams">
    <PropertyColumn Property="exam => exam.student" Title="Студент" />
    <PropertyColumn Property="exam => exam.discipline" Title="Дисциплина" />
    <PropertyColumn Property="exam => exam.date" Title="Дата" />
    <PropertyColumn Property="exam => exam.grade" Title="Оценка" />

    <TemplateColumn Context="exam">
        <a href="@($"exams/edit?student={exam.student}&discipline={exam.discipline}")">Изменить</a> |
        <a href="@($"exams/details?student={exam.student}&discipline={exam.discipline}")">Подробно</a> |
        <a href="@($"exams/delete?student={exam.student}&discipline={exam.discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}