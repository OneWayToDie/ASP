@page "/exams/create"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление экзамена</PageTitle>

<h1>Добавление экзамена</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Exam" OnValidSubmit="AddExam" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="student" class="form-label">Студент:</label>
                <select id="student" name="student" class="form-select" aria-required="true">
                    <option value="">— выберите студента —</option>
                    @foreach (var student in students)
                    {
                        <option value="@student.Key" selected="@(Exam.student == student.Key)">@student.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Exam.student" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline" class="form-label">Дисциплина:</label>
                <select id="discipline" name="discipline" class="form-select" aria-required="true">
                    <option value="">— выберите дисциплину —</option>
                    @foreach (var discipline in disciplines)
                    {
                        <option value="@discipline.Key" selected="@(Exam.discipline == discipline.Key)">@discipline.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Exam.discipline" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="date" class="form-label">Дата:</label>
                <InputDate id="date" @bind-Value="Exam.date" class="form-control" />
                <ValidationMessage For="() => Exam.date" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="grade" class="form-label">Оценка:</label>
                <InputNumber id="grade" @bind-Value="Exam.grade" class="form-control" />
                <ValidationMessage For="() => Exam.grade" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/exams">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Exam Exam { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? student { get; set; }

    [SupplyParameterFromForm]
    private string? discipline { get; set; }

    private List<KeyValuePair<int, string>> students = new();
    private List<KeyValuePair<int, string>> disciplines = new();

    protected override async Task OnInitializedAsync()
    {
        Exam ??= new();
        await using var context = DbFactory.CreateDbContext();
        students = (await context.Students.OrderBy(s => s.last_name).ToListAsync())
            .Select(s => new KeyValuePair<int, string>(s.stud_id,
                !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}"))
            .ToList();
        disciplines = (await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync())
            .Select(d => new KeyValuePair<int, string>(d.discipline_id, d.discipline_name ?? ""))
            .ToList();
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddExam()
    {
        if (!int.TryParse(student, out var studentId) || !int.TryParse(discipline, out var disciplineId))
        {
            return;
        }

        Exam.student = studentId;
        Exam.discipline = disciplineId;

        using var context = DbFactory.CreateDbContext();
        context.Exams.Add(Exam);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/exams");
    }
}