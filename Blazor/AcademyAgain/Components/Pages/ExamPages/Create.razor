@page "/exams/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление экзамена</PageTitle>

<h1>Добавление экзамена</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Exam" OnValidSubmit="AddExam">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            @if (!string.IsNullOrEmpty(SaveError))
            {
                <div class="alert alert-danger" role="alert">@SaveError</div>
            }
            <div class="mb-3">
                <label for="group" class="form-label">Группа:</label>
                <select id="group" class="form-select" @bind="selectedGroupId" @bind:after="OnGroupChanged">
                    <option value="0">— выберите группу —</option>
                    @foreach (var group in groups)
                    {
                        <option value="@group.group_id">@(string.IsNullOrWhiteSpace(group.group_name) ? $"№{group.group_id}" : group.group_name)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="student" class="form-label">Студент:</label>
                <select id="student" class="form-select" @bind="Exam.student">
                    <option value="0">— выберите студента —</option>
                    @foreach (var student in students)
                    {
                        <option value="@student.Key">@student.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Exam.student" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline" class="form-label">Дисциплина:</label>
                <select id="discipline" class="form-select" @bind="Exam.discipline">
                    <option value="0">— выберите дисциплину —</option>
                    @foreach (var discipline in disciplines)
                    {
                        <option value="@discipline.Key">@discipline.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Exam.discipline" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="date" class="form-label">Дата:</label>
                <InputDate id="date" @bind-Value="Exam.date" class="form-control" />
                <ValidationMessage For="() => Exam.date" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="grade" class="form-label">Оценка:</label>
                <select id="grade" class="form-select" @bind="Exam.grade">
                    <option value="">—</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
                <ValidationMessage For="() => Exam.grade" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/exams">Назад к списку</a>
</div>

@code {
    private Exam Exam { get; set; } = new();

    private List<Group> groups = new();
    private List<KeyValuePair<int, string>> students = new();
    private List<KeyValuePair<int, string>> disciplines = new();

    private int selectedGroupId;
    private string? SaveError;

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        groups = await context.Groups.OrderBy(g => g.group_name).ToListAsync();
    }

    private async Task OnGroupChanged()
    {
        Exam.student = 0;
        Exam.discipline = 0;
        await using var context = DbFactory.CreateDbContext();
        await LoadStudentsAsync(context);
        await LoadDisciplinesAsync(context);
    }

    private async Task LoadStudentsAsync(AcademyAgainContext context)
    {
        students = new();
        if (selectedGroupId == 0)
        {
            return;
        }

        students = (await context.Students
                .Where(s => s.group == selectedGroupId)
                .OrderBy(s => s.last_name)
                .ToListAsync())
            .Select(s => new KeyValuePair<int, string>(s.stud_id,
                !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}"))
            .ToList();
    }

    private async Task LoadDisciplinesAsync(AcademyAgainContext context)
    {
        disciplines = new();
        if (selectedGroupId == 0)
        {
            return;
        }

        var group = await context.Groups.FindAsync(selectedGroupId);
        var disciplineIds = group?.direction.HasValue == true
            ? await context.DisciplinesDirectionsRelation
                .Where(r => r.direction == group.direction)
                .Select(r => r.discipline)
                .ToListAsync()
            : new List<int>();

        IEnumerable<Discipline> query;
        if (disciplineIds.Count > 0)
        {
            query = await context.Disciplines
                .Where(d => disciplineIds.Contains(d.discipline_id))
                .OrderBy(d => d.discipline_name)
                .ToListAsync();
        }
        else
        {
            query = await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync();
        }

        disciplines = query
            .Select(d => new KeyValuePair<int, string>(d.discipline_id, d.discipline_name ?? ""))
            .ToList();
    }

    private async Task AddExam()
    {
        SaveError = null;
        using var context = DbFactory.CreateDbContext();
        context.Exams.Add(Exam);
        try
        {
            await context.SaveChangesAsync();
        }
        catch
        {
            SaveError = "Не удалось сохранить: такая запись уже существует.";
            return;
        }
        NavigationManager.NavigateTo("/exams");
    }
}