@page "/exams/details"
@attribute [Authorize(Policy = "Teaching")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Экзамен</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Экзамен</h1>

<hr />
@if (exam is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Студент</dt>
        <dd class="col-sm-10"><a href="@($"/students/details?stud_id={exam.student}")">@StudentName</a></dd>
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={exam.discipline}")">@DisciplineName</a></dd>
        <dt class="col-sm-2">Дата</dt>
        <dd class="col-sm-10">@(exam.date?.ToString("dd.MM.yyyy") ?? "—")</dd>
        <dt class="col-sm-2">Оценка</dt>
        <dd class="col-sm-10">@(exam.grade?.ToString() ?? "—")</dd>
    </dl>
    <div>
        <a href="@($"/exams/edit?student={exam.student}&discipline={exam.discipline}")">Изменить</a> |
        <a href="@($"/exams")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Экзамены", "/exams"),
        new Breadcrumbs.Crumb("Экзамен")
    };
    private Exam? exam;
    private string? StudentName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        exam = await context.Exams.FirstOrDefaultAsync(m => m.student == student && m.discipline == discipline);

        if (exam is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var stud = await context.Students.FirstOrDefaultAsync(s => s.stud_id == exam.student);
            if (stud is not null)
            {
                StudentName = !string.IsNullOrWhiteSpace(stud.middle_name)
                    ? $"{stud.last_name} {stud.first_name} {stud.middle_name}"
                    : $"{stud.last_name} {stud.first_name}";
            }
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == exam.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}