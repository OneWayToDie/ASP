@page "/disciplinesdirectionsrelations/details"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Профиль: дисциплина направления</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Профиль: дисциплина направления</h1>

<hr />
@if (relation is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Направление</dt>
        <dd class="col-sm-10"><a href="@($"/directions/details?direction_id={relation.direction}")">@DirectionName</a></dd>
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={relation.discipline}")">@DisciplineName</a></dd>
    </dl>
    <div>
        <a href="@($"/disciplinesdirectionsrelations/edit?direction={relation.direction}&discipline={relation.discipline}")">Изменить</a> |
        <a href="@($"/disciplinesdirectionsrelations")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Дисциплины направлений", "/disciplinesdirectionsrelations"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private DisciplinesDirectionsRelation? relation;
    private string? DirectionName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int direction { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DirectionName = await context.Directions
                .Where(d => d.direction_id == relation.direction)
                .Select(d => d.direction_name)
                .FirstOrDefaultAsync() ?? "—";
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == relation.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}