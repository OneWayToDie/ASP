@page "/disciplinesdirectionsrelations/edit"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование дисциплины направления</PageTitle>

<h1>Редактирование дисциплины направления</h1>

<hr />
@if (DisciplinesDirectionsRelation is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="DisciplinesDirectionsRelation" OnValidSubmit="UpdateDisciplinesDirectionsRelation" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="DisciplinesDirectionsRelation.direction" value="@DisciplinesDirectionsRelation.direction" />
                <input type="hidden" name="DisciplinesDirectionsRelation.discipline" value="@DisciplinesDirectionsRelation.discipline" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="direction" class="form-label">Направление:</label>
                    <select id="direction" name="directionId" class="form-select" aria-required="true">
                        <option value="">— выберите направление —</option>
                        @foreach (var direction in directions.OrderBy(d => d.direction_name))
                        {
                            <option value="@direction.direction_id" selected="@(SelectedDirection == direction.direction_id)">@direction.direction_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => DisciplinesDirectionsRelation.direction" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="discipline" class="form-label">Дисциплина:</label>
                    <select id="discipline" name="disciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => DisciplinesDirectionsRelation.discipline" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/disciplinesdirectionsrelations">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int direction { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromForm]
    private DisciplinesDirectionsRelation? DisciplinesDirectionsRelation { get; set; }

    [SupplyParameterFromForm]
    private string? directionId { get; set; }

    [SupplyParameterFromForm]
    private string? disciplineId { get; set; }

    private List<Direction> directions = new();
    private List<Discipline> disciplines = new();
    private string? SaveError;

    private int? SelectedDirection
        => int.TryParse(directionId, out var value) ? value : DisciplinesDirectionsRelation?.direction;

    private int? SelectedDiscipline
        => int.TryParse(disciplineId, out var value) ? value : DisciplinesDirectionsRelation?.discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        DisciplinesDirectionsRelation ??= await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);
        directions = await context.Directions.OrderBy(d => d.direction_name).ToListAsync();
        disciplines = await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync();

        if (DisciplinesDirectionsRelation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDisciplinesDirectionsRelation()
    {
        if (!int.TryParse(directionId, out var directionValue)
            || !int.TryParse(disciplineId, out var disciplineValue))
        {
            SaveError = "Выберите направление и дисциплину.";
            return;
        }

        var originalDirection = DisciplinesDirectionsRelation!.direction;
        var originalDiscipline = DisciplinesDirectionsRelation.discipline;
        var keysChanged = originalDirection != directionValue || originalDiscipline != disciplineValue;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(r => r.direction == originalDirection && r.discipline == originalDiscipline);
            if (original is not null)
            {
                context.DisciplinesDirectionsRelation.Remove(original);
                await context.SaveChangesAsync();
            }

            DisciplinesDirectionsRelation.direction = directionValue;
            DisciplinesDirectionsRelation.discipline = disciplineValue;
            context.DisciplinesDirectionsRelation.Add(DisciplinesDirectionsRelation);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(DisciplinesDirectionsRelation).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!DisciplinesDirectionsRelationExists(DisciplinesDirectionsRelation.direction, DisciplinesDirectionsRelation.discipline))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/disciplinesdirectionsrelations");
    }

    private bool DisciplinesDirectionsRelationExists(int direction, int discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DisciplinesDirectionsRelation.Any(e => e.direction == direction && e.discipline == discipline);
    }
}