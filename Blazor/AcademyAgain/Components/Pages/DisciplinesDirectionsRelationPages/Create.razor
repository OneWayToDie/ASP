@page "/disciplinesdirectionsrelations/create"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>DisciplinesDirectionsRelation</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="DisciplinesDirectionsRelation" OnValidSubmit="AddDisciplinesDirectionsRelation" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="direction" class="form-label">direction:</label> 
                <InputNumber id="direction" @bind-Value="DisciplinesDirectionsRelation.direction" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => DisciplinesDirectionsRelation.direction" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline" class="form-label">discipline:</label> 
                <InputNumber id="discipline" @bind-Value="DisciplinesDirectionsRelation.discipline" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => DisciplinesDirectionsRelation.discipline" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/disciplinesdirectionsrelations">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private DisciplinesDirectionsRelation DisciplinesDirectionsRelation { get; set; } = default!;

    protected override void OnInitialized() => DisciplinesDirectionsRelation ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDisciplinesDirectionsRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.DisciplinesDirectionsRelation.Add(DisciplinesDirectionsRelation);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplinesdirectionsrelations");
    }
}