@page "/disciplinesdirectionsrelations/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DisciplinesDirectionsRelation</h2>
    <hr />
    @if (relation is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">direction</dt>
            <dd class="col-sm-10">@relation.direction</dd>
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@relation.discipline</dd>
        </dl>
        <EditForm method="post" Model="relation" OnValidSubmit="DeleteDisciplinesDirectionsRelation" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(relation is null)">Delete</button> |
            <a href="/disciplinesdirectionsrelations">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DisciplinesDirectionsRelation? relation;

    [SupplyParameterFromQuery]
    private int direction { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDisciplinesDirectionsRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.DisciplinesDirectionsRelation.Remove(relation!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplinesdirectionsrelations");
    }
}