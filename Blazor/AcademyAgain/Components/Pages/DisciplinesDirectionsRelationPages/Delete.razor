@page "/disciplinesdirectionsrelations/delete"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление дисциплины направления</PageTitle>

<h1>Удаление дисциплины направления</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту дисциплину направления?</p>
<div>
    <hr />
    @if (relation is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Направление</dt>
            <dd class="col-sm-10">@DirectionName</dd>
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
        </dl>
        <EditForm method="post" Model="relation" OnValidSubmit="DeleteDisciplinesDirectionsRelation" FormName="delete" Enhance>
            <input type="hidden" name="DisciplinesDirectionsRelation.direction" value="@relation.direction" />
            <input type="hidden" name="DisciplinesDirectionsRelation.discipline" value="@relation.discipline" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/disciplinesdirectionsrelations">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private DisciplinesDirectionsRelation? relation;
    private string? DirectionName = "—";
    private string? DisciplineName = "—";

    [SupplyParameterFromQuery]
    private int direction { get; set; }

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relation = await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(m => m.direction == direction && m.discipline == discipline);

        if (relation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DirectionName = await context.Directions
                .Where(d => d.direction_id == relation.direction)
                .Select(d => d.direction_name)
                .FirstOrDefaultAsync() ?? "—";
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == relation.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteDisciplinesDirectionsRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.DisciplinesDirectionsRelation.Remove(relation!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplinesdirectionsrelations");
    }
}