@page "/disciplinesdirectionsrelations"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="disciplinesdirectionsrelations/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.DisciplinesDirectionsRelation">
    <PropertyColumn Property="relation => relation.direction" />
    <PropertyColumn Property="relation => relation.discipline" />

    <TemplateColumn Context="relation">
        <a href="@($"disciplinesdirectionsrelations/edit?direction={relation.direction}&discipline={relation.discipline}")">Edit</a> |
        <a href="@($"disciplinesdirectionsrelations/details?direction={relation.direction}&discipline={relation.discipline}")">Details</a> |
        <a href="@($"disciplinesdirectionsrelations/delete?direction={relation.direction}&discipline={relation.discipline}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}