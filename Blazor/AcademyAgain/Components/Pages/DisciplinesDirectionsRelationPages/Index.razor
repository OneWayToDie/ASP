@page "/disciplinesdirectionsrelations"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Дисциплины направлений</PageTitle>

<div class="list-header">
    <h1>Дисциплины направлений</h1>
    <a class="btn btn-primary" href="disciplinesdirectionsrelations/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.DisciplinesDirectionsRelation">
    <PropertyColumn Property="relation => relation.direction" Title="Направление" />
    <PropertyColumn Property="relation => relation.discipline" Title="Дисциплина" />

    <TemplateColumn Context="relation">
        <a href="@($"disciplinesdirectionsrelations/edit?direction={relation.direction}&discipline={relation.discipline}")">Изменить</a> |
        <a href="@($"disciplinesdirectionsrelations/details?direction={relation.direction}&discipline={relation.discipline}")">Подробно</a> |
        <a href="@($"disciplinesdirectionsrelations/delete?direction={relation.direction}&discipline={relation.discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}