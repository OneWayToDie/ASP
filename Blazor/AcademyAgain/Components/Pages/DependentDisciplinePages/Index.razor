@page "/dependentdisciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Зависимые дисциплины</PageTitle>

<div class="list-header">
    <h1>Зависимые дисциплины</h1>
    <a class="btn btn-primary" href="dependentdisciplines/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.DependentDisciplines">
    <PropertyColumn Property="dependent => dependent.discipline" Title="Дисциплина" />
    <PropertyColumn Property="dependent => dependent.dependent_discipline" Title="Зависимая дисциплина" />

    <TemplateColumn Context="dependent">
        <a href="@($"dependentdisciplines/edit?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Изменить</a> |
        <a href="@($"dependentdisciplines/details?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Подробно</a> |
        <a href="@($"dependentdisciplines/delete?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}