@page "/dependentdisciplines"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<DependentDiscipline>

<PageTitle>Зависимые дисциплины</PageTitle>

<div class="list-header">
    <h1>Зависимые дисциплины</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="dependentdisciplines" />
        <a class="btn btn-primary" href="dependentdisciplines/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="dependent => dependent.discipline.ToString() + '_' + dependent.dependent_discipline.ToString()" Pagination="Pagination">
    <TemplateColumn Title="Дисциплина" Sortable="true" SortBy="GridSort<DependentDiscipline>.ByAscending(d => DisciplineName(d.discipline))" Context="dependent">
        <div class="row-key @RowClass(dependent)" data-item-key="@GetKey(dependent)">
            <a class="table-link" href="@($"/disciplines/details?discipline_id={dependent.discipline}")">@DisciplineName(dependent.discipline)</a>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Зависимая дисциплина" Sortable="true" SortBy="GridSort<DependentDiscipline>.ByAscending(d => DisciplineName(d.dependent_discipline))" Context="dependent">
        <a class="table-link" href="@($"/disciplines/details?discipline_id={dependent.dependent_discipline}")">@DisciplineName(dependent.dependent_discipline)</a>
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<DependentDiscipline> allItems = new();
    private IQueryable<DependentDiscipline> query = new List<DependentDiscipline>().AsQueryable();
    private Dictionary<int, string> disciplineNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        disciplineNames = await context.Disciplines.ToDictionaryAsync(d => d.discipline_id, d => d.discipline_name ?? $"№{d.discipline_id}");
        allItems = await context.DependentDisciplines.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        query = ApplySearch(allItems).AsQueryable();
        TotalCount = ApplySearch(allItems).Count();
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]>
        {
            new[] { "Дисциплина", "Зависимая дисциплина" }
        };
        foreach (var d in ApplySearch(allItems))
        {
            rows.Add(new[] { DisciplineName(d.discipline), DisciplineName(d.dependent_discipline) });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(DependentDiscipline dependent)
        => TextContains(DisciplineName(dependent.discipline), DisciplineName(dependent.dependent_discipline));

    private string DisciplineName(int id)
        => disciplineNames.TryGetValue(id, out var name) ? name : $"№{id}";

    protected override string GetKey(DependentDiscipline d) => $"{d.discipline}|{d.dependent_discipline}";

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var discipline) || !int.TryParse(parts[1], out var dependent))
            return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"dependentdisciplines/details?discipline={discipline}&dependent_discipline={dependent}"),
            new("Изменить", $"dependentdisciplines/edit?discipline={discipline}&dependent_discipline={dependent}"),
            new("Удалить", $"dependentdisciplines/delete?discipline={discipline}&dependent_discipline={dependent}", Danger: true),
        };
    }
}