@page "/dependentdisciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="dependentdisciplines/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.DependentDisciplines">
    <PropertyColumn Property="dependent => dependent.discipline" />
    <PropertyColumn Property="dependent => dependent.dependent_discipline" />

    <TemplateColumn Context="dependent">
        <a href="@($"dependentdisciplines/edit?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Edit</a> |
        <a href="@($"dependentdisciplines/details?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Details</a> |
        <a href="@($"dependentdisciplines/delete?discipline={dependent.discipline}&dependent_discipline={dependent.dependent_discipline}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}