@page "/dependentdisciplines/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>РџРѕРґСЂРѕР±РЅРѕСЃС‚Рё: Р·Р°РІРёСЃРёРјР°СЏ РґРёСЃС†РёРїР»РёРЅР°</PageTitle>

<h1>РџРѕРґСЂРѕР±РЅРѕСЃС‚Рё: Р·Р°РІРёСЃРёРјР°СЏ РґРёСЃС†РёРїР»РёРЅР°</h1>

<hr />
@if (dependentdiscipline is null)
{
    <p><em>Р—Р°РіСЂСѓР·РєР°...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Р”РёСЃС†РёРїР»РёРЅР°</dt>
        <dd class="col-sm-10">@DisciplineName</dd>
        <dt class="col-sm-2">Р—Р°РІРёСЃРёРјР°СЏ РґРёСЃС†РёРїР»РёРЅР°</dt>
        <dd class="col-sm-10">@DependentDisciplineName</dd>
    </dl>
    <div>
        <a href="@($"/dependentdisciplines/edit?discipline={dependentdiscipline.discipline}&dependent_discipline={dependentdiscipline.dependent_discipline}")">РР·РјРµРЅРёС‚СЊ</a> |
        <a href="@($"/dependentdisciplines")">РќР°Р·Р°Рґ Рє СЃРїРёСЃРєСѓ</a>
    </div>
}

@code {
    private DependentDiscipline? dependentdiscipline;
    private string? DisciplineName = "вЂ”";
    private string? DependentDisciplineName = "вЂ”";

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int dependent_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dependentdiscipline = await context.DependentDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);

        if (dependentdiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "вЂ”";
            DependentDisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.dependent_discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "вЂ”";
        }
    }
}