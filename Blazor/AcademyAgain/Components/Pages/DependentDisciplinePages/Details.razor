@page "/dependentdisciplines/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Профиль: зависимая дисциплина</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Профиль: зависимая дисциплина</h1>

<hr />
@if (dependentdiscipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={dependentdiscipline.discipline}")">@DisciplineName</a></dd>
        <dt class="col-sm-2">Зависимая дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={dependentdiscipline.dependent_discipline}")">@DependentDisciplineName</a></dd>
    </dl>
    <div>
        <a href="@($"/dependentdisciplines/edit?discipline={dependentdiscipline.discipline}&dependent_discipline={dependentdiscipline.dependent_discipline}")">Изменить</a> |
        <a href="@($"/dependentdisciplines")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Зависимые дисциплины", "/dependentdisciplines"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private DependentDiscipline? dependentdiscipline;
    private string? DisciplineName = "—";
    private string? DependentDisciplineName = "—";

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int dependent_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dependentdiscipline = await context.DependentDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);

        if (dependentdiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
            DependentDisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.dependent_discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}