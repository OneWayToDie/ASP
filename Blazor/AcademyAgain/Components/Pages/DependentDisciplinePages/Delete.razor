@page "/dependentdisciplines/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление зависимой дисциплины</PageTitle>

<h1>Удаление зависимой дисциплины</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту зависимую дисциплину?</p>
<div>
    <hr />
    @if (dependentdiscipline is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
            <dt class="col-sm-2">Зависимая дисциплина</dt>
            <dd class="col-sm-10">@DependentDisciplineName</dd>
        </dl>
        <EditForm method="post" Model="dependentdiscipline" OnValidSubmit="DeleteDependentDiscipline" FormName="delete" Enhance>
            <input type="hidden" name="DependentDiscipline.discipline" value="@dependentdiscipline.discipline" />
            <input type="hidden" name="DependentDiscipline.dependent_discipline" value="@dependentdiscipline.dependent_discipline" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/dependentdisciplines">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private DependentDiscipline? dependentdiscipline;
    private string? DisciplineName = "—";
    private string? DependentDisciplineName = "—";

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int dependent_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dependentdiscipline = await context.DependentDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);

        if (dependentdiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
            DependentDisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == dependentdiscipline.dependent_discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteDependentDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.DependentDisciplines.Remove(dependentdiscipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dependentdisciplines");
    }
}