@page "/dependentdisciplines/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DependentDiscipline</h2>
    <hr />
    @if (dependentdiscipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@dependentdiscipline.discipline</dd>
            <dt class="col-sm-2">dependent_discipline</dt>
            <dd class="col-sm-10">@dependentdiscipline.dependent_discipline</dd>
        </dl>
        <EditForm method="post" Model="dependentdiscipline" OnValidSubmit="DeleteDependentDiscipline" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(dependentdiscipline is null)">Delete</button> |
            <a href="/dependentdisciplines">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DependentDiscipline? dependentdiscipline;

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int dependent_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dependentdiscipline = await context.DependentDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);

        if (dependentdiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDependentDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.DependentDisciplines.Remove(dependentdiscipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dependentdisciplines");
    }
}