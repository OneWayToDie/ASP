@page "/dependentdisciplines/edit"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование зависимой дисциплины</PageTitle>

<h1>Редактирование зависимой дисциплины</h1>

<hr />
@if (DependentDiscipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="DependentDiscipline" OnValidSubmit="UpdateDependentDiscipline" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="DependentDiscipline.discipline" value="@DependentDiscipline.discipline" />
                <input type="hidden" name="DependentDiscipline.dependent_discipline" value="@DependentDiscipline.dependent_discipline" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="discipline" class="form-label">Дисциплина:</label>
                    <select id="discipline" name="disciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => DependentDiscipline.discipline" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="dependent_discipline" class="form-label">Зависимая дисциплина:</label>
                    <select id="dependent_discipline" name="dependentDisciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedDependentDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => DependentDiscipline.dependent_discipline" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/dependentdisciplines">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int dependent_discipline { get; set; }

    [SupplyParameterFromForm]
    private DependentDiscipline? DependentDiscipline { get; set; }

    [SupplyParameterFromForm]
    private string? disciplineId { get; set; }

    [SupplyParameterFromForm]
    private string? dependentDisciplineId { get; set; }

    private List<Discipline> disciplines = new();
    private string? SaveError;

    private int? SelectedDiscipline
        => int.TryParse(disciplineId, out var value) ? value : DependentDiscipline?.discipline;

    private int? SelectedDependentDiscipline
        => int.TryParse(dependentDisciplineId, out var value) ? value : DependentDiscipline?.dependent_discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        DependentDiscipline ??= await context.DependentDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.dependent_discipline == dependent_discipline);
        disciplines = await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync();

        if (DependentDiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDependentDiscipline()
    {
        if (!int.TryParse(disciplineId, out var disciplineValue)
            || !int.TryParse(dependentDisciplineId, out var dependentDisciplineValue))
        {
            SaveError = "Выберите обе дисциплины.";
            return;
        }

        var originalDiscipline = DependentDiscipline!.discipline;
        var originalDependent = DependentDiscipline.dependent_discipline;
        var keysChanged = originalDiscipline != disciplineValue || originalDependent != dependentDisciplineValue;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.DependentDisciplines.FirstOrDefaultAsync(d => d.discipline == originalDiscipline && d.dependent_discipline == originalDependent);
            if (original is not null)
            {
                context.DependentDisciplines.Remove(original);
                await context.SaveChangesAsync();
            }

            DependentDiscipline.discipline = disciplineValue;
            DependentDiscipline.dependent_discipline = dependentDisciplineValue;
            context.DependentDisciplines.Add(DependentDiscipline);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(DependentDiscipline).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!DependentDisciplineExists(DependentDiscipline.discipline, DependentDiscipline.dependent_discipline))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/dependentdisciplines");
    }

    private bool DependentDisciplineExists(int discipline, int dependent_discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DependentDisciplines.Any(e => e.discipline == discipline && e.dependent_discipline == dependent_discipline);
    }
}