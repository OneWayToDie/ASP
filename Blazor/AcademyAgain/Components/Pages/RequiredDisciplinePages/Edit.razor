@page "/requireddisciplines/edit"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование требуемой дисциплины</PageTitle>

<h1>Редактирование требуемой дисциплины</h1>

<hr />
@if (RequiredDiscipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="RequiredDiscipline" OnValidSubmit="UpdateRequiredDiscipline" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="RequiredDiscipline.discipline" value="@RequiredDiscipline.discipline" />
                <input type="hidden" name="RequiredDiscipline.required_discipline" value="@RequiredDiscipline.required_discipline" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="discipline" class="form-label">Дисциплина:</label>
                    <select id="discipline" name="disciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => RequiredDiscipline.discipline" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="required_discipline" class="form-label">Требуемая дисциплина:</label>
                    <select id="required_discipline" name="requiredDisciplineId" class="form-select" aria-required="true">
                        <option value="">— выберите дисциплину —</option>
                        @foreach (var discipline in disciplines.OrderBy(d => d.discipline_name))
                        {
                            <option value="@discipline.discipline_id" selected="@(SelectedRequiredDiscipline == discipline.discipline_id)">@discipline.discipline_name</option>
                        }
                    </select>
                    <ValidationMessage For="() => RequiredDiscipline.required_discipline" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/requireddisciplines">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int required_discipline { get; set; }

    [SupplyParameterFromForm]
    private RequiredDiscipline? RequiredDiscipline { get; set; }

    [SupplyParameterFromForm]
    private string? disciplineId { get; set; }

    [SupplyParameterFromForm]
    private string? requiredDisciplineId { get; set; }

    private List<Discipline> disciplines = new();

    private int? SelectedDiscipline
        => int.TryParse(disciplineId, out var value) ? value : RequiredDiscipline?.discipline;

    private int? SelectedRequiredDiscipline
        => int.TryParse(requiredDisciplineId, out var value) ? value : RequiredDiscipline?.required_discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        RequiredDiscipline ??= await context.RequiredDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);
        disciplines = await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync();

        if (RequiredDiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateRequiredDiscipline()
    {
        if (!int.TryParse(disciplineId, out var disciplineValue))
        {
            return;
        }
        if (!int.TryParse(requiredDisciplineId, out var requiredDisciplineValue))
        {
            return;
        }

        var originalDiscipline = RequiredDiscipline!.discipline;
        var originalRequired = RequiredDiscipline.required_discipline;
        var keysChanged = originalDiscipline != disciplineValue || originalRequired != requiredDisciplineValue;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.RequiredDisciplines.FirstOrDefaultAsync(r => r.discipline == originalDiscipline && r.required_discipline == originalRequired);
            if (original is not null)
            {
                context.RequiredDisciplines.Remove(original);
                await context.SaveChangesAsync();
            }

            RequiredDiscipline.discipline = disciplineValue;
            RequiredDiscipline.required_discipline = requiredDisciplineValue;
            context.RequiredDisciplines.Add(RequiredDiscipline);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(RequiredDiscipline).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!RequiredDisciplineExists(RequiredDiscipline.discipline, RequiredDiscipline.required_discipline))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/requireddisciplines");
    }

    private bool RequiredDisciplineExists(int discipline, int required_discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.RequiredDisciplines.Any(e => e.discipline == discipline && e.required_discipline == required_discipline);
    }
}