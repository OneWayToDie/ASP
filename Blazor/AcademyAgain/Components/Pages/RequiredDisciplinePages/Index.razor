@page "/requireddisciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Требуемые дисциплины</PageTitle>

<div class="list-header">
    <h1>Требуемые дисциплины</h1>
    <a class="btn btn-primary" href="requireddisciplines/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.RequiredDisciplines">
    <PropertyColumn Property="required => required.discipline" Title="Дисциплина" />
    <PropertyColumn Property="required => required.required_discipline" Title="Требуемая дисциплина" />

    <TemplateColumn Context="required">
        <a href="@($"requireddisciplines/edit?discipline={required.discipline}&required_discipline={required.required_discipline}")">Изменить</a> |
        <a href="@($"requireddisciplines/details?discipline={required.discipline}&required_discipline={required.required_discipline}")">Подробно</a> |
        <a href="@($"requireddisciplines/delete?discipline={required.discipline}&required_discipline={required.required_discipline}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}