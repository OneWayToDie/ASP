@page "/requireddisciplines"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<RequiredDiscipline>

<PageTitle>Требуемые дисциплины</PageTitle>

<div class="list-header">
    <h1>Требуемые дисциплины</h1>
    <a class="btn btn-primary" href="requireddisciplines/create">Создать</a>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="required => required.discipline.ToString() + '_' + required.required_discipline.ToString()">
    <TemplateColumn Title="Дисциплина" Sortable="true" SortBy="GridSort<RequiredDiscipline>.ByAscending(r => DisciplineName(r.discipline))" Context="required">
        <div class="row-key @RowClass(required)" data-item-key="@GetKey(required)">
            @DisciplineName(required.discipline)
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Требуемая дисциплина" Sortable="true" SortBy="GridSort<RequiredDiscipline>.ByAscending(r => DisciplineName(r.required_discipline))" Context="required">
        @DisciplineName(required.required_discipline)
    </TemplateColumn>
</QuickGrid>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private IQueryable<RequiredDiscipline> query = new List<RequiredDiscipline>().AsQueryable();
    private Dictionary<int, string> disciplineNames = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        disciplineNames = await context.Disciplines.ToDictionaryAsync(d => d.discipline_id, d => d.discipline_name ?? $"№{d.discipline_id}");
        query = (await context.RequiredDisciplines.ToListAsync()).AsQueryable();
    }

    private string DisciplineName(int id)
        => disciplineNames.TryGetValue(id, out var name) ? name : $"№{id}";

    protected override string GetKey(RequiredDiscipline r) => $"{r.discipline}|{r.required_discipline}";

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var discipline) || !int.TryParse(parts[1], out var required))
            return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"requireddisciplines/details?discipline={discipline}&required_discipline={required}"),
            new("Изменить", $"requireddisciplines/edit?discipline={discipline}&required_discipline={required}"),
            new("Удалить", $"requireddisciplines/delete?discipline={discipline}&required_discipline={required}", Danger: true),
        };
    }
}