@page "/requireddisciplines/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Профиль: требуемая дисциплина</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Профиль: требуемая дисциплина</h1>

<hr />
@if (requireddiscipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={requireddiscipline.discipline}")">@DisciplineName</a></dd>
        <dt class="col-sm-2">Требуемая дисциплина</dt>
        <dd class="col-sm-10"><a href="@($"/disciplines/details?discipline_id={requireddiscipline.required_discipline}")">@RequiredDisciplineName</a></dd>
    </dl>
    <div>
        <a href="@($"/requireddisciplines/edit?discipline={requireddiscipline.discipline}&required_discipline={requireddiscipline.required_discipline}")">Изменить</a> |
        <a href="@($"/requireddisciplines")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Требуемые дисциплины", "/requireddisciplines"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private RequiredDiscipline? requireddiscipline;
    private string? DisciplineName = "—";
    private string? RequiredDisciplineName = "—";

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int required_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        requireddiscipline = await context.RequiredDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);

        if (requireddiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == requireddiscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
            RequiredDisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == requireddiscipline.required_discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }
}