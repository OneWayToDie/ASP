@page "/requireddisciplines/delete"
@attribute [Authorize(Policy = "ManageData")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление требуемой дисциплины</PageTitle>

<h1>Удаление требуемой дисциплины</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту требуемую дисциплину?</p>
<div>
    <hr />
    @if (requireddiscipline is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
            <dt class="col-sm-2">Требуемая дисциплина</dt>
            <dd class="col-sm-10">@RequiredDisciplineName</dd>
        </dl>
        <EditForm method="post" Model="requireddiscipline" OnValidSubmit="DeleteRequiredDiscipline" FormName="delete" Enhance>
            <input type="hidden" name="RequiredDiscipline.discipline" value="@requireddiscipline.discipline" />
            <input type="hidden" name="RequiredDiscipline.required_discipline" value="@requireddiscipline.required_discipline" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/requireddisciplines">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private RequiredDiscipline? requireddiscipline;
    private string? DisciplineName = "—";
    private string? RequiredDisciplineName = "—";

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int required_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        requireddiscipline = await context.RequiredDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);

        if (requireddiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == requireddiscipline.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
            RequiredDisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == requireddiscipline.required_discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
        }
    }

    private async Task DeleteRequiredDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.RequiredDisciplines.Remove(requireddiscipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/requireddisciplines");
    }
}