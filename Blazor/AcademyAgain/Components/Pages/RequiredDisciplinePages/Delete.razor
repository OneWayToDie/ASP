@page "/requireddisciplines/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>RequiredDiscipline</h2>
    <hr />
    @if (requireddiscipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@requireddiscipline.discipline</dd>
            <dt class="col-sm-2">required_discipline</dt>
            <dd class="col-sm-10">@requireddiscipline.required_discipline</dd>
        </dl>
        <EditForm method="post" Model="requireddiscipline" OnValidSubmit="DeleteRequiredDiscipline" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(requireddiscipline is null)">Delete</button> |
            <a href="/requireddisciplines">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private RequiredDiscipline? requireddiscipline;

    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromQuery]
    private int required_discipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        requireddiscipline = await context.RequiredDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline && m.required_discipline == required_discipline);

        if (requireddiscipline is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteRequiredDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.RequiredDisciplines.Remove(requireddiscipline!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/requireddisciplines");
    }
}