@page "/schedules/create"
@attribute [Authorize(Policy = "Teaching")]
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление занятия</PageTitle>

<h1>Добавление занятия</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Schedule" OnValidSubmit="AddSchedule" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            @if (!string.IsNullOrEmpty(SaveError))
            {
                <div class="alert alert-danger" role="alert">@SaveError</div>
            }
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="group" class="form-label">Группа:</label>
                <select id="group" name="group" class="form-select" aria-required="true">
                    <option value="">— выберите группу —</option>
                    @foreach (var group in groups)
                    {
                        <option value="@group.Key" selected="@(Schedule.group == group.Key)">@group.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Schedule.group" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="discipline" class="form-label">Дисциплина:</label>
                <select id="discipline" name="discipline" class="form-select" aria-required="true">
                    <option value="">— выберите дисциплину —</option>
                    @foreach (var discipline in disciplines)
                    {
                        <option value="@discipline.Key" selected="@(Schedule.discipline == discipline.Key)">@discipline.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Schedule.discipline" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="teacher" class="form-label">Преподаватель:</label>
                <select id="teacher" name="teacher" class="form-select" aria-required="true">
                    <option value="">— выберите преподавателя —</option>
                    @foreach (var teacher in teachers)
                    {
                        <option value="@teacher.Key" selected="@(Schedule.teacher == teacher.Key)">@teacher.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Schedule.teacher" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="date" class="form-label">Дата:</label>
                <InputDate id="date" @bind-Value="Schedule.date" class="form-control" />
                <ValidationMessage For="() => Schedule.date" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="time" class="form-label">Время:</label>
                <input id="time" name="time" type="time" class="form-control" value="@time" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="duration_min" class="form-label">Длительность (мин):</label>
                <input id="duration_min" name="durationMin" type="number" min="30" max="240" step="15" class="form-control" value="@durationMin" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="spent" class="form-label">Проведено:</label>
                <InputCheckbox id="spent" @bind-Value="Schedule.spent" class="form-check-input" aria-required="true"/>
                <ValidationMessage For="() => Schedule.spent" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/schedules">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Schedule Schedule { get; set; } = default!;

    [SupplyParameterFromForm]
    private string? group { get; set; }

    [SupplyParameterFromForm]
    private string? discipline { get; set; }

    [SupplyParameterFromForm]
    private string? teacher { get; set; }

    [SupplyParameterFromForm]
    private string? time { get; set; }

    [SupplyParameterFromForm]
    private string? durationMin { get; set; }

    private List<KeyValuePair<int, string>> groups = new();
    private List<KeyValuePair<int, string>> disciplines = new();
    private List<KeyValuePair<int, string>> teachers = new();
    private string? SaveError;

    protected override async Task OnInitializedAsync()
    {
        Schedule ??= new() { duration_min = 90 };
        time ??= Schedule.time?.ToString(@"hh\:mm") ?? "";
        durationMin ??= Schedule.duration_min.ToString();
        await using var context = DbFactory.CreateDbContext();
        groups = (await context.Groups.OrderBy(g => g.group_name).ToListAsync())
            .Select(g => new KeyValuePair<int, string>(g.group_id, g.group_name ?? ""))
            .ToList();
        disciplines = (await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync())
            .Select(d => new KeyValuePair<int, string>(d.discipline_id, d.discipline_name ?? ""))
            .ToList();
        teachers = (await context.Teachers.OrderBy(t => t.last_name).ToListAsync())
            .Select(t => new KeyValuePair<int, string>(t.teacher_id,
                string.Join(" ", new[] { t.last_name, t.first_name, t.middle_name }.Where(p => !string.IsNullOrWhiteSpace(p)))))
            .ToList();
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSchedule()
    {
        if (!int.TryParse(group, out var groupId) || !int.TryParse(discipline, out var disciplineId) || !int.TryParse(teacher, out var teacherId))
        {
            SaveError = "Выберите группу, дисциплину и преподавателя.";
            return;
        }

        Schedule.group = groupId;
        Schedule.discipline = disciplineId;
        Schedule.teacher = teacherId;
        Schedule.time = ParseTime(time);
        if (int.TryParse(durationMin, out var duration) && duration >= 30 && duration <= 240)
        {
            Schedule.duration_min = duration;
        }

        using var context = DbFactory.CreateDbContext();

        if (Schedule.date is not null)
        {
            Schedule.semester_id = await context.Semesters.AsNoTracking()
                .Where(m => m.start_date <= Schedule.date && m.end_date >= Schedule.date)
                .Select(m => (int?)m.semester_id)
                .FirstOrDefaultAsync();
        }

        var conflicts = AcademyAgain.Helpers.ScheduleConflictChecker.FindConflicts(
            context, Schedule.date, Schedule.time, Schedule.duration_min, groupId, teacherId, 0);
        if (conflicts.Count > 0)
        {
            SaveError = string.Join(" ", conflicts);
            return;
        }

        context.Schedule.Add(Schedule);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/schedules");
    }

    private static TimeSpan? ParseTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return TimeSpan.TryParseExact(value, @"hh\:mm", CultureInfo.InvariantCulture, out var result)
            || TimeSpan.TryParseExact(value, @"hh\:mm\:ss", CultureInfo.InvariantCulture, out result)
                ? result
                : null;
    }
}