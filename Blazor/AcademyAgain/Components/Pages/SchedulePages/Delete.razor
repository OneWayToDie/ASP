@page "/schedules/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление занятия</PageTitle>

<h1>Удаление занятия</h1>

<p class="text-danger">Вы уверены, что хотите удалить это занятие?</p>
<div>
    <hr />
    @if (schedule is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Группа</dt>
            <dd class="col-sm-10">@GroupName</dd>
            <dt class="col-sm-2">Дисциплина</dt>
            <dd class="col-sm-10">@DisciplineName</dd>
            <dt class="col-sm-2">Преподаватель</dt>
            <dd class="col-sm-10">@TeacherName</dd>
            <dt class="col-sm-2">Дата</dt>
            <dd class="col-sm-10">@(schedule.date?.ToString("dd.MM.yyyy") ?? "—")</dd>
            <dt class="col-sm-2">Время</dt>
            <dd class="col-sm-10">@(schedule.time?.ToString() ?? "—")</dd>
            <dt class="col-sm-2">Проведено</dt>
            <dd class="col-sm-10">@(schedule.spent ? "Да" : "Нет")</dd>
        </dl>
        <EditForm method="post" Model="schedule" OnValidSubmit="DeleteSchedule" FormName="delete" Enhance>
            <input type="hidden" name="Schedule.lesson_id" value="@schedule.lesson_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/schedules">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Schedule? schedule;
    private string? GroupName = "—";
    private string? DisciplineName = "—";
    private string? TeacherName = "—";

    [SupplyParameterFromQuery]
    private long lesson_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        schedule = await context.Schedule.FirstOrDefaultAsync(m => m.lesson_id == lesson_id);

        if (schedule is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            GroupName = await context.Groups
                .Where(g => g.group_id == schedule.group)
                .Select(g => g.group_name)
                .FirstOrDefaultAsync() ?? "—";
            DisciplineName = await context.Disciplines
                .Where(d => d.discipline_id == schedule.discipline)
                .Select(d => d.discipline_name)
                .FirstOrDefaultAsync() ?? "—";
            var teacher = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == schedule.teacher);
            if (teacher is not null)
            {
                TeacherName = string.Join(" ", new[] { teacher.last_name, teacher.first_name, teacher.middle_name }
                    .Where(p => !string.IsNullOrWhiteSpace(p)));
            }
        }
    }

    private async Task DeleteSchedule()
    {
        using var context = DbFactory.CreateDbContext();
        context.Schedule.Remove(schedule!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/schedules");
    }
}