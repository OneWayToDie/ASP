@page "/schedules"
@attribute [Authorize(Policy = "Teaching")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Schedule>

<PageTitle>Расписание</PageTitle>

<div class="list-header">
    <h1>Расписание</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Печать</button>
        <a class="btn btn-outline-secondary" href="schedules/calendar">Календарь</a>
        <ExportMenu RowBuilder="BuildRows" FileName="schedules" />
        <a class="btn btn-primary" href="schedules/create">Создать</a>
    </div>
</div>

<div class="filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="filter-label">Период:</span>
    <button type="button" class='chip @(periodFilter == "all" ? "chip-active" : "")' @onclick='() => SetPeriod("all")'>Все</button>
    <button type="button" class='chip @(periodFilter == "today" ? "chip-active" : "")' @onclick='() => SetPeriod("today")'>Сегодня</button>
    <button type="button" class='chip @(periodFilter == "week" ? "chip-active" : "")' @onclick='() => SetPeriod("week")'>Неделя</button>
    <button type="button" class='chip @(periodFilter == "notspent" ? "chip-active" : "")' @onclick='() => SetPeriod("notspent")'>Не проведено</button>
    <span class="filter-divider"></span>
    <select class="form-select form-select-sm filter-select" @bind="groupFilter" @bind:after="OnFilterChanged">
        <option value="0">Все группы</option>
        @foreach (var group in groups)
        {
            <option value="@group.Key">@group.Value</option>
        }
    </select>
    <select class="form-select form-select-sm filter-select" @bind="teacherFilter" @bind:after="OnFilterChanged">
        <option value="0">Все преподаватели</option>
        @foreach (var teacher in teachers)
        {
            <option value="@teacher.Key">@teacher.Value</option>
        }
    </select>
    <select class="form-select form-select-sm filter-select" @bind="semesterFilter" @bind:after="OnFilterChanged">
        <option value="0">Все семестры</option>
        @foreach (var semester in semesters)
        {
            <option value="@semester.semester_id">@semester.name</option>
        }
    </select>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="schedule => schedule.lesson_id" Pagination="Pagination">
    <TemplateColumn Title="Группа" Sortable="true" SortBy="GridSort<Schedule>.ByAscending(s => GroupName(s.group))" Context="schedule">
        <div class="row-key @RowClass(schedule)" data-item-key="@GetKey(schedule)">
            <a class="table-link" href="@($"/groups/details?group_id={schedule.group}")">@(GroupName(schedule.group))</a>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Дисциплина" Sortable="true" SortBy="GridSort<Schedule>.ByAscending(s => DisciplineName(s.discipline))" Context="schedule">
        <a class="table-link" href="@($"/disciplines/details?discipline_id={schedule.discipline}")">@(DisciplineName(schedule.discipline))</a>
    </TemplateColumn>
    <TemplateColumn Title="Преподаватель" Sortable="true" SortBy="GridSort<Schedule>.ByAscending(s => TeacherName(s.teacher))" Context="schedule">
        <a class="table-link" href="@($"/teachers/details?teacher_id={schedule.teacher}")">@(TeacherName(schedule.teacher))</a>
    </TemplateColumn>
    <PropertyColumn Property="schedule => schedule.date" Title="Дата" Format="dd.MM.yyyy" Sortable="true" />
    <PropertyColumn Property="schedule => schedule.time" Title="Время" Sortable="true" />
    <TemplateColumn Title="Семестр / неделя" Sortable="true" SortBy="GridSort<Schedule>.ByAscending(s => SemesterName(s.semester_id))" Context="schedule">
        @SemesterCell(schedule)
    </TemplateColumn>
    <TemplateColumn Title="Проведено" Sortable="true" SortBy="GridSort<Schedule>.ByAscending(s => s.spent)" Context="schedule">
        @(schedule.spent ? "Да" : "Нет")
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Schedule> allItems = new();
    private IQueryable<Schedule> query = new List<Schedule>().AsQueryable();
    private List<Schedule> filtered = new();
    private Dictionary<int, string> groups = new();
    private Dictionary<int, string> disciplines = new();
    private Dictionary<int, string> teachers = new();
    private Dictionary<int, Models.Semester> semesterMap = new();

    private string periodFilter = "all";
    private int groupFilter;
    private int teacherFilter;
    private int semesterFilter;

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        groups = (await context.Groups.OrderBy(g => g.group_name).ToListAsync())
            .ToDictionary(g => g.group_id, g => g.group_name ?? "");
        disciplines = (await context.Disciplines.OrderBy(d => d.discipline_name).ToListAsync())
            .ToDictionary(d => d.discipline_id, d => d.discipline_name ?? "");
        teachers = (await context.Teachers.OrderBy(t => t.last_name).ToListAsync())
            .ToDictionary(t => t.teacher_id, t => TeacherName(t));
        semesterMap = (await context.Semesters.AsNoTracking().ToListAsync()).ToDictionary(m => m.semester_id);
        allItems = await context.Schedule.ToListAsync();
        ApplyFilter();
    }

    private IEnumerable<Schedule> Filtered()
    {
        IEnumerable<Schedule> list = allItems;
        switch (periodFilter)
        {
            case "today":
                list = list.Where(s => s.date.HasValue && s.date.Value.Date == DateTime.Today);
                break;
            case "week":
                list = list.Where(s => s.date.HasValue && IsInCurrentWeek(s.date.Value));
                break;
            case "notspent":
                list = list.Where(s => !s.spent);
                break;
        }
        if (groupFilter != 0)
        {
            list = list.Where(s => s.group == groupFilter);
        }
        if (teacherFilter != 0)
        {
            list = list.Where(s => s.teacher == teacherFilter);
        }
        if (semesterFilter != 0)
        {
            list = list.Where(s => s.semester_id == semesterFilter);
        }
        return list;
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(Filtered()).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Группа", "Дисциплина", "Преподаватель", "Дата", "Время", "Проведено" }
        };
        foreach (var s in filtered)
        {
            rows.Add(new[]
            {
                GroupName(s.group), DisciplineName(s.discipline), TeacherName(s.teacher),
                s.date?.ToString("dd.MM.yyyy"), s.time?.ToString(), s.spent ? "да" : "нет"
            });
        }
        return rows;
    }

    private static bool IsInCurrentWeek(DateTime date)
    {
        var today = DateTime.Today;
        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        return date.Date >= monday && date.Date < monday.AddDays(7);
    }

    private async Task SetPeriod(string value)
    {
        periodFilter = value;
        ApplyFilter();
        await ResetPaginationAsync();
    }

    private async Task OnFilterChanged()
    {
        ApplyFilter();
        await ResetPaginationAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Schedule schedule)
        => TextContains(
            GroupName(schedule.group),
            DisciplineName(schedule.discipline),
            TeacherName(schedule.teacher),
            schedule.date.HasValue ? schedule.date.Value.ToString("dd.MM.yyyy") : null,
            schedule.time?.ToString(),
            schedule.spent ? "да" : "нет");

    private string GroupName(int id)
        => groups.TryGetValue(id, out var name) ? name : $"№{id}";

    private string DisciplineName(int id)
        => disciplines.TryGetValue(id, out var name) ? name : $"№{id}";

    private string TeacherName(int id)
        => teachers.TryGetValue(id, out var name) ? name : $"№{id}";

    private List<Semester> semesters
        => semesterMap.Values.OrderBy(m => m.start_date).ToList();

    private string SemesterName(int? id)
        => id is int sid && semesterMap.TryGetValue(sid, out var name) ? name.name : "—";

    private MarkupString SemesterCell(Schedule schedule)
    {
        string name = SemesterName(schedule.semester_id);
        if (schedule.date is null || schedule.semester_id is not int semesterId || !semesterMap.TryGetValue(semesterId, out var semester) || semester.start_date is not DateTime startDate)
        {
            return new MarkupString($"<span>{name}</span>");
        }
        bool? even = schedule.date.HasValue ? (bool?)AcademyAgain.Helpers.WeekParity.IsEvenWeek(schedule.date.Value, startDate, semester.is_even_week_start) : null;
        string parity = even.HasValue ? $" <span class=\"badge {(even.Value ? "text-bg-primary" : "text-bg-secondary")}\">{AcademyAgain.Helpers.WeekParity.ParityLabel(even.Value)}</span>" : "";
        return new MarkupString($"<span>{name}</span>{parity}");
    }

    private static string TeacherName(Teacher t)
        => string.Join(" ", new[] { t.last_name, t.first_name, t.middle_name }.Where(p => !string.IsNullOrWhiteSpace(p)));

    protected override string GetKey(Schedule s) => s.lesson_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!long.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"schedules/details?lesson_id={id}"),
            new("Изменить", $"schedules/edit?lesson_id={id}"),
            new("Удалить", $"schedules/delete?lesson_id={id}", Danger: true),
        };
    }
}