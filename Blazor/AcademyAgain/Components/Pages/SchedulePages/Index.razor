@page "/schedules"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Расписание</PageTitle>

<div class="list-header">
    <h1>Расписание</h1>
    <a class="btn btn-primary" href="schedules/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Schedule">
    <PropertyColumn Property="schedule => schedule.group" Title="Группа" />
    <PropertyColumn Property="schedule => schedule.discipline" Title="Дисциплина" />
    <PropertyColumn Property="schedule => schedule.teacher" Title="Преподаватель" />
    <PropertyColumn Property="schedule => schedule.date" Title="Дата" />
    <PropertyColumn Property="schedule => schedule.time" Title="Время" />
    <PropertyColumn Property="schedule => schedule.spent" Title="Проведено" />

    <TemplateColumn Context="schedule">
        <a href="@($"schedules/edit?lesson_id={schedule.lesson_id}")">Изменить</a> |
        <a href="@($"schedules/details?lesson_id={schedule.lesson_id}")">Подробно</a> |
        <a href="@($"schedules/delete?lesson_id={schedule.lesson_id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
