@page "/schedules/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Schedule</h2>
    <hr />
    @if (schedule is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">group</dt>
            <dd class="col-sm-10">@schedule.group</dd>
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@schedule.discipline</dd>
            <dt class="col-sm-2">teacher</dt>
            <dd class="col-sm-10">@schedule.teacher</dd>
            <dt class="col-sm-2">date</dt>
            <dd class="col-sm-10">@schedule.date</dd>
            <dt class="col-sm-2">time</dt>
            <dd class="col-sm-10">@schedule.time</dd>
            <dt class="col-sm-2">spent</dt>
            <dd class="col-sm-10">@schedule.spent</dd>
        </dl>
        <div>
            <a href="@($"/schedules/edit?lesson_id={schedule.lesson_id}")">Edit</a> |
            <a href="@($"/schedules")">Back to List</a>
        </div>
    }
</div>

@code {
    private Schedule? schedule;

    [SupplyParameterFromQuery]
    private long lesson_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        schedule = await context.Schedule.FirstOrDefaultAsync(m => m.lesson_id == lesson_id);

        if (schedule is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
