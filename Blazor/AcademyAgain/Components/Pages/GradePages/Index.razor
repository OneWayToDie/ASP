@page "/grades"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Grade>

<PageTitle>Оценки</PageTitle>

<div class="list-header">
    <h1>Оценки</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Печать</button>
        <ExportMenu RowBuilder="BuildRows" FileName="grades" />
        <a class="btn btn-primary" href="grades/create">Создать</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(SaveError))
{
    <div class="alert alert-danger" role="alert">@SaveError</div>
}

<QuickGrid Class="table context-table" Items="query" ItemKey="grade => grade.student.ToString() + '_' + grade.lesson.ToString()" Pagination="Pagination">
    <TemplateColumn Title="Студент" Sortable="true" SortBy="GridSort<Grade>.ByAscending(g => StudentName(g.student))" Context="grade">
        <div class="row-key @RowClass(grade)" data-item-key="@GetKey(grade)">
            <a class="table-link" href="@($"/students/details?stud_id={grade.student}")">@(StudentName(grade.student))</a>
        </div>
    </TemplateColumn>
    <TemplateColumn Title="Занятие" Sortable="true" SortBy="GridSort<Grade>.ByAscending(g => LessonName(g.lesson))" Context="grade">
        <a class="table-link" href="@($"/schedules/details?lesson_id={grade.lesson}")">@(LessonName(grade.lesson))</a>
    </TemplateColumn>
    <TemplateColumn Title="Оценка 1" Sortable="true" SortBy="GridSort<Grade>.ByAscending(g => g.grade_1)" Context="grade">
        <select class="form-select grade-select" value="@grade.grade_1?.ToString()"
                @onchange="e => OnGradeChanged(grade, 1, (ChangeEventArgs)e)" aria-label="Оценка 1">
            <option value="">—</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
    </TemplateColumn>
    <TemplateColumn Title="Оценка 2" Sortable="true" SortBy="GridSort<Grade>.ByAscending(g => g.grade_2)" Context="grade">
        <select class="form-select grade-select" value="@grade.grade_2?.ToString()"
                @onchange="e => OnGradeChanged(grade, 2, (ChangeEventArgs)e)" aria-label="Оценка 2">
            <option value="">—</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Grade> allItems = new();
    private IQueryable<Grade> query = new List<Grade>().AsQueryable();
    private List<Grade> filtered = new();
    private Dictionary<int, string> students = new();
    private Dictionary<long, string> lessonNames = new();
    private string? SaveError;

    private async Task OnGradeChanged(Grade grade, int column, ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        var parsed = string.IsNullOrEmpty(text) ? null : (int?)int.Parse(text);
        if (parsed.HasValue && (parsed < 2 || parsed > 5))
        {
            SaveError = $"Недопустимая оценка: {parsed}. Допустимо 2..5 или пусто.";
            StateHasChanged();
            return;
        }

        var current = column == 1 ? grade.grade_1 : grade.grade_2;
        if (current == parsed) return;

        if (column == 1) grade.grade_1 = parsed; else grade.grade_2 = parsed;

        try
        {
            await using var context = DbFactory.CreateDbContext();
            var row = await context.Grades
                .FirstOrDefaultAsync(g => g.student == grade.student && g.lesson == grade.lesson);
            if (row is null)
            {
                SaveError = $"Запись об оценке не найдена (студент {grade.student}, занятие {grade.lesson}).";
                StateHasChanged();
                return;
            }
            if (column == 1) row.grade_1 = parsed; else row.grade_2 = parsed;
            await context.SaveChangesAsync();
            SaveError = null;
        }
        catch (DbUpdateConcurrencyException ex)
        {
            SaveError = $"Не удалось сохранить оценку: запись изменена другим пользователем. {ex.Message}";
            if (column == 1) grade.grade_1 = current; else grade.grade_2 = current;
        }
        catch (Exception ex)
        {
            SaveError = $"Не удалось сохранить оценку: {ex.Message}";
            if (column == 1) grade.grade_1 = current; else grade.grade_2 = current;
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        students = (await context.Students.OrderBy(s => s.last_name).ToListAsync())
            .ToDictionary(s => s.stud_id,
                s => !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}");
        await BuildLessonNamesAsync(context);
        allItems = await context.Grades.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filtered = ApplySearch(allItems).ToList();
        query = filtered.AsQueryable();
        TotalCount = filtered.Count;
    }

    private List<string?[]> BuildRows()
    {
        var rows = new List<string?[]>
        {
            new[] { "Студент", "Занятие", "Оценка 1", "Оценка 2" }
        };
        foreach (var g in filtered)
        {
            rows.Add(new[] { StudentName(g.student), LessonName(g.lesson), g.grade_1?.ToString(), g.grade_2?.ToString() });
        }
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Grade grade)
        => TextContains(StudentName(grade.student), LessonName(grade.lesson));

    private async Task BuildLessonNamesAsync(AcademyAgainContext context)
    {
        lessonNames = new Dictionary<long, string>();
        var groupNames = (await context.Groups.ToListAsync())
            .ToDictionary(g => g.group_id, g => g.group_name ?? "");
        foreach (var s in context.Schedule)
        {
            var groupName = groupNames.TryGetValue(s.group, out var name) ? name : $"№{s.group}";
            lessonNames[s.lesson_id] = s.date.HasValue
                ? $"{s.lesson_id} · {groupName} · {s.date:d}"
                : $"{s.lesson_id} · {groupName}";
        }
    }

    private string StudentName(int id)
        => students.TryGetValue(id, out var name) ? name : $"№{id}";

    private string LessonName(long id)
        => lessonNames.TryGetValue(id, out var label) ? label : $"№{id}";

    protected override string GetKey(Grade g) => $"{g.student}|{g.lesson}";

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        var parts = key.Split('|');
        if (parts.Length != 2 || !int.TryParse(parts[0], out var student) || !long.TryParse(parts[1], out var lesson))
            return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"grades/details?student={student}&lesson={lesson}"),
            new("Изменить", $"grades/edit?student={student}&lesson={lesson}"),
            new("Удалить", $"grades/delete?student={student}&lesson={lesson}", Danger: true),
        };
    }
}