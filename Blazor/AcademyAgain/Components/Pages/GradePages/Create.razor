@page "/grades/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление оценки</PageTitle>

<h1>Добавление оценки</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Grade" OnValidSubmit="AddGrade">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            @if (!string.IsNullOrEmpty(SaveError))
            {
                <div class="alert alert-danger" role="alert">@SaveError</div>
            }
            <div class="mb-3">
                <label for="group" class="form-label">Группа:</label>
                <select id="group" class="form-select" @bind="selectedGroupId" @bind:after="OnGroupChanged">
                    <option value="0">— выберите группу —</option>
                    @foreach (var group in groups)
                    {
                        <option value="@group.group_id">@(string.IsNullOrWhiteSpace(group.group_name) ? $"№{group.group_id}" : group.group_name)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="student" class="form-label">Студент:</label>
                <select id="student" class="form-select" @bind="Grade.student">
                    <option value="0">— выберите студента —</option>
                    @foreach (var student in students)
                    {
                        <option value="@student.Key">@student.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Grade.student" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="lesson" class="form-label">Занятие:</label>
                <select id="lesson" class="form-select" @bind="Grade.lesson">
                    <option value="0">— выберите занятие —</option>
                    @foreach (var lesson in lessons)
                    {
                        <option value="@lesson.Key">@lesson.Value</option>
                    }
                </select>
                <ValidationMessage For="() => Grade.lesson" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="grade_1" class="form-label">Оценка 1:</label>
                <select id="grade_1" class="form-select" @bind="grade1Selection">
                    <option value="">—</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="absent">Отсутствовал</option>
                </select>
                <ValidationMessage For="() => Grade.grade_1" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="grade_2" class="form-label">Оценка 2:</label>
                <select id="grade_2" class="form-select" @bind="grade2Selection">
                    <option value="">—</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="absent">Отсутствовал</option>
                </select>
                <ValidationMessage For="() => Grade.grade_2" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/grades">Назад к списку</a>
</div>

@code {
    private Grade Grade { get; set; } = new();

    private List<Group> groups = new();
    private List<KeyValuePair<int, string>> students = new();
    private List<KeyValuePair<long, string>> lessons = new();

    private int selectedGroupId;
    private string? SaveError;
    private string grade1Selection = "";
    private string grade2Selection = "";

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        groups = await context.Groups.OrderBy(g => g.group_name).ToListAsync();
    }

    private async Task OnGroupChanged()
    {
        Grade.student = 0;
        Grade.lesson = 0;
        await using var context = DbFactory.CreateDbContext();
        await LoadStudentsAsync(context);
        await LoadLessonsAsync(context);
    }

    private async Task LoadStudentsAsync(AcademyAgainContext context)
    {
        students = new();
        if (selectedGroupId == 0)
        {
            return;
        }

        students = (await context.Students
                .Where(s => s.group == selectedGroupId)
                .OrderBy(s => s.last_name)
                .ToListAsync())
            .Select(s => new KeyValuePair<int, string>(s.stud_id,
                !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}"))
            .ToList();
    }

    private async Task LoadLessonsAsync(AcademyAgainContext context)
    {
        lessons = new();
        if (selectedGroupId == 0)
        {
            return;
        }

        var groupName = groups.FirstOrDefault(g => g.group_id == selectedGroupId)?.group_name ?? $"№{selectedGroupId}";
        var schedule = await context.Schedule
            .Where(s => s.group == selectedGroupId)
            .OrderBy(s => s.lesson_id)
            .ToListAsync();
        foreach (var s in schedule)
        {
            lessons.Add(new KeyValuePair<long, string>(s.lesson_id, s.date.HasValue
                ? $"{s.lesson_id} · {groupName} · {s.date:d}"
                : $"{s.lesson_id} · {groupName}"));
        }
    }

    private async Task AddGrade()
    {
        SaveError = null;

        bool absent1 = grade1Selection == "absent";
        bool absent2 = grade2Selection == "absent";
        bool fullyAbsent = absent1 && absent2;

        if (absent1)
        {
            Grade.grade_1 = null;
        }
        else if (grade1Selection != "")
        {
            Grade.grade_1 = int.Parse(grade1Selection);
        }

        if (absent2)
        {
            Grade.grade_2 = null;
        }
        else if (grade2Selection != "")
        {
            Grade.grade_2 = int.Parse(grade2Selection);
        }

        using var context = DbFactory.CreateDbContext();

        var attendance = await context.Attendance.FindAsync(Grade.student, Grade.lesson);
        if (attendance == null)
        {
            context.Attendance.Add(new Attendance
            {
                student = Grade.student,
                lesson = Grade.lesson,
                present = !fullyAbsent
            });
        }
        else
        {
            attendance.present = !fullyAbsent;
        }

        if (!fullyAbsent)
        {
            context.Grades.Add(Grade);
        }

        try
        {
            await context.SaveChangesAsync();
        }
        catch
        {
            SaveError = "Не удалось сохранить: такая запись уже существует.";
            return;
        }
        NavigationManager.NavigateTo("/grades");
    }
}