@page "/grades/edit"
@attribute [Authorize(Policy = "Teaching")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редактирование оценки</PageTitle>

<h1>Редактирование оценки</h1>

<hr />
@if (Grade is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Grade" OnValidSubmit="UpdateGrade" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @if (!string.IsNullOrEmpty(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <input type="hidden" name="Grade.student" value="@Grade.student" />
                <input type="hidden" name="Grade.lesson" value="@Grade.lesson" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="student" class="form-label">Студент:</label>
                    <select id="student" name="studentSel" class="form-select" aria-required="true">
                        <option value="">— выберите студента —</option>
                        @foreach (var student in students)
                        {
                            <option value="@student.Key" selected="@(SelectedStudent == student.Key)">@student.Value</option>
                        }
                    </select>
                    <ValidationMessage For="() => Grade.student" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="lesson" class="form-label">Занятие:</label>
                    <select id="lesson" name="lessonSel" class="form-select" aria-required="true">
                        <option value="">— выберите занятие —</option>
                        @foreach (var lesson in lessonNames)
                        {
                            <option value="@lesson.Key" selected="@(SelectedLesson == lesson.Key)">@lesson.Value</option>
                        }
                    </select>
                    <ValidationMessage For="() => Grade.lesson" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="grade_1" class="form-label">Оценка 1:</label>
                    <select id="grade_1" name="Grade.grade_1" class="form-select">
                        <option value="">—</option>
                        @if (Grade.grade_1.HasValue && (Grade.grade_1 < 2 || Grade.grade_1 > 5))
                        {
                            <option value="@Grade.grade_1" selected>@Grade.grade_1</option>
                        }
                        <option value="2" selected="@(Grade.grade_1 == 2)">2</option>
                        <option value="3" selected="@(Grade.grade_1 == 3)">3</option>
                        <option value="4" selected="@(Grade.grade_1 == 4)">4</option>
                        <option value="5" selected="@(Grade.grade_1 == 5)">5</option>
                    </select>
                    <ValidationMessage For="() => Grade.grade_1" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="grade_2" class="form-label">Оценка 2:</label>
                    <select id="grade_2" name="Grade.grade_2" class="form-select">
                        <option value="">—</option>
                        @if (Grade.grade_2.HasValue && (Grade.grade_2 < 2 || Grade.grade_2 > 5))
                        {
                            <option value="@Grade.grade_2" selected>@Grade.grade_2</option>
                        }
                        <option value="2" selected="@(Grade.grade_2 == 2)">2</option>
                        <option value="3" selected="@(Grade.grade_2 == 3)">3</option>
                        <option value="4" selected="@(Grade.grade_2 == 4)">4</option>
                        <option value="5" selected="@(Grade.grade_2 == 5)">5</option>
                    </select>
                    <ValidationMessage For="() => Grade.grade_2" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/grades">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    [SupplyParameterFromForm]
    private Grade? Grade { get; set; }

    [SupplyParameterFromForm]
    private string? studentSel { get; set; }

    [SupplyParameterFromForm]
    private string? lessonSel { get; set; }

    private List<KeyValuePair<int, string>> students = new();
    private List<KeyValuePair<long, string>> lessonNames = new();
    private string? SaveError;

    private int SelectedStudent
        => int.TryParse(studentSel, out var value) ? value : Grade?.student ?? 0;

    private long SelectedLesson
        => long.TryParse(lessonSel, out var value) ? value : Grade?.lesson ?? 0;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Grade ??= await context.Grades.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);
        students = (await context.Students.OrderBy(s => s.last_name).ToListAsync())
            .Select(s => new KeyValuePair<int, string>(s.stud_id,
                !string.IsNullOrWhiteSpace(s.middle_name)
                    ? $"{s.last_name} {s.first_name} {s.middle_name}"
                    : $"{s.last_name} {s.first_name}"))
            .ToList();
        var groupNames = (await context.Groups.ToListAsync())
            .ToDictionary(g => g.group_id, g => g.group_name ?? "");
        lessonNames = (await context.Schedule.OrderBy(s => s.lesson_id).ToListAsync())
            .Select(s =>
            {
                var groupName = groupNames.TryGetValue(s.group, out var name) ? name : $"№{s.group}";
                return new KeyValuePair<long, string>(s.lesson_id, s.date.HasValue
                    ? $"{s.lesson_id} · {groupName} · {s.date:d}"
                    : $"{s.lesson_id} · {groupName}");
            })
            .ToList();

        if (Grade is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGrade()
    {
        if (!int.TryParse(studentSel, out var studentId) || !long.TryParse(lessonSel, out var lessonId))
        {
            SaveError = "Выберите студента и занятие.";
            return;
        }

        var originalStudent = Grade!.student;
        var originalLesson = Grade.lesson;
        var keysChanged = originalStudent != studentId || originalLesson != lessonId;

        using var context = DbFactory.CreateDbContext();

        if (keysChanged)
        {
            var original = await context.Grades.FirstOrDefaultAsync(g => g.student == originalStudent && g.lesson == originalLesson);
            if (original is not null)
            {
                original.is_deleted = true;
                await context.SaveChangesAsync();
            }

            Grade.student = studentId;
            Grade.lesson = lessonId;
            context.Grades.Add(Grade);
            await context.SaveChangesAsync();
        }
        else
        {
            context.Attach(Grade).State = EntityState.Modified;
            try
            {
                await context.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!GradeExists(Grade.student, Grade.lesson))
                {
                    NavigationManager.NavigateTo("notfound");
                }
                else
                {
                    throw;
                }
            }
        }

        NavigationManager.NavigateTo("/grades");
    }

    private bool GradeExists(int student, long lesson)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Grades.Any(e => e.student == student && e.lesson == lesson);
    }
}