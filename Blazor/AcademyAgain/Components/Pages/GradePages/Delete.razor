@page "/grades/delete"
@attribute [Authorize(Policy = "Teaching")]
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление оценки</PageTitle>

<h1>Удаление оценки</h1>

<p class="text-danger">Вы уверены, что хотите удалить эту оценку?</p>
<div>
    <hr />
    @if (grade is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Студент</dt>
            <dd class="col-sm-10">@StudentName</dd>
            <dt class="col-sm-2">Занятие</dt>
            <dd class="col-sm-10">@LessonName</dd>
            <dt class="col-sm-2">Оценка 1</dt>
            <dd class="col-sm-10">@(grade.grade_1?.ToString() ?? "—")</dd>
            <dt class="col-sm-2">Оценка 2</dt>
            <dd class="col-sm-10">@(grade.grade_2?.ToString() ?? "—")</dd>
        </dl>
        <EditForm method="post" Model="grade" OnValidSubmit="DeleteGrade" FormName="delete" Enhance>
            <input type="hidden" name="Grade.student" value="@grade.student" />
            <input type="hidden" name="Grade.lesson" value="@grade.lesson" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/grades">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Grade? grade;
    private string? StudentName = "—";
    private string? LessonName = "—";

    [SupplyParameterFromQuery]
    private int student { get; set; }

    [SupplyParameterFromQuery]
    private long lesson { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        grade = await context.Grades.FirstOrDefaultAsync(m => m.student == student && m.lesson == lesson);

        if (grade is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        else
        {
            var stud = await context.Students.FirstOrDefaultAsync(s => s.stud_id == grade.student);
            if (stud is not null)
            {
                StudentName = !string.IsNullOrWhiteSpace(stud.middle_name)
                    ? $"{stud.last_name} {stud.first_name} {stud.middle_name}"
                    : $"{stud.last_name} {stud.first_name}";
            }

            var sched = await context.Schedule.FirstOrDefaultAsync(s => s.lesson_id == grade.lesson);
            if (sched is not null)
            {
                var groupName = await context.Groups
                    .Where(g => g.group_id == sched.group)
                    .Select(g => g.group_name)
                    .FirstOrDefaultAsync() ?? $"№{sched.group}";
                LessonName = sched.date.HasValue
                    ? $"{sched.lesson_id} · {groupName} · {sched.date:d}"
                    : $"{sched.lesson_id} · {groupName}";
            }
            else
            {
                LessonName = $"№{grade.lesson}";
            }
        }
    }

    private async Task DeleteGrade()
    {
        using var context = DbFactory.CreateDbContext();
        grade!.is_deleted = true;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/grades");
    }
}