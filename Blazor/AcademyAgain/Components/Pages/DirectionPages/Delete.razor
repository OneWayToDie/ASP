@page "/directions/delete"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление направления</PageTitle>

<h1>Удаление направления</h1>

<p class="text-danger">Вы уверены, что хотите удалить это направление?</p>
<div>
    <hr />
    @if (direction is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@direction.direction_name</dd>
        </dl>
        <EditForm method="post" Model="direction" OnValidSubmit="DeleteDirection" FormName="delete" Enhance>
            <input type="hidden" name="Direction.direction_id" value="@direction.direction_id" />
            <button type="submit" class="btn btn-danger">Удалить</button> |
            <a href="/directions">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDirection()
    {
        using var context = DbFactory.CreateDbContext();
        context.Directions.Remove(direction!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/directions");
    }
}