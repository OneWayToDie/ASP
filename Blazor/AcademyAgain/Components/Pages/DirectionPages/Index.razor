@page "/directions"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Направления</PageTitle>

<div class="list-header">
    <h1>Направления</h1>
    <a class="btn btn-primary" href="directions/create">Создать</a>
</div>

<QuickGrid Class="table" Items="context.Directions">
    <PropertyColumn Property="direction => direction.direction_name" Title="Название" />

    <TemplateColumn Context="direction">
        <a href="@($"directions/edit?direction_id={direction.direction_id}")">Изменить</a> |
        <a href="@($"directions/details?direction_id={direction.direction_id}")">Подробно</a> |
        <a href="@($"directions/delete?direction_id={direction.direction_id}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyAgainContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
