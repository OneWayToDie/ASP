@page "/directions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Direction>

<PageTitle>Направления</PageTitle>

<div class="list-header">
    <h1>Направления</h1>
    <a class="btn btn-primary" href="directions/create">Создать</a>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="direction => direction.direction_id">
    <TemplateColumn Title="Название" Sortable="true" SortBy="GridSort<Direction>.ByAscending(d => d.direction_name)" Context="direction">
        <div class="row-key @RowClass(direction)" data-item-key="@GetKey(direction)">
            @DirectionName(direction)
        </div>
    </TemplateColumn>
</QuickGrid>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private IQueryable<Direction> query = new List<Direction>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        query = (await context.Directions.ToListAsync()).AsQueryable();
    }

    private string DirectionName(Direction d) => d.direction_name ?? $"№{d.direction_id}";

    protected override string GetKey(Direction d) => d.direction_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"directions/details?direction_id={id}"),
            new("Изменить", $"directions/edit?direction_id={id}"),
            new("Удалить", $"directions/delete?direction_id={id}", Danger: true),
        };
    }
}