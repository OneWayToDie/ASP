@page "/directions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@using AcademyAgain.Helpers
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager
@inherits RowMenuPage<Direction>

<PageTitle>Направления</PageTitle>

<div class="list-header">
    <h1>Направления</h1>
    <div class="list-actions">
        <input class="form-control search-input" type="search" placeholder="Поиск…" value="@SearchText" @oninput="OnSearchInput" />
        <ExportMenu RowBuilder="BuildRows" FileName="directions" />
        <a class="btn btn-primary" href="directions/create">Создать</a>
    </div>
</div>

<QuickGrid Class="table context-table" Items="query" ItemKey="direction => direction.direction_id" Pagination="Pagination">
    <TemplateColumn Title="Название" Sortable="true" SortBy="GridSort<Direction>.ByAscending(d => d.direction_name)" Context="direction">
        <div class="row-key @RowClass(direction)" data-item-key="@GetKey(direction)">
            @DirectionName(direction)
        </div>
    </TemplateColumn>
</QuickGrid>

<div class="paginator">
    <span class="badge bg-secondary total-badge">Всего: @TotalCount</span>
    <AppPaginator State="Pagination" OnPageSizeChanged="HandlePageSizeChanged" />
</div>

<RowContextMenu MenuItems="@MenuItems" X="@MenuX" Y="@MenuY" OnClose="CloseMenu" />

@code {
    private List<Direction> allItems = new();
    private IQueryable<Direction> query = new List<Direction>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        allItems = await context.Directions.ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        query = ApplySearch(allItems).AsQueryable();
        TotalCount = ApplySearch(allItems).Count();
    }

    private List<string[]> BuildRows()
    {
        var rows = new List<string[]> { new[] { "Название" } };
        rows.AddRange(ApplySearch(allItems).Select(d => new[] { DirectionName(d) }));
        return rows;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();
        ApplyFilter();
        await ResetPaginationAsync();
    }

    protected override bool MatchesSearch(Direction direction)
        => TextContains(direction.direction_name);

    private string DirectionName(Direction d) => d.direction_name ?? $"№{d.direction_id}";

    protected override string GetKey(Direction d) => d.direction_id.ToString();

    protected override List<RowMenuItem> BuildMenu(string key)
    {
        if (!int.TryParse(key, out var id)) return new List<RowMenuItem>();
        return new List<RowMenuItem>
        {
            new("Профиль", $"directions/details?direction_id={id}"),
            new("Изменить", $"directions/edit?direction_id={id}"),
            new("Удалить", $"directions/delete?direction_id={id}", Danger: true),
        };
    }
}