@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Направление: @direction?.direction_name</PageTitle>

<Breadcrumbs Items="Crumbs" />

<h1>Направление: @direction?.direction_name</h1>

<hr />
@if (direction is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@direction.direction_name</dd>
    </dl>
    <div>
        <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Изменить</a> |
        <a href="@($"/directions")">Назад к списку</a>
    </div>
}

@code {
    private static readonly Breadcrumbs.Crumb[] Crumbs = new[]
    {
        new Breadcrumbs.Crumb("Направления", "/directions"),
        new Breadcrumbs.Crumb("Профиль")
    };
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}