@page "/directions/create"
@using Microsoft.EntityFrameworkCore
@using AcademyAgain.Models
@inject IDbContextFactory<AcademyAgainContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Добавление направления</PageTitle>

<h1>Добавление направления</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Direction" OnValidSubmit="AddDirection" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="direction_name" class="form-label">Название:</label>
                <InputText id="direction_name" @bind-Value="Direction.direction_name" class="form-control" />
                <ValidationMessage For="() => Direction.direction_name" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Создать</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/directions">Назад к списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Direction Direction { get; set; } = default!;

    protected override void OnInitialized() => Direction ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDirection()
    {
        using var context = DbFactory.CreateDbContext();
        context.Directions.Add(Direction);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/directions");
    }
}